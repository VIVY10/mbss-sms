<%- include("../partials/sidebar.ejs") %>
<div class="table-responsive">
    <table class="table">
      <div style="float: right; margin: 10px;">
        <a href="/unallocatedSubjects">
            <button type="submit" class="btn btn-success">Unallocated Subjects</button>
        </a>
    </div>
      <div style="float: right; margin: 10px;">
        <a href="/classAllocation">
            <button type="submit" class="btn btn-success">Class Allocation</button>
        </a>
    </div>
      <div style="float: right; margin: 10px;">
        <a href="/AddClassSubjects">
            <button type="submit" class="btn btn-success">Add Class Subject</button>
        </a>
    </div>
      <thead class="table-light">
        <tr>
          <th>SubjectCode</th>
          <th>SubjectName</th>
          <th>Grade</th>
          <th>Class</th>
          <th>Action</th>
        </tr>
      </thead>
    <% if(locals.results){ %>
      <% results.forEach(element => { %>
          <tbody>
            <tr>
              <td><%= element.subjectcode %></th>
              <td><%= element.subjectname %></td>
              <td><%= element.grade %></th>
                <td><%= element.section %></th>
              <td>
                <form action="/deleteClassSubject" method="POST" onsubmit="return confirm('Are you sure you want to delete this record?');">
                  <input type="hidden" name="class_subjectsid" value="<%= element.class_subjectsid %>">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>  
              </td>               
              </th>                  
            </tr>
          </tbody>        
        <% }); %>        
      <% } %>
    </table>      
    </div>
  </main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>