<%- include("../partials/sidebar.ejs") %>
<div class="table-responsive">
  <div style="float: left; margin: 10px;">
        <button type="submit" class="btn btn-success" id="unallocatedSubjects">Unallocated Subjects</button>
    </div>
    <div style="float: left; margin: 10px;">
        <button type="submit" class="btn btn-success" id="classAllocation">Class Allocation</button>
    </div>
      <div style="float: left; margin: 10px;">
        <a href="/AddClassSubjects">
            <button type="submit" class="btn btn-success">Add Class Subject</button>
        </a>
    </div>
    <table class="table">
      <thead class="table-light">
        <tr>
          <th>SubjectCode</th>
          <th>SubjectName</th>
          <th>Class</th>
          <th>Action</th>
        </tr>
      </thead>
    <% if(locals.results){ %>
      <% results.forEach(element => { %>
          <tbody>
            <tr>
              <td><%= element.subjectcode %></th>
              <td><%= element.subjectname %></td>
                <td><%= element.levelname%><%= element.class%></th>
              <td>
                <form action="/deleteClassSubject" method="POST" onsubmit="return confirm('Are you sure you want to delete this record?');">
                  <input type="hidden" name="class_subject_id" value="<%= element.class_subject_id %>">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>  
              </td>               
              </th>                  
            </tr>
          </tbody>        
        <% }); %>        
      <% } %>
    </table>      
    </div>
  </main>

              <!-- allocation Modal -->
            <div class="modal fade" id="allocationModal" tabindex="-1" aria-labelledby="allocationModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg"> <!-- modal-lg makes it wider -->
                    <div class="modal-content shadow-lg rounded-3 border-0">
                        <form id="allocationModalForm" class="needs-validation">
                            <!-- Header -->
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title fw-bold" id="allocationModalLabel">
                                    <i class="bi bi-journal-check me-2"></i> Select Term
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <!-- Body -->
                            <div class="modal-body">
                                <div class="row g-3"><!-- g-3 adds spacing between fields -->                                    
                                    <div class="col-md-6">
                                        <label for="modalTerm" class="form-label">Term</label>
                                        <select id="termid" name="termid" class="form-select"
                                            required>
                                            <!-- dynamica content here -->
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save me-1"></i> Save
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i> Close
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

                          <!-- allocation Modal -->
            <div class="modal fade" id="allocationModal2" tabindex="-1" aria-labelledby="allocationModal2Label"
                aria-hidden="true">
                <div class="modal-dialog modal-lg"> <!-- modal-lg makes it wider -->
                    <div class="modal-content shadow-lg rounded-3 border-0">
                        <form id="unallocatedClassSubjects" class="needs-validation">
                            <!-- Header -->
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title fw-bold" id="allocation2Modal2Label">
                                    <i class="bi bi-journal-check me-2"></i> Select Term 2
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <!-- Body -->
                            <div class="modal-body">
                                <div class="row g-3"><!-- g-3 adds spacing between fields -->                                    
                                    <div class="col-md-6">
                                        <label for="modalTerm" class="form-label">Term</label>
                                        <select id="termid2" name="termid" class="form-select"
                                            required>
                                            <!-- dynamica content here -->
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save me-1"></i> Save
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i> Close
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            


  </main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
<script src="/scripts/classAllocation.js"></script>
</body>

</html>