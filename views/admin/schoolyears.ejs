<%- include("../partials/sidebar.ejs") %>

<title>Student Subjects</title>

<!-- Content -->
<div class="container">

    <div class="card mt-3">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Registered Year</h4>

                <a href="/schoolYear" class="btn btn-success">
                    Create Year
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="table">

                    <thead class="thead-light">
                        <tr>
                            <th>School Year ID</th>
                            <th>Year Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th colspan="2">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (locals.results && results.length > 0) { %>

                            <% results.forEach(element => { %>

                                <tr>

                                    <td>
                                        <%= element.schoolyearid %>
                                    </td>

                                    <td>
                                        <%= element.yearname %>
                                    </td>

                                    <td>
                                        <%= element.startdate.toISOString().split('T')[0] %>
                                    </td>

                                    <td>
                                        <%= element.enddate.toISOString().split('T')[0] %>
                                    </td>

                                    <td>
                                        <%= element.status %>
                                    </td>

                                    <td>
                                        <form action="/deleteYear" method="POST">
                                            <input
                                                type="hidden"
                                                name="schoolyearid"
                                                value="<%= element.schoolyearid %>"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                            >
                                                Delete
                                            </button>
                                        </form>
                                    </td>

                                    <td>
                                        <button
                                            type="button"
                                            class="btn btn-danger"
                                        >
                                            Test
                                        </button>
                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="7" class="text-center">
                                    <h5 class="mb-0">No Year Registered</h5>
                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous">
</script>

<script src="/scripts/adminScripts.js"></script>

</body>
</html>