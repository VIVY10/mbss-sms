<%- include("../partials/sidebar.ejs") %>
<title>subjects</title>
  <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
  <div class="container">
    <div class="card mt-3">
      <div class="card-body table-responsive">
        <h4>Registered subjects</h4>
        <table class="table table-bordered table-hover" id="table">
            <div style="float: right;">
                <a href="/createSubject">
                    <button type="submit" class="btn btn-success">create Subject</button>
                </a>
            </div>
          <thead class="thead-light">
              <tr>
                <th>SubjectCode</th>
                <th>SubjectName</th>
                <th colspan="2" style="text-align: center;">Action</th>
              </tr>
          </thead>
          <tbody>
            <% if (locals.results && results.length > 0) { %>
              <% results.forEach(element => { %>
                <tr>
                    <td><%= element.subjectcode %></th>
                    <td><%= element.subjectname %></td>
                  <td>
                    <form action="/deleteSubject" method="POST" onsubmit="return confirm('Are you sure you want to delete this record?');">
                      <input type="hidden" name="subjectcode" value="<%= element.subjectcode %>">
                      <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center"><h5>No subjects Registered</h5></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>         
  </div>
  <!-- Include Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
  integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
  <script src="/scripts/adminScripts.js"></script>
</body>
</html>
