<%- include("../partials/sidebar") %>

<div class="form-container">
  <form action="schoolYear" method="post" id="form1">
      <h3>CREATE SCHOOL YEAR</h3>
      <label for="yearname">Academic Year</label>
      <input type="number" name="yearname" class="form-control" pattern="[0-9]{4}" inputmode="numeric" maxlength="4" placeholder="YYYY" required/>

      <label for="startdate">Start Date</label>
      <input type="date" name="startdate" class="form-control" required/>
      <label for="enddate">End Date</label>
      <input type="date" name="enddate" class="form-control"  required/>

      <div class="btn-box">
          <button type="submit" id="submit">Submit</button>
      </div>
  </form>
</div>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
	<script src="/scripts/adminScripts.js"></script>
</body>
</html>