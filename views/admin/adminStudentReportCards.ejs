<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bulk Report Cards</title>
    <link rel="stylesheet" href="/styles/reportCard.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
</head>
<body>
    <div id="report-cards-container"></div>
    <% for (const examno in reportCards) { %>
    <div class="container report-card" id="report-card-<%= examno %>">
        <!-- Report card content for each student -->
        <header>
            <div class="logo">
                <img src="/images/logo.png" alt="school Logo">
            </div>
            <div class="header-text">
                <h1>MINISTRY OF EDUCATION</h1>
                <h2>MILENGE SECONDARY SCHOOL</h2>
                <p>(School Code: MBSS01)</p>
                <p>P.O BOX, 710104, Milenge, Luapula Province, Milenge</p>
            </div>
            <div class="govt-logo">
                <img src="/images/ministryLogo.png" alt="Government Logo">
            </div>
        </header>

        <!-- Student Information -->
        <section class="student-info">
            <table>
                <tr>
                    <td>STUDENT'S NAME : <strong><%= reportCards[examno].student.fname %> <%= reportCards[examno].student.lname %></strong></td>
                    <td>CLASS : <strong><%= reportCards[examno].student.grade %> <%= reportCards[examno].student.section %></strong></td>
                </tr>
                <tr>
                    <td>RESULTS OF : <strong><%= reportCards[examno].student.exam_title %> EXAM</strong></td>
                    <td>EXAM No : <strong><%= reportCards[examno].student.examno %></strong></td>
                </tr>
            </table>
        </section>

        <table id="marksheet">
            <thead>
                <tr>
                    <th>S/N</th>
                    <th>Subject Code</th>
                    <th>Subject Name</th>
                    <th>Marks</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                <% reportCards[examno].subjects.forEach(function(subject, i) { %>
                    <tr>
                        <td>000<%= i + 1 %></td>
                        <td><%= subject.subjectcode %></td>
                        <td><%= subject.subjectname %></td>
                        <td class="marks"><%= subject.score %></td>
                        <td class="comment"></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <table class="summary-table">
            <tr class="grandtot">
                <td colspan="5">
                    <span>Grand Total</span>
                    <span class="alltot black">000</span>
                </td>
            </tr>
            <tr class="inwords">
                <td colspan="5">
                    <span>Max. Marks</span>
                    <span class="numinwords black">000</span>
                </td>
            </tr>
            <tr>
                <td colspan="5">
                    <span class="subjects">No. of Subjects</span>
                    <span class="num-subjects black">0</span>
                </td>
            </tr>
        </table>

        <div class="table2">
            <table>
                <tr>
                    <th colspan="5" class="month-year">Year of Examinations</th>
                    <th>Result</th>
                    <th>Percentage</th>
                    <th>Grade</th>
                </tr>
                <tr>
                    <td colspan="5" class="month-year"><%= reportCards[examno].student.yearname %></td>
                    <td>PASS</td>
                    <td class="percentage-tot">000</td>
                    <td id="grade">000</td>
                </tr>
            </table>
        </div>

        <footer>
            <div>
                <p>Class Teacher's Sign: _______________ &nbsp; &nbsp; HeadTeacher's Sign: _______________</p>
            </div>
            <div>
                <p class="disclaimer">
                    Disclaimer: The results published on mbss website are immediate information for Students. This cannot be treated as original mark sheet Until Signed and Stamped By School HeadTeacher.
                </p>
            </div>
            <div class="date">
                <p><span>Date Generated:</span> <span id="current-date"></span></p>
            </div>
            <br>
            <p>Visit: <a href="https://www.milengesecondary.com" target="_blank" class="visit">www.milengesecondary.com</a></p>
        </footer>
    </div>
    <% } %>
</div>
<div class="download-btn">
    <button onclick="downloadAllReportCards()">Download All Report Cards as PDFs</button>
    <!-- <button onclick="downloadAllReportCardsAsSinglePDF()">Download as Single PDF</button> -->
</div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    <script src="/scripts/adminReportCard.js"></script>
</body>
</html>
