<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Report Cards · Admin</title>

    <link rel="stylesheet" href="/styles/admin.css">
    <link rel="stylesheet" href="/styles/reportCard.css">
    
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
</head>


<body class="rc-admin">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="rc-header">

        <div class="rc-header-inner">

            <p class="rc-eyebrow">
                Academic Management
            </p>

            <h1>
                Report Cards
            </h1>

            <p class="rc-sub">
                Generate a single or bulk report card for a year
                level, term and examination.
            </p>

        </div>

    </header>


    <!-- =====================================================
         MAIN
         ===================================================== -->

    <main class="rc-panel">

        <!-- =================================================
             REPORT CARD FORM
             ================================================= -->

        <form
            id="rcForm"
            class="rc-form"
            novalidate
        >

            <div class="rc-grid">


                <!-- SCHOOL YEAR -->
                <label class="rc-field">

                    <span>
                        School Year
                    </span>

                    <select
                        name="schoolyearid"
                        id="schoolyearid"
                        required
                    >

                        <option
                            value=""
                            disabled
                            selected
                        >
                            Select year
                        </option>

                        <% schoolyears.forEach(y => { %>

                            <option
                                value="<%= y.schoolyearid %>"
                            >
                                <%= y.yearname %>
                            </option>

                        <% }) %>

                    </select>

                </label>


                <!-- TERM -->
                <label class="rc-field">

                    <span>
                        Term
                    </span>

                    <select
                        name="termid"
                        id="termid"
                        required
                    >

                        <option
                            value=""
                            disabled
                            selected
                        >
                            Select term
                        </option>

                        <% terms.forEach(t => { %>

                            <option
                                value="<%= t.termid %>"
                            >
                                Term <%= t.termnumber %>
                            </option>

                        <% }) %>

                    </select>

                </label>


                <!-- YEAR LEVEL -->
                <label class="rc-field">

                    <span>
                        Year Level
                    </span>

                    <select
                        name="levelorder"
                        id="levelorder"
                        required
                    >

                        <option
                            value=""
                            disabled
                            selected
                        >
                            Select year level
                        </option>

                        <% yearlevels.forEach(l => { %>

                            <option
                                value="<%= l.levelorder %>"
                            >
                                <%= l.levelname %>
                            </option>

                        <% }) %>

                    </select>

                </label>


                <!-- EXAMINATION -->
                <label class="rc-field">

                    <span>
                        Examination
                    </span>

                    <select
                        name="examid"
                        id="examid"
                        required
                    >

                        <option
                            value=""
                            disabled
                            selected
                        >
                            Select examination
                        </option>

                        <% exams.forEach(e => { %>

                            <option
                                value="<%= e.examid %>"
                            >
                                <%= e.exam_title %>
                            </option>

                        <% }) %>

                    </select>

                </label>


                <!-- EXAM NUMBER -->
                <label class="rc-field rc-field--wide">

                    <span>
                        Exam Number

                        <em>
                            (optional — leave blank for the whole year level)
                        </em>
                    </span>

                    <input
                        type="text"
                        name="examno"
                        id="examno"
                        placeholder="e.g. 2024001"
                        autocomplete="off"
                        inputmode="numeric"
                    >

                </label>

            </div>


            <!-- =================================================
                 ACTION BUTTONS
                 ================================================= -->

            <div class="rc-actions">

                <button
                    type="button"
                    id="rcPreview"
                    class="rc-btn rc-btn--ghost"
                >
                    <span aria-hidden="true">⌕</span>
                    <span>Preview</span>
                </button>


                <button
                    type="submit"
                    id="rcDownload"
                    class="rc-btn rc-btn--primary"
                >
                    <span aria-hidden="true">↓</span>
                    <span>Download PDF</span>
                </button>

            </div>

        </form>


        <!-- =================================================
             PREVIEW
             ================================================= -->

        <section
            id="rcPreviewArea"
            class="rc-preview"
            hidden
        >

            <h2 class="rc-preview-title">
                Preview
            </h2>

            <div
                id="rcPreviewContent"
                class="rc-preview-content"
            ></div>

        </section>


        <!-- =================================================
             STATUS
             ================================================= -->

        <div
            id="rcStatus"
            class="rc-status"
            role="status"
            aria-live="polite"
            hidden
        ></div>

    </main>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script
        src="/scripts/reportCards.js"
        defer
    ></script>

</body>

</html>