<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Report Cards · Parent</title>

    <link rel="stylesheet" href="/styles/admin.css">
    <link rel="stylesheet" href="/styles/reportCard.css">
    
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
</head>

<body class="rc-admin">

    <header class="rc-header">
        <div class="rc-header-inner">
            <p class="rc-eyebrow">Academic Management</p>

            <h1>Report Cards</h1>

            <p class="rc-sub">
                Generate your child's report card for a term and examination.
            </p>
        </div>
    </header>


    <main class="rc-panel">

        <form
            id="rcForm"
            class="rc-form"
            novalidate
        >

            <div class="rc-grid">

                <!-- SCHOOL YEAR -->
                <label class="rc-field">
                    <span>School Year</span>

                    <select
                        name="schoolyearid"
                        id="schoolyearid"
                        required
                    >
                        <option value="" disabled selected>
                            Select year
                        </option>

                        <% schoolyears.forEach(y => { %>
                            <option value="<%= y.schoolyearid %>">
                                <%= y.yearname %>
                            </option>
                        <% }) %>
                    </select>
                </label>


                <!-- TERM -->
                <label class="rc-field">
                    <span>Term</span>

                    <select
                        name="termid"
                        id="termid"
                        required
                    >
                        <option value="" disabled selected>
                            Select term
                        </option>

                        <% terms.forEach(t => { %>
                            <option value="<%= t.termid %>">
                                Term <%= t.termnumber %>
                            </option>
                        <% }) %>
                    </select>
                </label>


                <!-- EXAMINATION -->
                <label class="rc-field">
                    <span>Examination</span>

                    <select
                        name="examid"
                        id="examid"
                        required
                    >
                        <option value="" disabled selected>
                            Select examination
                        </option>

                        <% exams.forEach(e => { %>
                            <option value="<%= e.examid %>">
                                <%= e.exam_title %>
                            </option>
                        <% }) %>
                    </select>
                </label>


                <!-- EXAM NUMBER -->
                <label class="rc-field">
                    <span>Exam Number</span>

                    <input
                        type="text"
                        name="examno"
                        id="examno"
                        placeholder="e.g. 2024001"
                        autocomplete="off"
                        inputmode="numeric"
                        required
                    >
                </label>

            </div>


            <!-- ACTIONS -->
            <div class="rc-actions">

                <button
                    type="button"
                    id="rcPreview"
                    class="rc-btn rc-btn--ghost"
                >
                    <i class="i-search" aria-hidden="true"></i>
                    <span>Preview</span>
                </button>

                <button
                    type="submit"
                    id="rcDownload"
                    class="rc-btn rc-btn--primary"
                >
                    <i class="i-download" aria-hidden="true"></i>
                    <span>Download PDF</span>
                </button>

            </div>

        </form>


        <!-- PREVIEW -->
        <section
            id="rcPreviewArea"
            class="rc-preview"
            hidden
        >

            <h2 class="rc-preview-title">
                Preview
            </h2>

            <div
                id="rcPreviewContent"
                class="rc-preview-content"
            ></div>

        </section>


        <!-- STATUS -->
        <div
            id="rcStatus"
            class="rc-status"
            role="status"
            aria-live="polite"
            hidden
        ></div>

    </main>


    <script
        src="/scripts/parent-report-card.js"
        defer
    ></script>

</body>
</html>