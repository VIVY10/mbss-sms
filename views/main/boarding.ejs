<%- include("../partials/header.ejs") %>
<!-- =========================================================
     BOARDING
========================================================= -->
<section
    class="section boarding-section"
    id="boarding"
>

    <div class="container boarding-grid">

        <div class="boarding-content">

            <span class="eyebrow">
                Boarding Life
            </span>

            <h2>
                More than a school.
                <span>A community.</span>
            </h2>

            <p>
                Boarding life gives learners the opportunity
                to develop independence, responsibility,
                friendship and strong routines within a
                supportive school community.
            </p>


            <div class="boarding-list">

                <div class="boarding-item">

                    <span class="boarding-check">
                        ✓
                    </span>

                    <div>
                        <strong>
                            Safe & Structured Environment
                        </strong>

                        <p>
                            Clear routines and responsible
                            supervision throughout boarding life.
                        </p>
                    </div>

                </div>


                <div class="boarding-item">

                    <span class="boarding-check">
                        ✓
                    </span>

                    <div>
                        <strong>
                            Personal Development
                        </strong>

                        <p>
                            Learners develop independence,
                            responsibility and teamwork.
                        </p>
                    </div>

                </div>


                <div class="boarding-item">

                    <span class="boarding-check">
                        ✓
                    </span>

                    <div>
                        <strong>
                            Community & Belonging
                        </strong>

                        <p>
                            A school community where learners
                            are encouraged to support one another.
                        </p>
                    </div>

                </div>

            </div>

        </div>


        <div class="boarding-image">

            <img
                src="/images/school-campus.jpg"
                alt="Boarding students at school"
                loading="lazy"
            >

            <div class="boarding-caption">

                <span>
                    Boarding Life
                </span>

                <strong>
                    Growing together.
                </strong>

            </div>

        </div>

    </div>

</section>
</main>


