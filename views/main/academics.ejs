<%- include("../partials/header.ejs") %>
<!-- =========================================================
     ACADEMICS
========================================================= -->
<section
    class="section academics-section"
    id="academics"
>

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="eyebrow">
                    Academic Life
                </span>

                <h2>
                    Learning designed
                    <span>for the future.</span>
                </h2>
            </div>

            <p>
                Our academic programme combines classroom
                learning with practical skills, critical
                thinking and personal development.
            </p>

        </div>


        <div class="academic-grid">

            <article class="academic-card large">

                <div class="academic-image">

                    <img
                        src="/images/bg3.jpg"
                        alt="Students learning in a classroom"
                        loading="lazy"
                    >

                </div>

                <div class="academic-content">

                    <span class="academic-number">
                        01
                    </span>

                    <h3>
                        Strong Academic Foundation
                    </h3>

                    <p>
                        A structured learning environment designed
                        to help learners understand concepts,
                        develop analytical skills and achieve
                        strong academic outcomes.
                    </p>

                    <a href="#contact">
                        Academic enquiries →
                    </a>

                </div>

            </article>


            <article class="academic-card">

                <div class="academic-icon">
                    ◇
                </div>

                <span class="academic-number">
                    02
                </span>

                <h3>
                    Science & Technology
                </h3>

                <p>
                    Encouraging curiosity, innovation,
                    experimentation and digital literacy.
                </p>

            </article>


            <article class="academic-card">

                <div class="academic-icon">
                    ◇
                </div>

                <span class="academic-number">
                    03
                </span>

                <h3>
                    Languages & Humanities
                </h3>

                <p>
                    Developing communication, cultural awareness,
                    reasoning and an understanding of society.
                </p>

            </article>


            <article class="academic-card">

                <div class="academic-icon">
                    ◇
                </div>

                <span class="academic-number">
                    04
                </span>

                <h3>
                    Co-Curricular Activities
                </h3>

                <p>
                    Sports, clubs, leadership and other activities
                    that support holistic learner development.
                </p>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     STATISTICS
========================================================= -->
<section class="statistics-section">

    <div class="container statistics-grid">

        <div class="stat-item">

            <strong
                class="counter"
                data-target="100"
            >
                0
            </strong>

            <span>%</span>

            <p>
                Commitment to learner development
            </p>

        </div>


        <div class="stat-item">

            <strong
                class="counter"
                data-target="24"
            >
                0
            </strong>

            <span>/7</span>

            <p>
                A structured boarding environment
            </p>

        </div>


        <div class="stat-item">

            <strong
                class="counter"
                data-target="4"
            >
                0
            </strong>

            <p>
                Core values
            </p>

        </div>


        <div class="stat-item">

            <strong
                class="counter"
                data-target="1"
            >
                0
            </strong>

            <span> Community</span>

            <p>
                Working together for success
            </p>

        </div>

    </div>

</section>
</main>

