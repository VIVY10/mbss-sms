<!-- =========================================================
     NEWS / ANNOUNCEMENTS
========================================================= -->
<section
    class="section news-section"
    id="news"
>

    <div class="container">

        <div class="section-heading">

            <div>

                <span class="eyebrow">
                    Latest Updates
                </span>

                <h2>
                    School news &
                    <span>announcements.</span>
                </h2>

            </div>

            <a
                href="#contact"
                class="text-link"
            >
                View school updates →
            </a>

        </div>


        <div class="news-grid">

            <article class="news-card">

                <div class="news-date">

                    <strong>
                        01
                    </strong>

                    <span>
                        OCT
                    </span>

                </div>

                <div class="news-body">

                    <span class="news-category">
                        Announcement
                    </span>

                    <h3>
                        Welcome to Milenge Boarding Secondary School
                    </h3>

                    <p>
                        Important school announcements and
                        information for parents, guardians
                        and learners will appear here.
                    </p>

                    <a href="#contact">
                        Read more →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <div class="news-date">

                    <strong>
                        02
                    </strong>

                    <span>
                        OCT
                    </span>

                </div>

                <div class="news-body">

                    <span class="news-category">
                        Academic
                    </span>

                    <h3>
                        Supporting academic excellence
                    </h3>

                    <p>
                        Follow this section for academic
                        programmes, examinations and
                        learner development updates.
                    </p>

                    <a href="#contact">
                        Read more →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <div class="news-date">

                    <strong>
                        03
                    </strong>

                    <span>
                        OCT
                    </span>

                </div>

                <div class="news-body">

                    <span class="news-category">
                        Community
                    </span>

                    <h3>
                        Building a stronger school community
                    </h3>

                    <p>
                        School activities, events and
                        community initiatives will be
                        shared with our school community.
                    </p>

                    <a href="#contact">
                        Read more →
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>
