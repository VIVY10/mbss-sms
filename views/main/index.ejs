<!-- =========================================================
     HERO
========================================================= -->
<section
    class="hero"
    id="home"
>

    <div class="hero-overlay"></div>

    <div class="container hero-container">

        <div class="hero-content">

            <div class="hero-badge">
                <span class="badge-dot"></span>
                Welcome to Milenge Boarding Secondary School
            </div>

            <h1>
                Inspiring
                <span>Excellence.</span>
                Building
                <strong>Leaders.</strong>
            </h1>

            <p class="hero-description">
                We provide a supportive and disciplined learning
                environment where learners develop academically,
                socially and morally, preparing them for responsible
                leadership and meaningful contribution to society.
            </p>

            <div class="hero-actions">

                <a
                    href="#admissions"
                    class="button button-primary"
                >
                    Explore Admissions
                    
                </a>

                <a
                    href="/about"
                    class="button button-outline"
                >
                    Discover Our School
                </a>

            </div>

            <div class="hero-highlights">

                <div class="hero-highlight">
                    <strong>Quality</strong>
                    <span>Education</span>
                </div>

                <div class="hero-highlight">
                    <strong>Strong</strong>
                    <span>Discipline</span>
                </div>

                <div class="hero-highlight">
                    <strong>Holistic</strong>
                    <span>Development</span>
                </div>

            </div>

        </div>

    </div>


    <a
        href="#about"
        class="hero-scroll"
        aria-label="Scroll to about section"
    >
        <span>Scroll to explore</span>
        <span class="scroll-arrow">↓</span>
    </a>

</section>


