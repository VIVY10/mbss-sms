<!-- =========================================================
     FAQ
========================================================= -->
<section class="faq-section">

    <div class="container faq-container">

        <div class="section-heading centered">

            <span class="eyebrow">
                Frequently Asked Questions
            </span>

            <h2>
                Questions parents
                <span>often ask.</span>
            </h2>

        </div>


        <div class="faq-list">

            <div class="faq-item">

                <button
                    type="button"
                    class="faq-question"
                    aria-expanded="false"
                >
                    <span>
                        How can I enquire about admission?
                    </span>

                    <span class="faq-plus">
                        +
                    </span>
                </button>

                <div class="faq-answer">

                    <p>
                        Parents and guardians can contact the
                        school administration using the contact
                        information provided below for current
                        admission requirements and guidance.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button
                    type="button"
                    class="faq-question"
                    aria-expanded="false"
                >
                    <span>
                        Is the school a boarding school?
                    </span>

                    <span class="faq-plus">
                        +
                    </span>
                </button>

                <div class="faq-answer">

                    <p>
                        Yes. Milenge Boarding Secondary School
                        provides a structured boarding environment
                        designed to support learners' academic and
                        personal development.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button
                    type="button"
                    class="faq-question"
                    aria-expanded="false"
                >
                    <span>
                        How can parents receive school updates?
                    </span>

                    <span class="faq-plus">
                        +
                    </span>
                </button>

                <div class="faq-answer">

                    <p>
                        School announcements and important
                        information can be published through
                        the school's official communication
                        channels and this website.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button
                    type="button"
                    class="faq-question"
                    aria-expanded="false"
                >
                    <span>
                        How can I contact the school?
                    </span>

                    <span class="faq-plus">
                        +
                    </span>
                </button>

                <div class="faq-answer">

                    <p>
                        You can use the contact information
                        provided in the Contact section to
                        communicate with the school administration.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

 
