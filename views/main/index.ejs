<!-- =========================================================
     ADMISSIONS
========================================================= -->
<section
    class="admissions-section"
    id="admissions"
>

    <div class="container admissions-container">

        <div class="admissions-content">

            <span class="eyebrow light">
                Admissions
            </span>

            <h2>
                Begin your child's
                <span>journey with us.</span>
            </h2>

            <p>
                Interested in joining Milenge Boarding Secondary
                School? Our school administration is available to guide
                parents and guardians through the admission process.
            </p>


            <div class="admission-steps">

                <div class="admission-step">

                    <span>01</span>

                    <div>
                        <strong>
                            Make an enquiry
                        </strong>

                        <p>
                            Contact the school for current
                            admission information.
                        </p>
                    </div>

                </div>


                <div class="admission-step">

                    <span>02</span>

                    <div>
                        <strong>
                            Submit required documents
                        </strong>

                        <p>
                            Provide the documentation required
                            by the school.
                        </p>
                    </div>

                </div>


                <div class="admission-step">

                    <span>03</span>

                    <div>
                        <strong>
                            Complete admission
                        </strong>

                        <p>
                            Follow the school's admission
                            guidance and reporting process.
                        </p>
                    </div>

                </div>

            </div>

        </div>


        <div class="admission-panel">

            <div class="admission-panel-header">

                <span>
                    Admissions
                </span>

                <div class="status-indicator">
                    <span></span>
                    Enquiries Open
                </div>

            </div>

            <h3>
                Ready to get started?
            </h3>

            <p>
                Speak to the school administration about
                admission requirements and availability.
            </p>

            <a
                href="/contact"
                class="button button-light"
            >
                Contact Admissions
                <span>→</span>
            </a>

            <a
                href="tel:+260977222969"
                class="admission-phone"
            >
                Call the school
            </a>

        </div>

    </div>

</section>


