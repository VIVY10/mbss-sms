<!-- =========================================================
     ABOUT
========================================================= -->
<section
    class="section about-section"
    id="about"
>

    <div class="container">

        <div class="section-heading centered">

            <span class="eyebrow">
                About Our School
            </span>

            <h2>
                A place where
                <span>potential becomes purpose.</span>
            </h2>

            <p>
                Milenge Boarding Secondary School is committed to
                providing learners with the knowledge, skills,
                values and confidence needed to thrive in a
                changing world.
            </p>

        </div>


        <div class="about-grid">

            <div class="about-image">

                <img
                    src="/images/bg3.jpg"
                    alt="Milenge Boarding Secondary School campus"
                    loading="lazy"
                >

                <div class="experience-card">

                    <strong>Excellence</strong>

                    <span>
                        At the heart of everything we do
                    </span>

                </div>

            </div>


            <div class="about-content">

                <span class="content-label">
                    Who We Are
                </span>

                <h3>
                    Developing learners for academic
                    and lifelong success.
                </h3>

                <p>
                    Our school provides an environment where
                    learners are encouraged to think critically,
                    work collaboratively and develop strong
                    personal values.
                </p>

                <p>
                    Through quality teaching, co-curricular
                    activities, leadership opportunities and
                    responsible boarding life, we seek to develop
                    well-rounded young people who are ready for
                    the future.
                </p>


                <div class="about-features">

                    <div>
                        <span class="feature-check">✓</span>
                        <span>Qualified teaching staff</span>
                    </div>

                    <div>
                        <span class="feature-check">✓</span>
                        <span>Structured boarding environment</span>
                    </div>

                    <div>
                        <span class="feature-check">✓</span>
                        <span>Academic and personal support</span>
                    </div>

                    <div>
                        <span class="feature-check">✓</span>
                        <span>Sports and co-curricular activities</span>
                    </div>

                </div>

                <a
                    href="#contact"
                    class="text-link"
                >
                    Learn more about our school
                    <span>→</span>
                </a>

            </div>

        </div>

    </div>

</section>


