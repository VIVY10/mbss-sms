<%- include("../partials/navBar.ejs") %>
<!-- =========================================================
     CONTACT
========================================================= -->
<section
    class="section contact-section"
    id="contact"
>

    <div class="container contact-grid">

        <div class="contact-information">

            <span class="eyebrow">
                Get In Touch
            </span>

            <h2>
                We're here to
                <span>help.</span>
            </h2>

            <p>
                Whether you are a parent, guardian, learner
                or member of the community, our school
                administration is available to assist you.
            </p>


            <div class="contact-details">

                <div class="contact-detail">

                    <div class="contact-icon">
                        @
                    </div>

                    <div>

                        <span>
                            Email
                        </span>

                        <a href="mailto:info@milengeboardingsecondary.edu.zm">
                            info@milengeboardingsecondary.edu.zm
                        </a>

                    </div>

                </div>


                <div class="contact-detail">

                    <div class="contact-icon">
                        ☎
                    </div>

                    <div>

                        <span>
                            Telephone
                        </span>

                        <a href="tel:+260000000000">
                            +260 000 000 000
                        </a>

                    </div>

                </div>


                <div class="contact-detail">

                    <div class="contact-icon">
                        ◉
                    </div>

                    <div>

                        <span>
                            Location
                        </span>

                        <p>
                            Milenge District, Luapula Province,
                            Zambia
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- CONTACT FORM -->
        <div class="contact-form-card">

            <div class="form-header">

                <span>
                    Send an enquiry
                </span>

                <h3>
                    How can we help?
                </h3>

            </div>


            <div
                id="formMessage"
                class="form-message"
                role="alert"
                aria-live="polite"
            ></div>


            <form
                id="contactForm"
                method="POST"
                action="/contact"
                novalidate
            >

                <!-- Honeypot -->
                <div
                    class="form-hidden"
                    aria-hidden="true"
                >
                    <label for="website">
                        Website
                    </label>

                    <input
                        type="text"
                        id="website"
                        name="website"
                        tabindex="-1"
                        autocomplete="off"
                    >
                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Your full name"
                            autocomplete="name"
                            maxlength="100"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            autocomplete="email"
                            maxlength="150"
                            required
                        >

                    </div>

                </div>


                <div class="form-group">

                    <label for="subject">
                        Subject
                    </label>

                    <select
                        id="subject"
                        name="subject"
                        required
                    >

                        <option value="">
                            Select an enquiry type
                        </option>

                        <option value="admissions">
                            Admissions
                        </option>

                        <option value="academics">
                            Academic Enquiry
                        </option>

                        <option value="boarding">
                            Boarding
                        </option>

                        <option value="general">
                            General Enquiry
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="message">
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        maxlength="1000"
                        placeholder="How can we assist you?"
                        required
                    ></textarea>

                    <div class="character-count">
                        <span id="characterCount">0</span>
                        / 1000
                    </div>

                </div>


                <button
                    type="submit"
                    class="button button-primary form-submit"
                    id="formSubmit"
                >
                    <span>
                        Send Enquiry
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>
                </button>


                <p class="form-security-note">
                    Your information is used only to respond
                    to your enquiry.
                </p>

            </form>

        </div>

    </div>

</section>


<!-- =========================================================
     FINAL CTA
========================================================= -->
<section class="final-cta">

    <div class="container final-cta-inner">

        <div>

            <span class="eyebrow light">
                Milenge Boarding Secondary School
            </span>

            <h2>
                Education today.
                <span>Leadership tomorrow.</span>
            </h2>

        </div>

        <a
            href="#admissions"
            class="button button-light"
        >
            Start Your Enquiry
            <span>→</span>
        </a>

    </div>

</section>

</main>


