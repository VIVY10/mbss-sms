<%- include('../partials/page-start', {
    teacher,
    currentYear,
    activePage: 'history',
    pageTitle: 'Report History',
    pageSubtitle: 'Previously generated academic reports'
}) %>


<!-- =========================================================
     PAGE HEADING
========================================================== -->

<div class="page-heading">

    <div>

        <span class="eyebrow">
            REPORTS
        </span>

        <h1>
            Report History
        </h1>

        <p>
            Previously generated academic reports.
        </p>

    </div>

</div>


<!-- =========================================================
     REPORT HISTORY
========================================================== -->

<div class="content-card">


    <!-- Filters -->

    <div class="filter-bar">

        <div class="search-box">

            <i class="bi bi-search"></i>

            <input
                type="search"
                id="reportSearch"
                class="form-control"
                placeholder="Search reports...">

        </div>


        <select
            id="reportTypeFilter"
            class="form-select filter-control">

            <option value="">
                All Report Types
            </option>

            <option value="midterm">
                Mid-Term
            </option>

            <option value="termly">
                Termly
            </option>

            <option value="annual">
                End of Year
            </option>

        </select>

    </div>


    <!-- =====================================================
         TABLE
    ====================================================== -->

    <div class="table-responsive">

        <table
            id="reportHistoryTable"
            class="table professional-table">

            <thead>

                <tr>

                    <th>DATE</th>

                    <th>REPORT</th>

                    <th>CLASS</th>

                    <th>TERM</th>

                    <th>GENERATED BY</th>

                    <th>ACTIONS</th>

                </tr>

            </thead>


            <tbody>


                <% if (
                    typeof reports !== 'undefined' &&
                    reports?.length
                ) { %>


                    <% reports.forEach(report => { %>

                        <tr
                            data-report-type="<%= report.report_type || '' %>">

                            <!-- Date -->

                            <td>

                                <%= report.generated_date
                                    ? new Date(
                                        report.generated_date
                                      ).toLocaleDateString(
                                        'en-GB',
                                        {
                                            day: '2-digit',
                                            month: 'short',
                                            year: 'numeric'
                                        }
                                      )
                                    : '-'
                                %>

                            </td>


                            <!-- Report -->

                            <td>

                                <strong>

                                    <% if (report.report_type === 'midterm') { %>

                                        Mid-Term Academic Report

                                    <% } else if (report.report_type === 'termly') { %>

                                        Termly Academic Report

                                    <% } else if (report.report_type === 'annual') { %>

                                        End-of-Year Academic Report

                                    <% } else { %>

                                        Academic Report

                                    <% } %>

                                </strong>

                            </td>


                            <!-- Class -->

                            <td>

                                <%= report.levelname || '' %>
                                <%= report.classname || report.class || '-' %>

                            </td>


                            <!-- Term -->

                            <td>

                                <%= report.termname || '-' %>

                            </td>


                            <!-- Generated By -->

                            <td>

                                <%= report.generated_by_name || 'You' %>

                            </td>


                            <!-- Actions -->

                            <td>

                                <div class="table-actions">


                                    <!-- View -->

                                    <a
                                        href="/teacher/reports/<%= report.reportid %>/view"
                                        class="btn btn-sm btn-light"
                                        title="View report">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <!-- Print -->

                                    <a
                                        href="/teacher/reports/<%= report.reportid %>/pdf"
                                        target="_blank"
                                        rel="noopener"
                                        class="btn btn-sm btn-light"
                                        title="Open PDF">

                                        <i class="bi bi-printer"></i>

                                    </a>


                                    <!-- Download -->

                                    <a
                                        href="/teacher/reports/<%= report.reportid %>/pdf?download=1"
                                        class="btn btn-sm btn-light"
                                        title="Download PDF">

                                        <i class="bi bi-download"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>

                    <% }) %>


                <% } else { %>


                    <!-- Empty State -->

                    <tr id="reportHistoryEmpty">

                        <td
                            colspan="6"
                            class="empty-state">

                            <i class="bi bi-clock-history"></i>

                            <span>
                                No generated reports found.
                            </span>

                        </td>

                    </tr>


                <% } %>


                <!-- Search Empty State -->

                <tr
                    id="reportSearchEmpty"
                    class="d-none">

                    <td
                        colspan="6"
                        class="empty-state">

                        <i class="bi bi-search"></i>

                        <span>
                            No reports match your search.
                        </span>

                    </td>

                </tr>


            </tbody>

        </table>

    </div>

</div>


<%
    const pageScript =
        '/scripts/teacher/report-history.js';
%>

<%- include('../partials/page-end', { pageScript }) %>