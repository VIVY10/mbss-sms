<%- include("../partials/sidebar.ejs") %>
      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->

      <div class="card mb-3" style="max-width: 900px;">
        <div class="row g-0 ">
          <div class="col-md-6">
            <img src="/images/logo.png" class="img-fluid rounded-start" alt="form logo">
          </div>
          <div class="col-md-5">
            <div class="card-body">
              <form class="row g-0" action="addClass" method="post">
              <% if(locals.termData && locals.yearLevelData){ %>
                           <h3>Class Data</h3>
                              <div class="col-md-12 mb-4">
                                <select class="select" name="termid">
                                  <option selected disabled value="">Term...</option>
                                  <% termData.forEach(element => { %>
                                    <option value="<%= element.termid %>"> <%= element.termnumber %></option>                              
                                  <% }); %>
                                </select>
                              </div>
                
                            <div class="col-md-12 mb-4">
                              <select class="select" name="grade">
                                <option selected disabled value="">Grade...</option>
                                <% yearLevelData.forEach(element => { %>
                                  <option value="<%= element.levelorder %>"> <%= element.levelname %></option>                              
                                <% }); %>
                              </select>
                            </div>
                          <% } %>

                <div class="col-md-12 mb-4">
                  <select class="select" name="class" required>
                    <option selected disabled value="">Class...</option>
                    <option>A</option>
                    <option>B</option>
                    <option>C</option>
                    <option>D</option>
                  </select>
                </div>
                <div class="col-12">
                  <button class="btn btn-primary" type="submit">Create</button>
                </div>
              </form>
            </div>
            </div>
          </div>
        </div>
      </div>
      
      </div>
    </main>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>