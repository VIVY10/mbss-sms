<!-- //////////////////////////////////////////////////////// -->
<%- include("../partials/hodSidebar.ejs") %>

      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->

      <div class="card mb-3" style="max-width: 900px;">
        <div style="text-align: center; margin-top: 5px; padding-top: 10px;"></div>
        <div class="row g-0 ">
          <div class="col-md-6">
            <img src="/images/logo.png" class="img-fluid rounded-start" alt="form logo">
          </div>
          <div class="col-md-5">
            <div class="card-body">
              <form class="row g-0" action="allocateSubject" method="post">
                <h3>Subject Allocation</h3>
              <% if(locals.foundClass && locals.foundTeacher){ %>
                <h6><%= foundClass[0].subjectname %></h6>
                          <div class="row">
                              <div class="col-md-12 mb-5">
                                <label class="form-check-label" for="teacher">Teacher</label>
                                <select class="select" name="teacher">
                                  <option selected disabled value="">Choose...</option>
                                  <% foundTeacher.forEach(element => { %>
                                    <option value=<%= element.id %>><%= element.lname %> <%= element.fname %></option>                              
                                  <% }); %>
                                </select>
                              </div>
                            </div> 

                            <div class="row">
                              <div class="col-md-12 mb-4">
                                <label class="form-check-label" for="subjectid">Class</label>
                                <select class="select" name="subjectid">
                                  <option selected disabled value="">Choose...</option>
                                  <% foundClass.forEach(element => { %>
                                    <option value=<%= element.classsubjectid %>> <%= element.grade %><%= element.class %></option>                              
                                  <% }); %>
                                </select>
                              </div>
                            </div>
                            <% } %>
                      </div>
                <div class="col-12">
                  <button class="btn btn-primary" type="submit">Submit</button>
                </div>
              </form>
    
            </div>
          </div>
        </div>
      </div>
      
      </div>
    </main>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>