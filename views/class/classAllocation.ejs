      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->

      <div class="card mb-3" style="max-width: 900px;">
        <div style="text-align: center; margin-top: 5px; padding-top: 10px;"><h2>Class Data</h2></div>
        <div class="row g-0 ">
          <div class="col-md-6">
            <img src="/images/logo.png" class="img-fluid rounded-start" alt="form logo">
          </div>
          <div class="col-md-5">
            <div class="card-body">
              <form class="row g-0" action="allocateClass" method="post">
              <% if(locals.foundStudent && locals.foundClass){ %>
                          <div class="row">
                              <div class="col-md-12 mb-4">
                                <label class="form-check-label" for="examno">Student Name</label>
                                <select class="select" name="examno">
                                  <option selected disabled value="">Choose...</option>
                                  <% foundStudent.forEach(element => { %>
                                    <option value="<%= element.id %>"><%= element.lname %> <%= element.fname %></option>                              
                                  <% }); %>
                                </select>
                              </div>
                            </div> 

                            <div class="row">
                              <div class="col-md-12 mb-4">
                                <label class="form-check-label" for="classid">Class</label>
                                <select class="select" name="classid">
                                  <option selected disabled value="">Choose...</option>
                                  <% foundClass.forEach(element => { %>
                                    <option value="<%= element.classid %>"> <%= element.grade %><%= element.class %></option>                              
                                  <% }); %>
                                </select>
                              </div>
                            </div>
                            <% } %>
                      </div>
                <div class="col-12">
                  <button class="btn btn-primary" type="submit">Save</button>
                </div>
              </form>
    
            </div>
          </div>
        </div>
      </div>
      
      </div>
    </main>
  </div>
