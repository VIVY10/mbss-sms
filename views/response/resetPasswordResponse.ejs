<style>
    .alert-danger {
    color: #14562c;
    text-align: center;
    background-color: #f2dede;
    border-color: #ebccd1;
    padding: 15px;
    margin-bottom: 20px;
    border: 1px solid transparent;
    border-radius: 4px;
}

.alert-danger ul {
    margin: 0;
    padding-left: 20px;
    list-style-type: none;
}

.alert-danger a {
    margin: 10px;
    padding: 10px;
    text-decoration: none;
    font-weight: bold;
    color: blue;
}

.alert-danger a:hover {
    color: whitesmoke;
    background-color: #000;
    padding: 20px;
    transition: background-color 0.3s ease;
}

</style>
<% if (message.length > 0) { %>
    <div class="alert alert-danger">
        <ul>
            <li><%= message %> <a href="/login">Login</a></li>
        </ul>
    </div>
<% } %>
