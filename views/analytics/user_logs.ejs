<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User & Live Activity Dashboard</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="/styles/user_logs.css">
</head>
<body>
    <div class="container py-4">
        <!-- Theme Toggle -->
        <div class="d-flex justify-content-end mb-3">
            <button id="themeToggle" class="btn btn-sm btn-secondary">Toggle Light/Dark</button>
        </div>

        <!-- Page Header -->
        <h2 class="mb-4 text-center fw-bold">User Activity & Live Dashboard</h2>

        <!-- Filters Panel -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card p-3 shadow-sm">
                    <h5 class="fw-bold mb-3">Filters</h5>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="filter-label" for="filterUser">User</label>
                            <input type="text" id="filterUser" class="form-control" placeholder="Search user">
                        </div>
                        <div class="col-md-3">
                            <label class="filter-label" for="filterActivity">Activity Type</label>
                            <select id="filterActivity" class="form-select">
                                <option value="">All</option>
                                <option>LOGIN</option>
                                <option>LOGOUT</option>
                                <option>PAGE_VISIT</option>
                                <option>CREATE</option>
                                <option>UPDATE</option>
                                <option>DELETE</option>
                                <option>ERROR</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="filter-label" for="startDate">Start Date</label>
                            <input type="date" id="startDate" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="filter-label" for="endDate">End Date</label>
                            <input type="date" id="endDate" class="form-control">
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button id="applyFilters" class="btn btn-dark">Apply</button>
                        <button id="resetFiltersBtn" class="btn btn-secondary">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row">
            <!-- Activity Logs Table -->
            <div class="col-lg-8">
                <div class="card shadow-sm p-3 mb-4">
                    <h5 class="fw-bold mb-3">Activity Logs</h5>
                    <div class="table-responsive table-scrollable">
                        <table class="table table-striped table-hover align-middle" id="activityTable">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Activity</th>
                                    <th>Date</th>
                                    <th>Toggle</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <nav>
                        <ul class="pagination justify-content-center" id="pagination"></ul>
                    </nav>
                </div>
            </div>

            <!-- Real-Time Panel -->
            <div class="col-lg-4">
                <div class="card feed-card p-3 mb-4">
                    <h5>Live Feed</h5>
                    <div id="feed" class="feed"></div>
                </div>

                <div class="card online-card p-3 mb-4">
                    <h5>Online Now <span id="onlineCount">0</span></h5>
                    <div id="onlineUsers" class="online-list"></div>
                </div>

                <div class="card chart-card p-3 mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>Most Visited Pages (24h)</h5>
                        <button id="exportCsv" class="btn btn-sm btn-primary">Export CSV</button>
                    </div>
                    <canvas id="heatmapChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom JS -->
    <script src="/scripts/user_logs.js"></script>
</body>
</html>
