<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Education Platform Analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="../styles/analytics.css">
</head>

<body>
    <div class="container mt-5 mb-4 m-4">
        <!-- Header Section with Date Range and Download -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Platform Analytics Dashboard</h1>
            <div>
                <button id="downloadReport" class="btn btn-action me-2 no-print">
                    <i class="fas fa-download me-1"></i> Download Report
                </button>
                <div class="btn-group no-print">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="timePeriodDropdown"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        Last 30 Days
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="timePeriodDropdown">
                        <li><a class="dropdown-item time-period" href="#" data-value="7">Last 7 Days</a></li>
                        <li><a class="dropdown-item time-period" href="#" data-value="30">Last 30 Days</a></li>
                        <li><a class="dropdown-item time-period" href="#" data-value="90">Last Quarter</a></li>
                        <li><a class="dropdown-item time-period" href="#" data-value="365">Last Year</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item time-period" href="#" data-value="custom">Custom Range</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Date Range Picker (Initially Hidden) -->
        <div id="customDateRange" class="card mb-4 no-print" style="display: none;">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="card-title mb-0">Custom Date Range</h5>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3 float-md-end date-range-container">
                            <label for="startDate" class="form-label d-inline-block me-2 mb-0">From:</label>
                            <input type="date" id="startDate" class="form-control d-inline-block w-auto me-2" aria-label="Start date">
                            <span class="me-2">to</span>
                            <input type="date" id="endDate" class="form-control d-inline-block w-auto me-2" aria-label="End date">
                            <button id="applyDateRange" class="btn btn-primary">Apply</button>
                            <button id="cancelCustomRange" class="btn btn-outline-secondary">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards Row -->
        <div class="row">
            <!-- User Statistics Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="card-title mb-0">Users</h2>
                            <i class="fas fa-users text-primary" aria-hidden="true"></i>
                        </div>
                        <div class="metric-value" id="totalUsers">8,742</div>
                        <div class="metric-label">Total Platform Users</div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><span class="status-indicator status-active" aria-hidden="true"></span> Active</span>
                                <span>6,201 <small class="text-success">(+12%)</small></span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span><span class="status-indicator status-pending" aria-hidden="true"></span> New</span>
                                <span>542 <small class="text-success">(+5%)</small></span>
                            </div>
                        </div>

                        <div class="chart-container mt-3">
                            <canvas id="userGrowthChart" aria-label="User growth chart" role="img"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- School Statistics Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="card-title mb-0">Schools</h2>
                            <i class="fas fa-school text-primary" aria-hidden="true"></i>
                        </div>
                        <div class="metric-value" id="totalSchools">327</div>
                        <div class="metric-label">Across 24 Districts</div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><span class="status-indicator status-active" aria-hidden="true"></span> Active</span>
                                <span>298 <small class="text-success">(+8%)</small></span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span><span class="status-indicator status-pending" aria-hidden="true"></span> New</span>
                                <span>12 <small class="text-success">(+3%)</small></span>
                            </div>
                        </div>

                        <div class="chart-container mt-3">
                            <canvas id="schoolDistributionChart" aria-label="School distribution chart" role="img"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reports Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">Reports</h3>
                    </div>
                    <div class="card-body">
                        <div class="metric-value" id="totalReports">1,842</div>
                        <div class="metric-label">Submitted This Period</div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><span class="status-indicator status-completed" aria-hidden="true"></span> Approved</span>
                                <span>1,502 <small class="text-success">(82%)</small></span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span><span class="status-indicator status-pending" aria-hidden="true"></span> Pending</span>
                                <span>340 <small class="text-danger">(18%)</small></span>
                            </div>
                        </div>

                        <div class="chart-container mt-3">
                            <canvas id="reportTrendsChart" aria-label="Report trends chart" role="img"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assignments Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">Officers Assignments</h3>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <!-- Progress Visualization -->
                        <div class="text-center mb-4">
                            <div class="progress-circle progress-78" style="--progress: 78" aria-label="Completion rate: 78%">
                                <span class="progress-circle-value">78%</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Overall Completion Rate</p>
                        </div>

                        <!-- Key Metrics -->
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Completed</span>
                                <strong class="text-success">312/400</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Pending</span>
                                <strong class="text-danger">88</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer with Action Button -->
                    <div class="card-footer bg-light d-flex justify-content-end no-print">
                        <button class="btn btn-sm btn-secondary" id="view-all-assignments">
                            <i class="fas fa-bell me-1"></i> View All
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Section -->
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">Activity Timeline</h3>
                    </div>
                    <div class="card-body position-relative">
                        <div class="loading-spinner" id="timelineLoading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="chart-container large-chart-container">
                            <canvas id="activityTimelineChart" aria-label="Activity timeline chart" role="img"></canvas>
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-between no-print">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary active view-type" data-type="daily">Daily</button>
                            <button class="btn btn-outline-secondary view-type" data-type="weekly">Weekly</button>
                            <button class="btn btn-outline-secondary view-type" data-type="monthly">Monthly</button>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" id="exportTimeline">
                            <i class="fas fa-download me-1"></i> Export
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">Top Schools by Activity</h3>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush" id="topSchoolsList">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="school-rank top-1">1</span>
                                    <div>
                                        <strong>Greenwood High</strong>
                                        <div class="text-muted small">District 5</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-success small">▲ 12%</div>
                                    <span class="badge bg-primary rounded-pill">98%</span>
                                    <canvas class="sparkline" id="sparkline1" width="60" height="20" aria-hidden="true"></canvas>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="school-rank top-2">2</span>
                                    <div>
                                        <strong>Sunrise Academy</strong>
                                        <div class="text-muted small">District 3</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-success small">▲ 5%</div>
                                    <span class="badge bg-primary rounded-pill">92%</span>
                                    <canvas class="sparkline" id="sparkline2" width="60" height="20" aria-hidden="true"></canvas>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="school-rank top-3">3</span>
                                    <div>
                                        <strong>Maplewood Secondary</strong>
                                        <div class="text-muted small">District 7</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-danger small">▼ 2%</div>
                                    <span class="badge bg-primary rounded-pill">89%</span>
                                    <canvas class="sparkline" id="sparkline3" width="60" height="20" aria-hidden="true"></canvas>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="school-rank">4</span>
                                    <div>
                                        <strong>Riverside School</strong>
                                        <div class="text-muted small">District 2</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-success small">▲ 8%</div>
                                    <span class="badge bg-primary rounded-pill">85%</span>
                                    <canvas class="sparkline" id="sparkline4" width="60" height="20" aria-hidden="true"></canvas>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="school-rank">5</span>
                                    <div>
                                        <strong>Pinecrest Elementary</strong>
                                        <div class="text-muted small">District 1</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-success small">▲ 3%</div>
                                    <span class="badge bg-primary rounded-pill">82%</span>
                                    <canvas class="sparkline" id="sparkline5" width="60" height="20" aria-hidden="true"></canvas>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-end no-print">
                        <button class="btn btn-sm btn-outline-primary" id="viewAllSchools">
                            View All Schools <i class="fas fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Metrics Section -->
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">District Performance</h3>
                    </div>
                    <div class="card-body">
                        <div class="chart-container large-chart-container">
                            <canvas id="districtPerformanceChart" aria-label="District performance chart" role="img"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-dark">
                        <h3 class="mb-0 text-white">Report Status Distribution</h3>
                    </div>
                    <div class="card-body">
                        <div class="chart-container large-chart-container">
                            <canvas id="reportStatusChart" aria-label="Report status distribution chart" role="img"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Print Button (Hidden in Print) -->
    <div class="position-fixed bottom-0 end-0 m-3 no-print">
        <button class="btn btn-primary btn-lg rounded-circle shadow-lg" id="printDashboard" aria-label="Print dashboard">
            <i class="fas fa-print"></i>
        </button>
    </div>

    <!-- Theme Toggle Button (Hidden in Print) -->
    <div class="position-fixed bottom-0 start-0 m-3 no-print">
        <button class="btn btn-secondary btn-lg rounded-circle shadow-lg" id="themeToggle" aria-label="Toggle theme">
            <i class="fas fa-moon"></i>
        </button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@2.0.1/dist/chartjs-plugin-annotation.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-accessibility@1.3.0/dist/chartjs-plugin-accessibility.min.js"></script>
    <script src="/scripts/analytics.js"></script>
</body>
</html>