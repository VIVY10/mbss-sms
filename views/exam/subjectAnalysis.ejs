<body>
  <div class="container">
    <!-- Div to display the selected class -->    
    <div class="col-auto" id="selectedanalysisClassDisplay">
      </div>  
       <form form class="row g-3" id="subjectAnalysisForm">    
        <% if(locals.foundClass && locals.examType){ %>   
      <div class="col-auto">
        <select class="form-control form-control-lg" name="subjectcode" id="selectanalysisSubjectcode" required>
          <option selected disabled value="">Class...</option>
          <% foundClass.forEach(element => { %>
              <option value="<%= element.subjectcode %>" 
                      data-classid="<%= element.classid %>" 
                      data-grade="<%= element.grade %>" 
                      data-section="<%= element.section %>">
                  <%= element.grade %><%= element.class %> --- <%= element.subjectname %>
              </option>  
          <% }); %>
      </select> 
    </div>
    
    <div class="col-auto">
      <div>
        <input type="number" name="classid" value="" id="selectanalysisClassid" hidden readonly/>  
        <input type="number" name="grade" value="" id="selectanalysisGrade" hidden readonly/>  
        <input type="number" name="year" value="" id="selectYear" hidden readonly/>                   
      </div>
  
    <!-- Div to display the selected class -->    
      <!-- <div class="col-auto" id="selectedanalysisClassDisplay">
      </div> -->
    </div>

      <div class="col-auto">        
        <select class="select form-control" name="examtype" required>
          <option selected disabled value="" >Exam type...</option>
          <% examType.forEach(element => { %>
            <option value=<%= element.examid %>><%= element.exam_title %></option>                              
          <% }); %>
        </select>
      </div>

      <div class="col-auto">        
        <select class="select form-control" name="term" id="term" required>
          <option selected disabled value="" >term...</option>
          <% term.forEach(element => { %>
            <option value="<%= element.termid %>" 
              data-year="<%= element.schoolyearid %>">
              <%= element.termnumber%> --- <%= element.yearname%>
            </option>                              
          <% }); %>
        </select>
      </div>
      <% } %>
      <div class="col-auto">
          <button type="button" id="submit6" class="btn-primary">Get Results</button>
      </div>
    </form>

    <div style="margin-bottom: 50px;"></div>

