<%- include("../partials/teacherDashboardSidebar.ejs") %>
      <!--///////////////////////////// content Placed here /////////////////////////-->
      <% if(locals.studentInfo){ %>
                <div class="card text-center">
                  <div class="card-body">
                    <div class="card-header">
                      <h3>RESULTS ENTRY FORM</h3>
                      <h6><%= studentInfo[0].subjectname %> - <%= studentInfo[0].grade %><%= studentInfo[0].class %></h6>
                    </div>
                    <form id="marksEntryForm">
                      <input type="number" name="examid" id="examid" value=<%= examtype %>  hidden>
                        <div class="col-md-12 mb-4">
                          <table class="table">
                            <thead class="table-light">
                              <tr>
                                <th>fname</th>
                                <th>lname</th>
                                <th>examno</th>
                                <th>score</th>
                              </tr>
                            </thead>
                          <% studentInfo.forEach(index => { %>                            
                          <tbody>
                            <tr >
                              <td><%= index.lname %></td>
                              <td><%= index.fname %></td>
                              <td><%= index.examno %></td>
                              <input type="number" name="examno[]" value="<%= index.examno %>" id="examno"  hidden>
                              <td><input type="number" name="score[]" min="0" max="100" placeholder="0" id="score" style="text-align: center; width: 100px;"/></td>
                              <!-- <td>
                                <input type="checkbox" id="absent" name="absent[]" value="X">
                              </td>
                              <td>
                                <input type="checkbox" id="na" name="na[]" value="NA">
                              </td>
                              <td>
                                L
                              </td> -->
                            </tr>
                          </tbody>                           
                          </div>
                          <% }) %>    
                          <input type="number"  name="subjectcode" id="subjectcode" value=<%= subjectcode %> hidden>  
                          <input type="number"  name="termid" id="termid" value=<%= termid %> hidden>  
                          <input type="number"  name="yearid" id="yearid" value=<%= yearid %> hidden>                        
                        </div>
                      </div> 
                      <td><button type="submit" class="btn btn-success btn-md ms-2" id="marksheetsubmit">Submit</button></td>                                    
                    </form>
                    <% } %>
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

    <script src="/scripts/adminScripts.js"></script>
    <script src="/scripts/scripts.js"></script>
    </body>

    </html>