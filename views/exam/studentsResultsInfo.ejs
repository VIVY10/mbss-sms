<%- include("../partials/sidebar.ejs") %>
      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
<div class="table-responsive">
      <table class="table">
        <thead class="table-light">
          <tr> 
            <th>fName</th>
            <th>fName</th>                    
            <th>examNo</th>
            <th>Gender</th>
            <th>Class</th>
            <th>Midterm</th>
            <th>EndOfTerm</th>
          </tr>
        </thead>
      <% if(locals.foundStudentInfo && locals.midTerm && locals.endOfTerm){ %>
        <% foundStudentInfo.forEach(element => { %>          
            <tbody>
              <tr>
                <td><%= element.fname %></td>
                <td><%= element.lname %></td>
                <td><%= element.id %></td>
                <td><%= element.gender %></td>
                <td><%= element.grade %><%= element.class %></td>
                <td><a href="/reportCard?t5fre=<%= midTerm.midtermid %>&&hgt=<%= element.id %>"><i class="material-symbols-outlined">visibility</i></a></td>
                <td><a href="/reportCard?t5fre=<%= endOfTerm.endoftermid %>&&hgt=<%= element.id %>"><i class="material-symbols-outlined">visibility</i></a></td>               
              </tr>
            </tbody>        
        <% }); %>        
        <% } else{%>
              <h3>No Records found</h3>
          <% } %>
      </table>      
      </div>
    </main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>