<!-- =========================================================
     views/teachers/index.ejs
     Teachers Directory
========================================================= -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Teachers | School Management System</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >
    <link rel="stylesheet" href="/styles/teacher-index.css">
</head>

<body>

<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </div>

        <div>
            <div class="brand-text">
                School Management
            </div>

            <span class="brand-subtitle">
                Administration Portal
            </span>
        </div>

    </div>


    <nav class="sidebar-menu">

        <div class="menu-label">
            Main
        </div>

        <a href="/dashboard" class="sidebar-link">
            <i class="bi bi-grid-1x2"></i>
            Dashboard
        </a>


        <div class="menu-label">
            Academic
        </div>

        <a href="/viewPupils" class="sidebar-link">
            <i class="bi bi-people"></i>
            Students
        </a>

        <a href="/viewTeachers" class="sidebar-link active">
            <i class="bi bi-person-workspace"></i>
            Teachers
        </a>

        <a href="get_class" class="sidebar-link">
            <i class="bi bi-building"></i>
            Classes
        </a>

        <a href="ViewSubjects" class="sidebar-link">
            <i class="bi bi-book"></i>
            Subjects
        </a>

        <a href="viewDepartment" class="sidebar-link">
            <i class="bi bi-diagram-3"></i>
            Departments
        </a>


        <div class="menu-label">
            Administration
        </div>

        <a href="#" class="sidebar-link">
            <i class="bi bi-person-check"></i>
            Teaching Allocations
        </a>

        <a href="schoolYears" class="sidebar-link">
            <i class="bi bi-calendar3"></i>
            Academic Years
        </a>

        <a href="/terms" class="sidebar-link">
            <i class="bi bi-calendar-week"></i>
            Terms
        </a>

        <a href="#" class="sidebar-link">
            <i class="bi bi-bar-chart"></i>
            Reports
        </a>

    </nav>


    <div class="sidebar-footer">

        <div class="user-mini">

            <div class="user-avatar">
                <%= user.fname.charAt(0).toUpperCase() %><%= user.lname.charAt(0).toUpperCase() %>
            </div>

            <div>
                <div class="user-name">
                    <%= user.usertype %>
                </div>

                <div class="user-role">
                    System Administrator
                </div>
            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<main class="main">

    <!-- TOP BAR -->

    <header class="topbar">

        <div class="d-flex align-items-center">

            <button
                type="button"
                class="mobile-menu"
                id="menuBtn"
                aria-label="Open menu"
            >
                <i class="bi bi-list"></i>
            </button>

            <div>

                <h1 class="page-title">
                    Teachers
                </h1>

                <div class="breadcrumb-text">
                    Administration / Teachers
                </div>

            </div>

        </div>


        <div class="topbar-actions">

            <button
                type="button"
                class="notification-btn"
                title="Notifications"
            >
                <i class="bi bi-bell"></i>
                <span class="notification-dot"></span>
            </button>

            <div class="dropdown">

                <button
                    class="btn btn-light border dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                >
                    <i class="bi bi-person-circle me-1"></i>
                    <%= user.usertype %>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>
                        <a class="dropdown-item" href="/profile">
                            <i class="bi bi-person me-2"></i>
                            My Profile
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="/settings">
                            <i class="bi bi-gear me-2"></i>
                            Settings
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>
                        <a class="dropdown-item text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </header>


    <!-- CONTENT -->

    <section class="content">

        <!-- PAGE HEADING -->

        <div class="page-heading">

            <div>

                <h1>
                    Teachers Directory
                </h1>

                <p>
                    Manage teachers, departments, subjects and teaching assignments.
                </p>

            </div>


            <a
                href="/registerTeacher"
                class="btn btn-primary"
            >
                <i class="bi bi-plus-lg me-1"></i>
                Register Teacher
            </a>

        </div>


        <!-- =================================================
             STATISTICS
        ================================================== -->

        <div class="row g-3">

            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div>
                        <div class="stat-label">
                            Total Teachers
                        </div>

                        <div class="stat-number">
                            <%= typeof totalTeachers !== 'undefined' ? totalTeachers : (teachers ? teachers.length : 0) %>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div>
                        <div class="stat-label">
                            Active Teachers
                        </div>

                        <div class="stat-number">
                            <%= typeof activeTeachers !== 'undefined' ? activeTeachers : '-' %>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div>
                        <div class="stat-label">
                            Heads of Department
                        </div>

                        <div class="stat-number">
                            <%= typeof hodCount !== 'undefined' ? hodCount : '-' %>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div>
                        <div class="stat-label">
                            Departments
                        </div>

                        <div class="stat-number">
                            <%= typeof departmentCount !== 'undefined' ? departmentCount : '-' %>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             DIRECTORY
        ================================================== -->

        <div class="directory-card">

            <!-- HEADER -->

            <div class="directory-header">

                <div>

                    <div class="directory-title">
                        All Teachers
                    </div>

                    <div class="directory-subtitle">
                        View and manage registered teachers.
                    </div>

                </div>

            </div>


            <!-- FILTERS -->

            <div class="filters">

                <div class="row g-2">

                    <!-- SEARCH -->

                    <div class="col-lg-5">

                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input
                                type="search"
                                class="form-control"
                                id="teacherSearch"
                                placeholder="Search by name, teacher ID or email..."
                                autocomplete="off"
                            >

                        </div>

                    </div>


                    <!-- DEPARTMENT -->

                    <div class="col-sm-4 col-lg-2">

                        <select
                            class="form-select"
                            id="departmentFilter"
                        >

                            <option value="">
                                All Departments
                            </option>

                            <% if (typeof departments !== 'undefined' && departments) { %>

                                <% departments.forEach(department => { %>

                                    <option value="<%= department.departmentid %>">
                                        <%= department.departmentname %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <!-- ROLE -->

                    <div class="col-sm-4 col-lg-2">

                        <select
                            class="form-select"
                            id="roleFilter"
                        >

                            <option value="">
                                All Roles
                            </option>

                            <option value="teacher">
                                Teacher
                            </option>

                            <option value="hod">
                                HOD
                            </option>

                        </select>

                    </div>


                    <!-- STATUS -->

                    <div class="col-sm-4 col-lg-2">

                        <select
                            class="form-select"
                            id="statusFilter"
                        >

                            <option value="">
                                All Statuses
                            </option>

                            <option value="active">
                                Active
                            </option>

                            <option value="inactive">
                                Inactive
                            </option>

                            <option value="suspended">
                                Suspended
                            </option>

                        </select>

                    </div>


                    <!-- RESET -->

                    <div class="col-lg-1">

                        <button
                            type="button"
                            class="btn btn-light border w-100"
                            id="resetFilters"
                            title="Reset filters"
                        >
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>

                    </div>

                </div>

            </div>


            <!-- TABLE -->

            <div class="table-wrapper">

                <table
                    class="table teacher-table"
                    id="teachersTable"
                >

                    <thead>

                        <tr>

                            <th>
                                Teacher
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Departments
                            </th>

                            <th>
                                Subjects
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="teacherTableBody">

                        <% if (teachers && teachers.length) { %>

                            <% teachers.forEach(teacher => { %>

                                <tr
                                    class="teacher-row"
                                    data-name="<%= `${teacher.fname} ${teacher.middlename || ''} ${teacher.lname}`.toLowerCase() %>"
                                    data-id="<%= String(teacher.teacherid).toLowerCase() %>"
                                    data-email="<%= (teacher.email || '').toLowerCase() %>"
                                    data-role="<%= (teacher.usertype || '').toLowerCase() %>"
                                    data-status="<%= (teacher.status || '').toLowerCase() %>"
                                    data-department="<%= teacher.departmentid || '' %>"
                                >

                                    <!-- TEACHER -->

                                    <td>

                                        <div class="teacher-info">

                                            <% if (teacher.profilePicture) { %>

                                                <img
                                                    src="/images/profile/<%= teacher.profilePicture %>"
                                                    class="teacher-avatar"
                                                    alt="<%= teacher.fname %>"
                                                >

                                            <% } else { %>

                                                <div class="teacher-avatar">

                                                    <%= (teacher.fname || '').charAt(0).toUpperCase() %><%= (teacher.lname || '').charAt(0).toUpperCase() %>

                                                </div>

                                            <% } %>


                                            <div>

                                                <div class="teacher-name">

                                                    <%= teacher.fname %>

                                                    <% if (teacher.middlename) { %>
                                                        <%= teacher.middlename %>
                                                    <% } %>

                                                    <%= teacher.lname %>

                                                </div>

                                                <div class="teacher-id">

                                                    ID:
                                                    <%= teacher.teacherid %>

                                                    <% if (teacher.email) { %>
                                                        · <%= teacher.email %>
                                                    <% } %>

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ROLE -->

                                    <td>

                                        <% if (teacher.usertype) { %>

                                            <span class="role-badge role-hod">
                                                <i class="bi bi-person-badge me-1"></i>
                                                <%= teacher.usertype %>
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- DEPARTMENTS -->

                                    <td>

                                        <span class="fw-semibold">

                                            <%= teacher.departmentCount || 0 %>

                                        </span>

                                        <span class="text-muted">
                                            department<%= (teacher.departmentCount || 0) == 1 ? '' : 's' %>
                                        </span>

                                    </td>


                                    <!-- SUBJECTS -->

                                    <td>

                                        <span class="fw-semibold">

                                            <%= teacher.subjectCount || 0 %>

                                        </span>

                                        <span class="text-muted">
                                            subject<%= (teacher.subjectCount || 0) == 1 ? '' : 's' %>
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <%
                                            const status =
                                                (teacher.status || 'active').toLowerCase();
                                        %>


                                        <% if (status === 'active') { %>

                                            <span class="status-badge status-active">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Active
                                            </span>

                                        <% } else if (status === 'suspended') { %>

                                            <span class="status-badge status-suspended">
                                                <i class="bi bi-pause-circle me-1"></i>
                                                Suspended
                                            </span>

                                        <% } else { %>

                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-1">

                                            <a
                                                href="/teachers/<%= teacher.teacherid %>"
                                                class="action-btn"
                                                title="View teacher"
                                            >
                                                <i class="bi bi-eye"></i>
                                            </a>


                                            <!-- <a
                                                href="/teachers/edit/<%= teacher.teacherid %>"
                                                class="action-btn"
                                                title="Edit teacher"
                                            >
                                                <i class="bi bi-pencil"></i>
                                            </a> -->

                                             <!-- Lock / Unlock -->

                            <% if (Number(teacher.is_locked)) { %>

                                <a
                                    class="action-btn"
                                    href="/unlockTeacherAccount?username=<%= encodeURIComponent(teacher.username) %>"
                                    onclick="return confirm('Are you sure you want to unlock this account?')"
                                >
                                    <i class="bi bi-lock" title="unlock teacher account">
                                    </i>
                                </a>

                            <% } else { %>

                                <a
                                    class="action-btn"
                                    href="/lockTeacherAccount?username=<%= encodeURIComponent(teacher.username) %>"
                                    onclick="return confirm('Are you sure you want to lock this account?')"
                                >
                                    <i class="bi bi-unlock" title="lock teacher account">
                                    </i>
                                </a>

                            <% } %>


                                            <button
                                                type="button"
                                                class="action-btn"
                                                title="More actions"
                                                data-bs-toggle="dropdown"
                                            >
                                                <i class="bi bi-three-dots"></i>
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href="/profile/<%= teacher.teacherid %>"
                                                    >
                                                        <i class="bi bi-person me-2"></i>
                                                        View Profile
                                                    </a>
                                                </li>

                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href="/teachers/departments/<%= teacher.teacherid %>"
                                                    >
                                                        <i class="bi bi-diagram-3 me-2"></i>
                                                        Manage Departments
                                                    </a>
                                                </li>

                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href="/teachers/subjects/<%= teacher.teacherid %>"
                                                    >
                                                        <i class="bi bi-book me-2"></i>
                                                        Manage Subjects
                                                    </a>
                                                </li>

                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>

                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href="/teachers/teaching-load/<%= teacher.teacherid %>"
                                                    >
                                                        <i class="bi bi-person-check me-2"></i>
                                                        Teaching Load
                                                    </a>
                                                </li>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>


                        <% } else { %>

                            <tr>

                                <td colspan="6">

                                    <div class="empty-state">

                                        <div class="empty-icon">
                                            <i class="bi bi-person-workspace"></i>
                                        </div>

                                        <h4>
                                            No teachers found
                                        </h4>

                                        <p>
                                            There are currently no teachers registered in the system.
                                        </p>

                                        <a
                                            href="/registerTeacher"
                                            class="btn btn-primary btn-sm"
                                        >
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Register Teacher
                                        </a>

                                    </div>

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>


            <!-- FOOTER -->

            <div class="directory-footer">

                <div
                    class="results-count"
                    id="resultsCount"
                >
                    Showing
                    <strong><%= teachers ? teachers.length : 0 %></strong>
                    teachers
                </div>


                <nav>

                    <ul class="pagination pagination-sm">

                        <li class="page-item disabled">
                            <span class="page-link">
                                Previous
                            </span>
                        </li>

                        <li class="page-item active">
                            <span class="page-link">
                                1
                            </span>
                        </li>

                        <li class="page-item disabled">
                            <span class="page-link">
                                Next
                            </span>
                        </li>

                    </ul>

                </nav>

            </div>

        </div>

    </section>

</main>


<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/scripts/teacher-index.js"></script>

</body>
</html>