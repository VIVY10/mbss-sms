
<%- include("../partials/teacherDashboardSidebar.ejs") %>
<title>Allocated Subjects</title>
  <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
  <div class="container">
    <div class="card mt-3">
      <div class="card-body">
        <h4>Allocated Subjects</h4>
        <table class="table table-bordered table-hover" id="table">
          <thead class="thead-light">
            <tr>
              <th>Class</th>
              <th>Subject Code</th>
              <th>Subject Name</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (response && response.length > 0) { %>
              <% response.forEach(element => { %>
                <tr>
                  <td><%= element.grade %> <%= element.class %></td>
                  <td><%= element.subjectcode %></td>
                  <td><%= element.subjectname %></td>
                  <td>
                    <form action="/registeredPupils" method="POST" style="display: inline;">
                      <input type="hidden" name="subjectcode" value="<%= element.subjectcode %>">
                      <input type="hidden" name="classid" value="<%= element.classid %>">
                      <button type="submit" class="btn btn-primary">See Pupils</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center"><h5>No Subject(s) Allocated</h5></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div> 
  </div>

  <!-- Include Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
  integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
  <script src="/scripts/adminScripts.js"></script>
</body>
</html>
