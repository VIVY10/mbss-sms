<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= teacher.fname %> <%= teacher.lname %> | Teacher Profile</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >
    <link rel="stylesheet" href="/styles/teacher-profile.css">
</head>

<body>

<div class="page-wrapper">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h3 class="page-title">Teacher Profile</h3>

            <div class="page-subtitle">
                View and manage teacher information, departments,
                subjects and teaching allocations.
            </div>
        </div>

        <a 
        href="<%= user.usertype === 'admin' ? '/viewTeachers' : '/Dashboard' %>"
        class="btn btn-light border">
            <i class="bi bi-arrow-left"></i>
            Back to Teachers
        </a>

    </div>


    <!-- PROFILE HEADER -->

    <div class="profile-card">

        <div class="profile-header">

            <div class="profile-main">

                <% if (teacher.profilePicture) { %>

                    <img
                        src="/images/profile/<%= teacher.profilePicture %>"
                        alt="Teacher profile"
                        class="profile-photo"
                    >

                <% } else { %>

                    <div class="profile-placeholder">
                        <i class="bi bi-person"></i>
                    </div>

                <% } %>


                <div>

                    <div class="teacher-name">
                        <%= teacher.fname %>
                        <% if (teacher.middlename) { %>
                            <%= teacher.middlename %>
                        <% } %>
                        <%= teacher.lname %>
                    </div>

                    <div class="teacher-id">
                        Teacher ID:
                        <strong><%= teacher.employee_no %></strong>
                    </div>

                    <div class="profile-meta">

                        <span class="badge-soft">
                            <i class="bi bi-person-badge"></i>
                            <%= teacher.usertype || '' %>
                        </span>

                        <span class="badge-soft status-active">
                            <i class="bi bi-check-circle"></i>
                            <%= teacher.status || '' %>
                        </span>

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->
            <% if(user.usertype === "admin") { %>
            <div class="profile-actions">

                <a
                    href="/teachers/edit/<%= teacher.teacherid %>"
                    class="btn btn-outline-secondary"
                >
                    <i class="bi bi-pencil"></i>
                    Edit
                </a>
                <% } %>
                <button
                    class="btn btn-primary-custom"
                    data-bs-toggle="modal"
                    data-bs-target="#allocationModal"
                >
                    <i class="bi bi-diagram-3"></i>
                    Allocate
                </button>

            </div>


        </div>

    </div>


    <!-- STATISTICS -->

    <div class="row g-3 mt-1">

        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div class="stat-number">
                    <%= departments?.length ?? 0 %>
                </div>

                <div class="stat-label">
                    Departments
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-book"></i>
                </div>

                <div class="stat-number">
                    <%= subjects?.length || 0 %>
                </div>

                <div class="stat-label">
                    Subjects
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-easel"></i>
                </div>

                <div class="stat-number">
                    <%= allocations?.length || 0 %>
                </div>

                <div class="stat-label">
                    Current Classes
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="stat-number">
                    <%= allocationHistory?.length || 0 %>
                </div>

                <div class="stat-label">
                    Allocation Records
                </div>

            </div>

        </div>

    </div>


    <!-- TABS -->

    <div class="profile-tabs">

        <ul class="nav nav-pills" id="teacherTabs">

            <li class="nav-item">
                <button
                    class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#overview"
                >
                    Overview
                </button>
            </li>

            <li class="nav-item">
                <button
                    class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#departments"
                >
                    Departments
                </button>
            </li>

            <li class="nav-item">
                <button
                    class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#subjects"
                >
                    Subjects
                </button>
            </li>

            <li class="nav-item">
                <button
                    class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#allocations"
                >
                    Teaching Allocation
                </button>
            </li>

            <li class="nav-item">
                <button
                    class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#history"
                >
                    History
                </button>
            </li>

        </ul>

    </div>


    <div class="tab-content mt-4">


        <!-- ================================
             OVERVIEW
        ================================= -->

        <div
            class="tab-pane fade show active"
            id="overview"
        >

            <div class="row g-4">

                <!-- PERSONAL -->

                <div class="col-lg-6">

                    <div class="content-card">

                        <div class="section-title">
                            <i class="bi bi-person"></i>
                            Personal Information
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                First Name
                            </span>

                            <span class="info-value">
                                <%= teacher.fname %>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                Last Name
                            </span>

                            <span class="info-value">
                                <%= teacher.lname %>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                Gender
                            </span>

                            <span class="info-value">
                                <%= teacher.gender || '-' %>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                Date of Birth
                            </span>

                            <span class="info-value">
                                <%= teacher.dob || '-' %>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                Phone
                            </span>

                            <span class="info-value">
                                <%= teacher.phone || '-' %>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                Email
                            </span>

                            <span class="info-value">
                                <%= teacher.email || '-' %>
                            </span>
                        </div>

                    </div>

                </div>


                <!-- EMPLOYMENT -->

                <div class="col-lg-6">

                    <div class="content-card">

                        <div class="section-title">
                            <i class="bi bi-briefcase"></i>
                            Employment Information
                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Teacher ID
                            </span>

                            <span class="info-value">
                                <%= teacher.teacherid %>
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Role
                            </span>

                            <span class="info-value">
                                <%= teacher.usertype || '-' %>
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Employment Date
                            </span>

                            <span class="info-value">
                                <%= teacher.employment_date || '-' %>
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Account Status
                            </span>

                            <span class="info-value">

                                <span class="badge-soft status-active">
                                    <%= teacher.status || '-' %>
                                </span>

                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Last Login
                            </span>

                            <span class="info-value">
                                <%= teacher.last_login || '-' %>
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================
             DEPARTMENTS
        ================================= -->

        <div
            class="tab-pane fade"
            id="departments"
        >

            <div class="content-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="section-title mb-0">
                        <i class="bi bi-building"></i>
                        Assigned Departments
                    </div>
                     <% if(user.usertype === "admin") { %>
                    <button
                        class="btn btn-primary-custom btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#departmentModal"
                    >
                        <i class="bi bi-plus-lg"></i>
                        Assign Department
                    </button>
                    <% } %>
                </div>


                <% if (departments?.length) { %>

                    <% departments.forEach(department => { %>

                        <div class="department-item">

                            <div>

                                <div class="department-name">
                                    <%= department.departmentname %>
                                </div>

                                <div class="department-meta">

                                    Assigned:
                                    <%= department.start_date ? 
                                    new Date(department.start_date)
                                    .toLocaleDateString('en-GB') : '-' %>

                                </div>

                            </div>

                            <div>

                                <% if (department.is_hod) { %>

                                    <span class="badge-soft">
                                        HOD
                                    </span>

                                <% } else { %>

                                    <span class="badge-soft">
                                        Teacher
                                    </span>

                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="text-center py-5 text-muted">

                        <i class="bi bi-building fs-1"></i>

                        <p class="mt-3">
                            No departments assigned.
                        </p>

                    </div>

                <% } %>

            </div>

        </div>


        <!-- ================================
             SUBJECTS
        ================================= -->

        <div
            class="tab-pane fade"
            id="subjects"
        >

            <div class="table-card">

                <div class="table-card-header">

                    <div class="section-title mb-0">
                        <i class="bi bi-book"></i>
                        Assigned Subjects
                    </div>
                     <% if(user.usertype === "admin") { %>
                    <button
                        class="btn btn-primary-custom btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#subjectModal"
                    >
                        <i class="bi bi-plus-lg"></i>
                        Assign Subject
                    </button>
                    <% } %>
                </div>

                <div class="table-responsive">

                    <table class="table mb-0">

                        <thead>

                            <tr>
                                <th>Subject Code</th>
                                <th>Subject</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>

                            <% if (subjects?.length) { %>

                                <% subjects.forEach(subject => { %>

                                    <tr>

                                        <td class="subject-code">
                                            <%= subject.subjectcode %>
                                        </td>

                                        <td>
                                            <%= subject.subjectname %>
                                        </td>

                                        <td>
                                            <%= subject.departmentname %>
                                        </td>

                                        <td>
                                            <% if(subject.status === 'active') { %>

                                            <span class="badge-soft status-active">
                                                active
                                            </span>

                                            <% } else { %>
                                                <span class="badge-soft status-inactive">
                                                    <%= subject.status %>
                                                </span>

                                            <% } %>

                                        </td>

                                        <td class="text-end">

                                            <a
                                                href="/teacher-subject/<%= subject.teacher_subjectid %>"
                                                class="btn btn-sm btn-light border"
                                                title="Remove subject"
                                            >
                                                <i class="bi bi-trash"></i>
                                        </a>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td
                                        colspan="5"
                                        class="text-center text-muted py-5"
                                    >
                                        No subjects assigned.
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- ================================
             CURRENT ALLOCATIONS
        ================================= -->

        <div
            class="tab-pane fade"
            id="allocations"
        >

            <div class="table-card">

                <div class="table-card-header">

                    <div class="section-title mb-0">
                        <i class="bi bi-easel"></i>
                        Current Teaching Allocation
                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table mb-0">

                        <thead>

                            <tr>
                                <th>Class</th>
                                <th>Level</th>
                                <th>Subject</th>
                                <th>Department</th>
                                <th>Academic Year</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% if (allocations?.length) { %>

                                <% allocations.forEach(item => { %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= item.class %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= item.levelname %>
                                        </td>

                                        <td>
                                            <span class="subject-code">
                                                <%= item.subjectcode %>
                                            </span>
                                            -
                                            <%= item.subjectname %>
                                        </td>

                                        <td>
                                            <%= item.departmentname %>
                                        </td>

                                        <td>
                                            <%= item.yearname || '-' %>
                                        </td>

                                        <td>
                                            <% if(item.status === 'active') {%>

                                            <span class="badge-soft status-active">
                                                active
                                            </span>

                                            <% } else { %>

                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                <%= item.status %>
                                            </span>

                                        <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td
                                        colspan="6"
                                        class="text-center text-muted py-5"
                                    >
                                        No current teaching allocations.
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- ================================
             HISTORY
        ================================= -->

        <div
            class="tab-pane fade"
            id="history"
        >

            <div class="table-card">

                <div class="table-card-header">

                    <div class="section-title mb-0">
                        <i class="bi bi-clock-history"></i>
                        Teaching Allocation History
                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table mb-0">

                        <thead>

                            <tr>
                                <th>Academic Year</th>
                                <th>Class</th>
                                <th>Subject</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Allocated On</th>
                                <th>End Date</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% if (allocationHistory?.length) { %>

                                <% allocationHistory.forEach(item => { %>

                                    <tr>

                                        <td>
                                            <%= item.yearname || '-' %>
                                        </td>

                                        <td>
                                             <%= item.levelname|| '-' %><%= item.class || '-' %>
                                        </td>

                                        <td>

                                            <strong>
                                                <%= item.subjectcode %>
                                            </strong>

                                            -
                                            <%= item.subjectname %>

                                        </td>

                                        <td>
                                            <%= item.departmentname %>
                                        </td>

                                        <td>
                                            <%= item.status || '-' %>
                                        </td>

                                        <td>
                                            <%= item.start_date ? new Date(item.start_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '-' %>

                                        </td>
                                        <td>
                                            <%= item.end_date ? new Date(item.end_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '-' %>

                                        </td>


                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td
                                        colspan="5"
                                        class="text-center text-muted py-5"
                                    >
                                        No allocation history.
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =====================================
     ALLOCATION MODAL
===================================== -->

<div
    class="modal fade"
    id="allocationModal"
    tabindex="-1"
>

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Allocate Teacher
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>

            <form id="allocationForm">

                <div class="modal-body">

                    <div class="alert alert-light border">

                        <i class="bi bi-info-circle"></i>

                        Select the class subject this teacher should teach.
                        The subject must already exist in
                        <strong>teacher assigned subjects</strong>.

                    </div>


                    <div class="row g-3">

                        <!-- <div class="col-md-6">

                            <label class="form-label">
                                Class
                            </label>

                            <select
                                class="form-select"
                                name="classid"
                                id="allocationClass"
                                required
                            >

                                <option value="">
                                    Select class 
                                </option>

                                <% availableClasses?.forEach(item => { %>

                                    <option
                                        value="<%= item.classid %>"
                                    >
                                        <%= item.levelname %>
                                        <%= item.class %>
                                    </option>

                                <% }) %>

                            </select>

                        </div> -->


                        <div class="col-md-6">
                            <input type="hidden" name="teacherid" value="<%= teacher.teacherid %>">

                            <label class="form-label">
                                Subject
                            </label>

                            <select
                                class="form-select"
                                name="class_subject_id"
                                required
                            >

                                <option value="">
                                    Select class subject
                                </option>

                                <% availableTeacherClassSubjects?.forEach(item => { %>

                                    <option
                                        value="<%= item.class_subject_id %>"
                                    >

                                        <%= item.subjectcode %>
                                        -
                                        <%= item.subjectname %>
                                        /
                                         <%= item.levelname %><%= item.class %>

                                    </option>

                                <% }) %>

                            </select>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary-custom"
                    >
                        <i class="bi bi-check-lg"></i>
                        Save Allocation
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =====================================
     DEPARTMENT MODAL
===================================== -->

<div
    class="modal fade"
    id="departmentModal"
    tabindex="-1"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Assign Department
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>

            <form
                method="POST"
                action="/allocateDepartment/<%= teacher.teacherid %>"
            >

                <div class="modal-body">

                    <label class="form-label">
                        Department
                    </label>

                    <select
                        class="form-select"
                        name="departmentid"
                        required
                    >

                        <option value="">
                            Select department
                        </option>

                        <% availableDepartments?.forEach(department => { %>

                            <option
                                value="<%= department.departmentid %>"
                            >
                                <%= department.departmentname %>
                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary-custom"
                    >
                        Assign Department
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =====================================
     SUBJECT MODAL
===================================== -->

<div
    class="modal fade"
    id="subjectModal"
    tabindex="-1"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Assign Subject
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>

            <form id="assignSubject">
                <div class="modal-body">

                    <div class="alert alert-light border">

                        Subjects should normally belong to a department
                        already assigned to this teacher.

                    </div>
                    <input type="hidden" name="teacherid" value="<%= teacher.teacherid %>">
                    <label class="form-label">
                        Subject
                    </label>

                    <select
                        class="form-select"
                        name="subjectcode"
                        required
                    >

                        <option value="">
                            Select subject
                        </option>

                        <% availableSubjects?.forEach(subject => { %>

                            <option
                                value="<%= subject.subjectcode %>"
                            >

                                <%= subject.subjectcode %>
                                -
                                <%= subject.subjectname %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary-custom"
                    >
                        Assign Subject
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>
<script src="/scripts/teacher-profile.js"></script>

</body>
</html>
