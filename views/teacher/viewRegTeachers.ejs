<%- include("../partials/sidebar") %>
      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
      <div class="table-responsive">
        <div style="float: right;">
          <a href="/registerTeacher">
              <button type="submit" class="btn btn-success">Add Teacher</button>
          </a>
      </div>
      <table class="table table-bordered">
        <h3>Registered Teacher</h3>
        <thead class="table-dark">
          <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Gender</th>
            <th>Username</th>
            <th>UserType</th>
            <th>Email</th>
            <th>Date Created</th>
            <th colspan="3">Action</th>
          </tr>
        </thead>
      <% if(locals.results){ %>
        <% results.forEach(element => { %>
          <% console.log(element) %>          
            <tbody>
              <tr>
                <td><%= element.id %></td>
                <td><%= element.fname %> <%= element.lname %></td>
                <td><%= element.gender %></td>
                <td><%= element.username %></td>
                <td><%= element.usertype %></td>
                <td><%= element.email %></td>
                <!-- <td><%= element.time_created.toDateString() %></td> -->
                <td>
                  <%= new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(element.time_created) %>
                </td> 
                <td>
                    <a href="/updateTeacherRecord?username<%= element.username %>"><i class="material-icons" title="edit user account">edit</i></a>
                </td>       
                <td>
                  <a href="/deleteTeacher?username=<%= element.username %>"><i class="material-icons" title="delete user account">delete</i></a>
                </td> 
                <td>
                  <a href="/lockTeacherAccount?username=<%= element.username %>"><i class="material-icons" title="lock user account">lock</i></a>
                </td>           
              </tr> 
            </tbody>                 
          <% }); %> 
        <% } %>
      </table>        
      </div>
    </main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>