<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" 
    integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <title>UpdateTeacherRecords</title>
</head>
<body>
    <form action="/updateTeacherRecord" method="post" class="h-100 bg-white">
        <div class="container py-5 h-100">
          <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col">
              <div class="card card-registration my-4">
                <div class="row g-0">
                  <div class="col-xl-6 d-none d-xl-block">
                    <img src="/images/logo.png"
                      alt="Mbss logo" class="img-fluid"
                      style="border-top-left-radius: .25rem; border-bottom-left-radius: .25rem;" />
                  </div>
                  <div class="col-xl-6">
                    
                    <div class="card-body p-md-5 text-black">
                      <h3 class="mb-5 text-uppercase">Update Teacher Records</h3>
      
                      <div class="row">
                        <div class="col-md-6 mb-4">
                          <div class="form-outline">
                            <label class="form-label" for="username">TS Number</label>
                            <input type="number" name="username" value="<%= username %>" class="form-control form-control-lg" required/>
                          </div>
                        </div>
                        <div class="col-md-6 mb-4">
                          <div class="form-outline">
                            <label class="form-label" for="email">Email</label>
                            <input type="email" name="email" value="<%= email %>" class="form-control form-control-lg" />
                          </div>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-md-6 mb-4">
                          <div class="form-outline">
                            <label class="form-label" for="Fname">First name</label>
                            <input type="text" name="Fname" value="<%= Fname %>" class="form-control form-control-lg" />
                          </div>
                        </div>
                        <div class="col-md-6 mb-4">
                          <div class="form-outline">
                            <label class="form-label" for="Lname">Last name</label>
                            <input type="text" name="Lname" value="<%= Lname %>" class="form-control form-control-lg" />
                          </div>
                        </div>
                      </div>
                    <div class="d-md-flex justify-content-start align-items-center mb-4 py-2">
      
                      <h6 class="mb-0 me-4">User Type: </h6>
    
                      <div class="form-check form-check-inline mb-0 me-4">
                        <input class="form-check-input" type="radio" name="userType" value="Admin" />
                        <label class="form-check-label" for="userType">Admin</label>
                      </div>
    
                      <div class="form-check form-check-inline mb-0 me-4">
                        <input class="form-check-input" type="radio" name="userType" value="Teacher" />
                        <label class="form-check-label" for="userType">Teacher</label>
                      </div>
    
                    </div>
      
                      <div class="d-flex justify-content-end pt-3">
                        <button type="submit" class="btn btn-warning btn-md ms-2">Submit</button>
                      </div>
      
                    </div>
                  
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    </form>
</body>
</html>