            <!-- =================================================
                 RESULTS
            ================================================== -->

            <!-- =================================================
     RESULTS
================================================== -->

<section
    id="section-results"
    class="dashboard-section">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                RESULTS
            </span>

            <h1>
                Pupil Results
            </h1>

            <p>
                Search and review pupil academic results.
            </p>

        </div>

    </div>


    <div class="content-card mb-4">

        <div class="result-search">

            <div class="search-box result-search-box">

                <i class="bi bi-search"></i>

                <input
                    type="search"
                    id="pupilSearch"
                    class="form-control"
                    placeholder="Search by exam number or pupil name...">

            </div>

            <select
                id="resultClassFilter"
                class="form-select filter-control">

                <option value="">
                    All Classes
                </option>

                <% if (typeof stats.allocations !== 'undefined') { %>

                    <% 
                        // Create a Set to track unique class+level combinations
                        const uniqueClasses = new Set();
                        stats.allocations.forEach(item => {
                            const key = `${item.levelname}-${item.class}`;
                            if (!uniqueClasses.has(key)) {
                                uniqueClasses.add(key);
                    %>
                                <option
                                    value="<%= item.classid %>"
                                    data-levelname="<%= item.levelname %>"
                                    data-classname="<%= item.class %>">

                                    <%= item.levelname %>
                                    <%= item.class %>

                                </option>
                    <%
                            }
                        });
                    %>

                <% } %>

            </select>

            <select
                id="resultSubjectFilter"
                class="form-select filter-control">

                <option value="">
                    All Subjects
                </option>

                <% if (typeof stats.allocations !== 'undefined') { %>

                    <% 
                        // Create a Set to track unique subjects
                        const uniqueSubjects = new Set();
                        stats.allocations.forEach(item => {
                            const key = item.subjectname;
                            if (!uniqueSubjects.has(key)) {
                                uniqueSubjects.add(key);
                    %>
                                <option
                                    value="<%= item.subjectcode %>"
                                    data-subjectname="<%= item.subjectname %>">

                                    <%= item.subjectname %>

                                </option>
                    <%
                            }
                        });
                    %>

                <% } %>

            </select>

            <select
                id="resultTermFilter"
                class="form-select filter-control">

                <option value="">
                    Select Term
                </option>

                <% if (typeof stats.allocations !== 'undefined' && stats.allocations.length) { %>

                    <% 
                        // Create a Set to track unique terms
                        const uniqueTerms = new Set();
                        stats.allocations.forEach(a => {
                            const key = `${a.termid}-${a.termname}`;
                            if (!uniqueTerms.has(key)) {
                                uniqueTerms.add(key);
                    %>
                                <option value="<%= a.termid %>">
                                    <%= a.termname %>
                                </option>
                    <%
                            }
                        });
                    %>

                <% } %>

            </select>

            <button
                class="btn btn-primary"
                id="resultSearchBtn">

                <i class="bi bi-search me-1"></i>

                Search

            </button>

            <button
                class="btn btn-outline-secondary"
                id="resultClearBtn">

                <i class="bi bi-x-circle me-1"></i>

                Clear

            </button>

        </div>

    </div>


    <div class="content-card">

        <div class="card-header-custom">

            <div>

                <div class="d-flex align-items-center gap-2 mb-1">

                    <h3>
                        Results
                    </h3>

                    <span
                        id="resultCount"
                        class="badge bg-light text-dark">

                        0 results

                    </span>

                </div>

                <p id="resultSubtitle">
                    Search results will appear here.
                </p>

            </div>

            <div id="resultActions" class="d-none">

                <button
                    class="btn btn-sm btn-outline-secondary"
                    id="exportResultsBtn">

                    <i class="bi bi-download"></i>

                    Export

                </button>

            </div>

        </div>


        <!-- Loading State -->
        <div
            id="resultsLoading"
            class="marks-loading d-none">

            <div class="spinner-border text-primary"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

            <span>
                Searching for results...
            </span>

        </div>


        <!-- Results Container -->
        <div id="resultsContainer">

            <div class="empty-large">

                <i class="bi bi-search"></i>

                <h4>
                    Search for a pupil
                </h4>

                <p>
                    Enter an exam number or pupil name above,
                    or use the filters to narrow your search.
                </p>

            </div>

        </div>

    </div>

</section>


