<!DOCTYPE html>
<html lang="en"> 
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Teacher Dashboard | School Management System</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet"
          href="/styles/teacher-dashboard.css">
</head>

<body>

<div class="teacher-app">

    <!-- =========================================================
         MOBILE OVERLAY
    ========================================================== -->

    <div id="sidebarOverlay"
         class="sidebar-overlay"></div>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside id="teacherSidebar"
           class="teacher-sidebar">

        <div class="sidebar-header">

            <div class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="brand-text">
                <strong>MBSS SMS</strong>
                <small>Teacher Portal</small>
            </div>

            <button
                type="button"
                id="sidebarClose"
                class="sidebar-close d-lg-none">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <!-- Teacher Profile -->

        <div class="teacher-mini-profile">

            <div class="teacher-avatar">

                <% if (typeof teacher !== 'undefined' && teacher.profilePicture) { %>

                    <img
                        src="/images/profile/<%= teacher.profilePicture %>"
                        alt="Teacher">

                <% } else { %>

                    <span>
                        <%= typeof teacher !== 'undefined'
                            ? (teacher.fname?.charAt(0) || 'T')
                            : 'T' %>
                    </span>

                <% } %>

            </div>

            <div class="teacher-mini-info">

                <strong>
                    <%= typeof teacher !== 'undefined'
                        ? `${teacher.fname || ''} ${teacher.lname || ''}`
                        : '' %>
                </strong>

                <span>
                    Teacher
                </span>

            </div>

        </div>


        <!-- Navigation -->

        <nav class="sidebar-navigation">

            <div class="nav-label">
                MAIN
            </div>

            <a href="#dashboard"
               class="sidebar-link active"
               data-section="dashboard">

                <i class="bi bi-grid-1x2-fill"></i>

                <span>Dashboard</span>

            </a>


            <div class="nav-label">
                ACADEMIC
            </div>

            <a href="#classes"
               class="sidebar-link"
               data-section="classes">

                <i class="bi bi-easel2-fill"></i>

                <span>My Classes</span>

            </a>

            <a href="#allocations"
               class="sidebar-link"
               data-section="allocations">

                <i class="bi bi-diagram-3-fill"></i>

                <span>My Allocations</span>

            </a>

            <a href="#marks"
               class="sidebar-link"
               data-section="marks">

                <i class="bi bi-pencil-square"></i>

                <span>Marks Schedule</span>

            </a>

            <a href="#results"
               class="sidebar-link"
               data-section="results">

                <i class="bi bi-bar-chart-fill"></i>

                <span>Pupil Results</span>

            </a>

            <a href="#progress"
               class="sidebar-link"
               data-section="progress">

                <i class="bi bi-graph-up-arrow"></i>

                <span>Progress Analysis</span>

            </a>


            <div class="nav-label">
                REPORTS
            </div>

            <a href="#midterm"
               class="sidebar-link"
               data-section="midterm">

                <i class="bi bi-file-earmark-text-fill"></i>

                <span>Mid-Term Reports</span>

            </a>

            <a href="#termreports"
               class="sidebar-link"
               data-section="termreports">

                <i class="bi bi-file-earmark-bar-graph-fill"></i>

                <span>Termly Reports</span>

            </a>

            <a href="#annualreports"
               class="sidebar-link"
               data-section="annualreports">

                <i class="bi bi-award-fill"></i>

                <span>End-of-Year Reports</span>

            </a>

            <a href="#history"
               class="sidebar-link"
               data-section="history">

                <i class="bi bi-clock-history"></i>

                <span>Report History</span>

            </a>


            <div class="nav-label">
                ACCOUNT
            </div>

            <a href="#profile"
               class="sidebar-link"
               data-section="profile">

                <i class="bi bi-person-circle"></i>

                <span>My Profile</span>

            </a>

        </nav>


        <div class="sidebar-footer">

            <a href="/logout"
               class="logout-link">

                <i class="bi bi-box-arrow-right"></i>

                <span>Sign Out</span>

            </a>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

    <main class="teacher-main">

        <!-- =====================================================
             TOPBAR
        ====================================================== -->

        <header class="teacher-topbar">

            <div class="topbar-left">

                <button
                    id="sidebarToggle"
                    class="sidebar-toggle">

                    <i class="bi bi-list"></i>

                </button>

                <div>

                    <h5 id="pageTitle">
                        Teacher Dashboard
                    </h5>

                    <small id="pageSubtitle">
                        Academic overview and teaching activities
                    </small>

                </div>

            </div>


            <div class="topbar-right">

                <!-- Academic Year -->

                <div class="academic-context">

                    <i class="bi bi-calendar3"></i>

                    <span>
                        <%= typeof currentYear !== 'undefined'
                            ? currentYear.yearname
                            : '2026 Academic Year' %>
                    </span>

                </div>


                <!-- Notification -->

                <button
                    class="top-icon-button"
                    title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-dot"></span>

                </button>


                <!-- User -->

                <div class="top-user">

                    <div class="top-avatar">

                        <%= typeof teacher !== 'undefined'
                            ? (teacher.fname?.charAt(0) || 'T')
                            : 'T' %>

                    </div>

                    <div class="top-user-info">

                        <strong>
                            <%= typeof teacher !== 'undefined'
                                ? `${teacher.fname || ''} ${teacher.lname || ''}`
                                : 'Teacher' %>
                        </strong>

                        <span>
                            Teacher
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- =====================================================
             PAGE CONTENT
        ====================================================== -->

        <div class="page-content">


            <!-- =================================================
                 DASHBOARD
            ================================================== -->

            <section
                id="section-dashboard"
                class="dashboard-section active-section">

                <div class="page-heading">

                    <div>

                        <span class="eyebrow">
                            OVERVIEW
                        </span>

                        <h1>
                            Good morning,
                            <%= typeof teacher !== 'undefined'
                                ? teacher.fname
                                : 'Teacher' %>
                        </h1>

                        <p>
                            Here's what's happening with your classes
                            and academic activities.
                        </p>

                    </div>

                    <div class="heading-date">

                        <i class="bi bi-calendar-event"></i>

                        <span id="currentDate"></span>

                    </div>

                </div>


                <!-- Statistics -->

                <div class="row g-4 mb-4">

                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-icon icon-blue">
                                <i class="bi bi-easel2-fill"></i>
                            </div>

                            <div class="stat-content">

                                <span>My Classes</span>

                                <strong>
                                    <%= typeof statistics !== 'undefined'
                                        ? statistics.classes || 0
                                        : 8 %>
                                </strong>

                                <small>
                                    Active classes
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-icon icon-purple">
                                <i class="bi bi-book-fill"></i>
                            </div>

                            <div class="stat-content">

                                <span>Subjects</span>

                                <strong>
                                    <%= typeof statistics !== 'undefined'
                                        ? statistics.subjects || 0
                                        : 4 %>
                                </strong>

                                <small>
                                    Currently teaching
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-icon icon-green">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <div class="stat-content">

                                <span>Total Pupils</span>

                                <strong>
                                    <%= typeof statistics !== 'undefined'
                                        ? statistics.pupils || 0
                                        : 248 %>
                                </strong>

                                <small>
                                    Across your classes
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-icon icon-orange">
                                <i class="bi bi-check2-circle"></i>
                            </div>

                            <div class="stat-content">

                                <span>Marks Completed</span>

                                <strong>
                                    <%= typeof statistics !== 'undefined'
                                        ? statistics.marksCompleted || 0
                                        : 78 %>%
                                </strong>

                                <small>
                                    This term
                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Dashboard Grid -->

                <div class="row g-4">

                    <!-- Teaching Allocation -->

                    <div class="col-xl-8">

                        <div class="content-card">

                            <div class="card-header-custom">

                                <div>

                                    <h3>
                                        My Teaching Allocations
                                    </h3>

                                    <p>
                                        Classes and subjects assigned to you
                                    </p>

                                </div>

                                <button
                                    class="btn btn-sm btn-light"
                                    data-section-target="allocations">

                                    View All
                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </div>


                            <div class="table-responsive">

                                <table class="table professional-table">

                                    <thead>

                                    <tr>

                                        <th>CLASS</th>
                                        <th>SUBJECT</th>
                                        <th>LEVEL</th>
                                        <th>TERM</th>
                                        <th>STATUS</th>

                                    </tr>

                                    </thead>

                                    <tbody>

                                    <% if (typeof allocations !== 'undefined' && allocations.length) { %>

                                        <% allocations.slice(0,5).forEach(item => { %>

                                            <tr>

                                                <td>
                                                    <strong>
                                                        <%= item.class %>
                                                    </strong>
                                                </td>

                                                <td>
                                                    <%= item.subjectname %>
                                                </td>

                                                <td>
                                                    <%= item.levelname %>
                                                </td>

                                                <td>
                                                    <%= item.termname %>
                                                </td>

                                                <td>

                                                    <span class="status-badge success">
                                                        Allocated
                                                    </span>

                                                </td>

                                            </tr>

                                        <% }) %>

                                    <% } else { %>

                                        <tr>

                                            <td colspan="5"
                                                class="empty-state">

                                                <i class="bi bi-inbox"></i>

                                                <span>
                                                    No teaching allocations found.
                                                </span>

                                            </td>

                                        </tr>

                                    <% } %>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>


                    <!-- Quick Actions -->

                    <div class="col-xl-4">

                        <div class="content-card">

                            <div class="card-header-custom">

                                <div>

                                    <h3>
                                        Quick Actions
                                    </h3>

                                    <p>
                                        Common academic tasks
                                    </p>

                                </div>

                            </div>


                            <div class="quick-actions">

                                <button
                                    class="quick-action"
                                    data-section-target="marks">

                                    <span class="quick-icon blue">
                                        <i class="bi bi-pencil-square"></i>
                                    </span>

                                    <span>
                                        <strong>Enter Marks</strong>
                                        <small>Record pupil marks</small>
                                    </span>

                                    <i class="bi bi-chevron-right"></i>

                                </button>


                                <button
                                    class="quick-action"
                                    data-section-target="results">

                                    <span class="quick-icon purple">
                                        <i class="bi bi-search"></i>
                                    </span>

                                    <span>
                                        <strong>Search Results</strong>
                                        <small>Find pupil results</small>
                                    </span>

                                    <i class="bi bi-chevron-right"></i>

                                </button>


                                <button
                                    class="quick-action"
                                    data-section-target="progress">

                                    <span class="quick-icon green">
                                        <i class="bi bi-graph-up"></i>
                                    </span>

                                    <span>
                                        <strong>View Progress</strong>
                                        <small>Analyse performance</small>
                                    </span>

                                    <i class="bi bi-chevron-right"></i>

                                </button>


                                <button
                                    class="quick-action"
                                    data-section-target="termreports">

                                    <span class="quick-icon orange">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </span>

                                    <span>
                                        <strong>Generate Report</strong>
                                        <small>Create academic report</small>
                                    </span>

                                    <i class="bi bi-chevron-right"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Performance -->

                <div class="row g-4 mt-1">

                    <div class="col-xl-8">

                        <div class="content-card">

                            <div class="card-header-custom">

                                <div>

                                    <h3>
                                        Class Performance
                                    </h3>

                                    <p>
                                        Average performance across your subjects
                                    </p>

                                </div>

                                <select
                                    id="performanceTerm"
                                    class="form-select form-select-sm filter-select">
                                <% if (typeof stats.allocations !== 'undefined') { %>

                                    <% stats.allocations.forEach(item => { %>

                                        <option
                                            value="<%= item.class_subject_id %>"
                                            data-classid="<%= item.classid %>"
                                            data-subjectcode="<%= item.subjectcode %>"
                                            data-levelname="<%= item.levelname %>"
                                            data-classname="<%= item.class %>"
                                            data-subjectname="<%= item.subjectname %>">

                                            <%= item.levelname %>
                                            <%= item.class %>
                                            -
                                            <%= item.subjectname %>

                                        </option>

                                    <% }) %>

                                <% } %>

                                </select>

                            </div>

                            <div class="chart-container">

                                <canvas id="performanceChart"></canvas>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-4">

                        <div class="content-card">

                            <div class="card-header-custom">

                                <div>

                                    <h3>
                                        Marks Progress
                                    </h3>

                                    <p>
                                        Current term
                                    </p>

                                </div>

                            </div>

                            <div class="progress-summary">

                                <div class="progress-circle">

                                    <div>
                                        <strong>78%</strong>
                                        <span>Completed</span>
                                    </div>

                                </div>

                                <div class="progress-legend">

                                    <div>
                                        <span class="legend-dot completed"></span>
                                        Completed
                                        <strong>78%</strong>
                                    </div>

                                    <div>
                                        <span class="legend-dot pending"></span>
                                        Pending
                                        <strong>22%</strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 MY CLASSES
            ================================================== -->

            <section
                id="section-classes"
                class="dashboard-section">

                <div class="page-heading">

                    <div>

                        <span class="eyebrow">
                            ACADEMIC
                        </span>

                        <h1>
                            My Classes
                        </h1>

                        <p>
                            Classes assigned to you for the current academic year.
                        </p>

                    </div>

                </div>


                <div class="content-card">

                    <div class="filter-bar">

                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input
                                type="search"
                                id="classSearch"
                                class="form-control"
                                placeholder="Search class...">

                        </div>

                        <select
                            id="classLevelFilter"
                            class="form-select filter-control">

                            <option value="">All Levels</option>

                            <% if (typeof stats.allocations !== 'undefined' && stats.allocations.length) { %>
                                    <% stats.allocations.forEach(a => { %>

                                    <option value="<%= a.levelname %>">
                                        <%= a.levelname %><%= a.class %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="row g-4"
                         id="classesGrid">

                        <% if (typeof stats.allocations !== 'undefined' && stats.allocations.length) { %>

                            <% stats.allocations.forEach(item => { %>

                                <div class="col-xl-4 col-md-6 class-item">

                                    <div class="class-card">

                                        <div class="class-card-top">

                                            <div class="class-icon">
                                                <i class="bi bi-easel2-fill"></i>
                                            </div>

                                            <span class="status-badge success">
                                                Active
                                            </span>

                                        </div>

                                        <h3>
                                            <%= item.class %>
                                        </h3>

                                        <p>
                                            <%= item.levelname %>
                                        </p>

                                        <div class="class-details">

                                            <span>
                                                <i class="bi bi-book"></i>

                                                <%= item.subjectname %>
                                            </span>

                                            <span>
                                                <i class="bi bi-calendar3"></i>

                                                <%= item.termname %>
                                            </span>

                                        </div>

                                        <div class="class-card-actions">

                                            <button
                                                class="btn btn-primary btn-sm">

                                                View Pupils

                                            </button>

                                            <button
                                                class="btn btn-outline-secondary btn-sm">

                                                Results

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <div class="col-12">

                                <div class="empty-large">

                                    <i class="bi bi-easel"></i>

                                    <h4>
                                        No classes assigned
                                    </h4>

                                    <p>
                                        Your teaching allocations will appear here.
                                    </p>

                                </div>

                            </div>

                        <% } %>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 ALLOCATIONS
            ================================================== -->

            <section
                id="section-allocations"
                class="dashboard-section">

                <div class="page-heading">

                    <div>

                        <span class="eyebrow">
                            ACADEMIC
                        </span>

                        <h1>
                            My Teaching Allocations
                        </h1>

                        <p>
                            Every class and subject assigned to you.
                        </p>

                    </div>

                </div>


                <div class="content-card">

                    <div class="filter-bar">

                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input
                                id="allocationSearch"
                                class="form-control"
                                placeholder="Search class or subject...">

                        </div>

                        <select class="form-select filter-control">

                            <option>Current Term</option>
                            <% if (typeof stats.allocations !== 'undefined' && stats.allocations.length) { %>
                                <% stats.allocations.forEach(a => { %>
                                    <!-- must fix to avoid multiple same terms being displayed -->
                                    <option value="<%= a.termid %>">
                                        <%= a.termname %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="table-responsive">

                        <table
                            class="table professional-table"
                            id="allocationTable">

                            <thead>

                            <tr>

                                <th>#</th>
                                <th>CLASS</th>
                                <th>LEVEL</th>
                                <th>SUBJECT</th>
                                <th>SUBJECT CODE</th>
                                <th>TERM</th>
                                <th>STATUS</th>
                                <th>ACTIONS</th>

                            </tr>

                            </thead>

                            <tbody>

                            <% if (typeof stats.allocations !== 'undefined') { %>

                                <% stats.allocations.forEach((item,index) => { %>

                                    <tr>

                                        <td>
                                            <%= index + 1 %>
                                        </td>

                                        <td>
                                            <strong>
                                                <%= item.class %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= item.levelname %>
                                        </td>

                                        <td>
                                            <%= item.subjectname %>
                                        </td>

                                        <td>
                                            <span class="code-badge">
                                                <%= item.subjectcode %>
                                            </span>
                                        </td>

                                        <td>
                                            <%= item.termname %>
                                        </td>

                                        <td>

                                            <span class="status-badge success">
                                                Allocated
                                            </span>

                                        </td>

                                        <td>

                                            <div class="table-actions">

                                                <button
                                                    class="btn btn-sm btn-light"
                                                    title="Enter marks">

                                                    <i class="bi bi-pencil-square"></i>

                                                </button>

                                                <button
                                                    class="btn btn-sm btn-light"
                                                    title="View pupils">

                                                    <i class="bi bi-people"></i>

                                                </button>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 MARKS
            ================================================== -->
<!-- =================================================
     MARKS
================================================== -->

<section
    id="section-marks"
    class="dashboard-section">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                ASSESSMENT
            </span>

            <h1>
                Marks Schedule
            </h1>

            <p>
                Manage and submit marks for your allocated classes.
            </p>

        </div>

    </div>


    <div class="content-card mb-4">

        <div class="filter-bar marks-filter">

            <div class="filter-field">

                <label for="marksClass">
                    Class &amp; Subject
                </label>

                <select
                    id="marksClass"
                    class="form-select">

                    <option value="">
                        Select class &amp; subject
                    </option>

                    <% if (typeof stats.allocations !== 'undefined') { %>

                        <% stats.allocations.forEach(item => { %>

                            <option
                                value="<%= item.class_subject_id %>"
                                data-classid="<%= item.classid %>"
                                data-subjectcode="<%= item.subjectcode %>"
                                data-levelname="<%= item.levelname %>"
                                data-classname="<%= item.class %>"
                                data-subjectname="<%= item.subjectname %>">

                                <%= item.levelname %>
                                <%= item.class %>
                                -
                                <%= item.subjectname %>

                            </option>

                        <% }) %>

                    <% } %>

                </select>

                <small class="text-muted">
                    Select one of your allocated class subjects.
                </small>

            </div>


            <div class="filter-field">

                <label for="marksExamType">
                    Assessment
                </label>

                <select
                    id="marksExamType"
                    name="examType"
                    class="form-select">

                    <option value="">
                        Select assessment
                    </option>

                     <% if (typeof stats.examtype !== 'undefined') { %>

                        <% stats.examtype.forEach(item => { %>

                            <option
                                value="<%= item.examid %>">
                                <%= item.exam_title %>
                            </option>

                        <% }) %>

                    <% } %>

                </select>

            </div>


            <div class="filter-action">

                <button
                    type="button"
                    id="loadMarksBtn"
                    class="btn btn-primary marks-load-btn">

                    <i class="bi bi-arrow-repeat me-1"></i>

                    Load Marks

                </button>

            </div>

        </div>

    </div>


    <div class="content-card">

        <div class="card-header-custom">

            <div>

                <div class="d-flex align-items-center gap-2 mb-1">

                    <h3 id="marksScheduleTitle">
                        Marks Schedule
                    </h3>

                    <span
                        id="marksStudentCount"
                        class="badge bg-light text-dark">

                        0 pupils

                    </span>

                </div>

                <p id="marksScheduleSubtitle">
                    Select a class and assessment to load pupils.
                </p>

            </div>


            <div>

                <span
