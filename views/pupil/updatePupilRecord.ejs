 <%- include("../partials/sidebar") %>
    <div class="container">
        <form id="editStudentForm">
            <!---Personal details section-->
            <h4>Personal Details</h4>
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                  <input type="number" class="form-control form-control-md" name="examno" aria-label="Exam No" id="examno" value="<%= studentData[0].id %>" readonly required>
                  <span id="check-examno"></span>
                </div>
                <div class="col-sm-4">
                    <% if(locals.foundClass){ %>
                            <select class="select form-control" name="classid" id="selectedClass" aria-label="Grade" required>
                              <option selected readonly="" value="<%= studentData[0].classid %>" ><%= studentData[0].grade %><%= studentData[0].class %></option>       
                                <% foundClass.forEach(element => { %>
                                  <option value="<%= element.classid %>"  
                                    data-grade="<%= element.grade %>">
                                      <%= element.grade %><%= element.class %>
                                  </option>  
                                <% }); %>
                              </select>
                            <% } %>
                    <input type="number" name="yearlevel" value="<%= studentData[0].grade %>" id="yearlevel" hidden readonly/>     
                  </div>    
              </div>
              <div class="row g-3 mb-4">
                <div class="col-sm-4">
                  <input type="text" class="form-control" name="fname" value="<%= studentData[0].fname %>" aria-label="First name" required>
                </div>
                <div class="col-sm-4">
                  <input type="text" class="form-control" name="lname" value="<%= studentData[0].lname %>" aria-label="Last name" required>
                </div>
                <div class="col-sm-4">
                    <select class="select form-control" name="gender" aria-label="gender" required>
                        <option selected readonly value="<%= studentData[0].gender %>" ><%= studentData[0].gender %></option>
                        <option value="male">Male</option>   
                        <option value="female">Female</option>    
                        <option value="other">Other</option>                    
                  </select>
                </div>
              </div>
              <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <% if(locals.studentstatus){ %>
                            <select class="select form-control" name="studentstatus" aria-label="student status" required>
                                <option value="<%= studentData[0].studentStatusID %>" selected readonly  ><%= studentData[0].studentStatus %></option>
                                <% studentstatus.forEach(element => { %>
                                  <option value=<%= element.studentStatusID %>><%= element.studentStatus %></option>                              
                                <% }); %>
                              </select>
                     <% } %>
                </div>
                <div class="col-sm-4">
                    <% if(locals.sponsor){ %>
                            <select class="select form-control" name="sponsor" aria-label="sponsored by" required>
                                <option selected readonly value="<%= studentData[0].sponsorID %>" ><%= studentData[0].sponsorName %></option>
                                <% sponsor.forEach(element => { %>
                                  <option value=<%= element.sponsorID %>><%= element.sponsorName %></option>                              
                                <% }); %>
                              </select>
                     <% } %>
                </div>
                <div class="col-sm-4">
                    <% if(locals.ovcstatus){ %>
                            <select class="select form-control" name="ovcstatus" aria-label="ovc status" required>
                                <option selected readonly value="<%= studentData[0].ovcstatusid %>" ><%= studentData[0].ovcstatus %></option>
                                <% ovcstatus.forEach(element => { %>
                                  <option value=<%= element.ovcstatusid %>><%= element.ovcstatus %></option>                              
                                <% }); %>
                              </select>
                     <% } %>
                </div>
              </div>    
              <!-- Parent/Guardian Details -->
              <div class="row my-4">
                <h4>Parent/Guardian Details</h4>
              </div>
              <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <input type="number" class="form-control" name="nrcno" value="<%= studentData[0].nrc_no %>" minlength="9" aria-label="Parent NRC No." required>
                    <!-- <small style="color: red;">NRC cannot be edited </small> -->
                </div>
                <div class="col-sm-4">
                    <input type="text" class="form-control" name="guardianFname"  value="<%= studentData[0].guardianFname %>" aria-label="Parent First Name" required>
                </div>
                <div class="col-sm-4">
                    <input type="text" class="form-control" name="guardianLname" value="<%= studentData[0].guardianLname %>" aria-label="Parent Last Name" required>
                </div>
              </div>
              <div class="row g-3 mb-4">
                <div class="col-sm-4">                           
                   <input type="tel" class="form-control" name="phoneNumber" id="phoneNumber" value="0<%= studentData[0].phonenumber %>" minlength="9" aria-label=" Phone Number" required>
                </div>
                <div class="col-sm-4">
                    <% if(locals.guardiantype){ %>
                        <select class="select form-control" name="relationship" aria-label="Relationship" required>
                            <option selected value="<%= studentData[0].guardiantypeid %>" ><%= studentData[0].guardiantypename %></option>
                            <% guardiantype.forEach(element => { %>
                              <option value=<%= element.guardiantypeid %>><%= element.relationship %></option>                              
                            <% }); %>
                          </select>
                            <% } %>
                </div>
              </div>
              <button type="button" id="editStudentInfoBtn">Submit</button>
        </form>
    </div>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <!-- <script src="/scripts/scripts.js"></script>    -->
        <script src="/scripts/adminScripts.js"></script>
        <script src="/scripts/studentAdmission.js"></script> 
        <!-- <script src="/scripts/editStudentDetails.js"></script>     -->
    </body>
    </html>
    
                    