<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Students | School Management System</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/styles/students.css"
    >
</head>

<body>

<div class="app-shell">

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar">

        <div class="sidebar-brand">

            <div class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <strong>SchoolMS</strong>
                <small>Administration</small>
            </div>

        </div>


        <nav class="sidebar-nav">

            <div class="nav-section">
                MAIN
            </div>

            <a href="/dashboard" class="nav-link">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>


            <div class="nav-section">
                STUDENTS
            </div>

            <a href="/viewPupils" class="nav-link active">
                <i class="bi bi-people"></i>
                <span>Students</span>
            </a>

            <a href="/register" class="nav-link">
                <i class="bi bi-person-plus"></i>
                <span>New Student</span>
            </a>

            <a href="/register" class="nav-link">
                <i class="bi bi-arrow-repeat"></i>
                <span>Returning Student</span>
            </a>

            <a href="#" class="nav-link">
                <i class="bi bi-arrow-up-circle"></i>
                <span>Promotion</span>
            </a>


            <div class="nav-section">
                ACADEMICS
            </div>

            <a href="/classes" class="nav-link">
                <i class="bi bi-building"></i>
                <span>Classes</span>
            </a>

            <a href="/subjects" class="nav-link">
                <i class="bi bi-book"></i>
                <span>Subjects</span>
            </a>

            <a href="/teachers" class="nav-link">
                <i class="bi bi-person-badge"></i>
                <span>Teachers</span>
            </a>


            <div class="nav-section">
                MANAGEMENT
            </div>

            <a href="/attendance" class="nav-link">
                <i class="bi bi-calendar-check"></i>
                <span>Attendance</span>
            </a>

            <a href="/reports" class="nav-link">
                <i class="bi bi-bar-chart"></i>
                <span>Reports</span>
            </a>

        </nav>


        <div class="sidebar-footer">

            <div class="admin-avatar">
                A
            </div>

            <div class="admin-info">
                <strong>Administrator</strong>
                <small><%= user.username %></small>
            </div>

            <button class="sidebar-more">
                <i class="bi bi-three-dots"></i>
            </button>

        </div>

    </aside>


    <!-- MAIN -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <button
                type="button"
                id="menuBtn"
                class="menu-btn"
            >
                <i class="bi bi-list"></i>
            </button>


            <div class="breadcrumb-area">

                <span class="breadcrumb-muted">
                    Administration
                </span>

                <i class="bi bi-chevron-right"></i>

                <strong>Students</strong>

            </div>


            <div class="topbar-actions">

                <button class="icon-btn">
                    <i class="bi bi-bell"></i>
                    <span class="notification-dot"></span>
                </button>

                <div class="topbar-user">
                    <div class="top-avatar">A</div>

                    <div>
                        <strong>Administrator</strong>
                        <small>Admin</small>
                    </div>

                    <i class="bi bi-chevron-down"></i>
                </div>

            </div>

        </header>


        <!-- PAGE -->
        <div class="page-container">

            <!-- PAGE HEADER -->
            <div class="page-header">

                <div>

                    <div class="eyebrow">
                        STUDENT MANAGEMENT
                    </div>

                    <h1>Students</h1>

                    <p>
                        Manage student records, enrollment and
                        academic history.
                    </p>

                </div>


                <div class="page-actions">

                    <a
                        href="/register"
                        class="btn btn-outline-primary"
                    >
                        <i class="bi bi-arrow-repeat"></i>
                        Returning Student
                    </a>

                    <a
                        href="/register"
                        class="btn btn-primary"
                    >
                        <i class="bi bi-person-plus"></i>
                        Register Student
                    </a>

                </div>

            </div>


            <!-- STATISTICS -->
            <div class="stats-grid">

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>

                        <span>Total Students</span>

                        <strong>
                            <%= typeof stats !== 'undefined'
                                ? stats.total
                                : 0 %>
                        </strong>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>

                        <span>Active</span>

                        <strong>
                            <%= typeof stats !== 'undefined'
                                ? stats.active
                                : 0 %>
                        </strong>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div>

                        <span>New This Year</span>

                        <strong>
                            <%= typeof stats !== 'undefined'
                                ? stats.newStudents
                                : 0 %>
                        </strong>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <div>

                        <span>Returning</span>

                        <strong>
                            <%= typeof stats !== 'undefined'
                                ? stats.returning
                                : 0 %>
                        </strong>

                    </div>

                </div>

            </div>


            <!-- STUDENT LIST CARD -->
            <section class="content-card">

                <!-- FILTER HEADER -->
                <div class="content-card-header">

                    <div>

                        <h2>Student Directory</h2>

                        <span>
                            Students enrolled in the selected
                            academic period
                        </span>

                    </div>

                    <button
                        type="button"
                        class="filter-toggle"
                        id="filterToggle"
                    >
                        <i class="bi bi-sliders"></i>
                        Filters
                    </button>

                </div>


                <!-- FILTERS -->
                <div
                    id="filterPanel"
                    class="filter-panel"
                >

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input
                            type="search"
                            id="studentSearch"
                            placeholder="Search by student name or examination number..."
                            autocomplete="off"
                        >

                    </div>


                    <div class="filter-select">

                        <label for="academicYear">
                            Academic Year
                        </label>

                        <select
                            id="academicYear"
                            class="form-select"
                        >

                            <option value="">
                                Select year
                            </option>

                            <% if (typeof schoolyear !== 'undefined') { %>

                                <% schoolyear.forEach(year => { %>

                                    <option
                                        value="<%= year.schoolyearid %>"
                                        <%= typeof currentYear !== 'undefined' &&
                                            String(currentYear) === String(year.schoolyearid)
                                            ? 'selected'
                                            : '' %>
                                    >
                                        <%= year.yearname %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="filter-select">

                        <label for="termSelect">
                            Term
                        </label>

                        <select
                            id="termSelect"
                            class="form-select"
                        >

                            <option value="">
                                Select term
                            </option>

                            <% if (typeof foundTerm !== 'undefined') { %>

                                <% foundTerm.forEach(term => { %>

                                    <option
                                        value="<%= term.termid %>"
                                        <%= typeof currentTerm !== 'undefined' &&
                                            String(currentTerm) === String(term.termid)
                                            ? 'selected'
                                            : '' %>
                                    >
                                        <%= term.termname %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="filter-select">

                        <label for="classFilter">
                            Class
                        </label>

                        <select
                            id="classFilter"
                            class="form-select"
                        >

                            <option value="">
                                All Classes
                            </option>

                            <% if (typeof foundClass !== 'undefined') { %>

                                <% foundClass.forEach(item => { %>

                                    <option value="<%= item.classid %>">
                                        <%= item.levelname %>
                                        <%= item.class %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="filter-select">

                        <label for="statusFilter">
                            Status
                        </label>

                        <select
                            id="statusFilter"
                            class="form-select"
                        >

                            <option value="active">
                                Active
                            </option>

                            <option value="">
                                All Statuses
                            </option>

                            <option value="graduated">
                                Graduated
                            </option>

                            <option value="transferred">
                                Transferred
                            </option>

                            <option value="withdrawn">
                                Withdrawn
                            </option>

                        </select>

                    </div>


                    <button
                        type="button"
                        id="resetFilters"
                        class="btn btn-light filter-reset"
                    >
                        Reset
                    </button>

                </div>


                <!-- TABLE -->
                <div class="table-wrapper">

                    <table class="students-table">

                        <thead>

                            <tr>

                                <th>STUDENT</th>

                                <th>EXAM NO.</th>

                                <th>RELIGION</th>

                                <th>ADDRESS</th>

                                <th>ENROLLMENT</th>

                                <th>STATUS</th>

                                <th class="text-end">
                                    ACTION
                                </th>

                            </tr>

                        </thead>


                        <tbody id="studentsTableBody">

                            <% if (typeof students !== 'undefined' &&
                                students.length) { %>

                                <% students.forEach(student => { %>

                                    <tr
                                        data-student-row
                                        data-name="<%= `${student.fname} ${student.middlename || ''} ${student.lname}`.toLowerCase() %>"
                                        data-examno="<%= student.examno %>"
                                        data-classid="<%= student.classid %>"
                                        data-status="<%= student.status %>"
                                    >

                                        <td>

                                            <div class="student-cell">

                                                <div class="student-avatar">

                                                    <% if (student.profilePicture) { %>

                                                        <img
                                                            src="/images/profile/<%= student.profilePicture %>"
                                                            alt="<%= student.fname %>"
                                                        >

                                                    <% } else { %>

                                                        <span>
                                                            <%= student.fname.charAt(0) %>
                                                        </span>

                                                    <% } %>

                                                </div>


                                                <div>

                                                    <strong>
                                                        <%= student.fname %>
                                                        <%= student.middlename || '' %>
                                                        <%= student.lname %>
                                                    </strong>

                                                    <small>
                                                        <%= student.gender
                                                            ? student.gender.charAt(0).toUpperCase() +
                                                              student.gender.slice(1)
                                                            : '' %>
                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <td>

                                            <span class="exam-number">
                                                <%= student.examno %>
                                            </span>

                                        </td>


                                        <td>

                                            <span class="level-text">
                                                <%= student.religion %>
                                            </span>

                                        </td>


                                        <td>

                                            <span class="class-badge">
                                                <%= student.address %>
                                            </span>

                                        </td>


                                        <td>

                                            <% if (student.enrollment_type === 'new') { %>

                                                <span class="enrollment-badge new">
                                                    New
                                                </span>

                                            <% } else if (student.enrollment_type === 'promoted') { %>

                                                <span class="enrollment-badge promoted">
                                                    Promoted
                                                </span>

                                            <% } else { %>

                                                <span class="enrollment-badge returning">
                                                    Returning
                                                </span>

                                            <% } %>

                                        </td>


                                        <td>

                                            <% if (student.status === 'active') { %>

                                                <span class="status-badge active">
                                                    <span></span>
                                                    Active
                                                </span>

                                            <% } else if (student.status === 'graduated') { %>

                                                <span class="status-badge graduated">
                                                    Graduated
                                                </span>

                                            <% } else if (student.status === 'transferred') { %>

                                                <span class="status-badge transferred">
                                                    Transferred
                                                </span>

                                            <% } else { %>

                                                <span class="status-badge withdrawn">
                                                    <%= student.status %>
                                                </span>

                                            <% } %>

                                        </td>


                                        <td class="text-end">

                                            <a
                                                href="/students/<%= student.examno %>"
                                                class="view-student-btn"
                                                title="View student"
                                            >
                                                <i class="bi bi-arrow-right"></i>
                                            </a>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr id="emptyStudents">

                                    <td
                                        colspan="7"
                                        class="empty-state"
                                    >

                                        <div>

                                            <i class="bi bi-people"></i>

                                            <h3>No students found</h3>

                                            <p>
                                                No students match the
                                                selected filters.
                                            </p>

                                            <a
                                                href="/students/register"
                                                class="btn btn-primary"
                                            >
                                                Register Student
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- FOOTER -->
                <div class="table-footer">

                    <span id="resultCount">
                        Showing students
                    </span>

                    <div class="pagination">

                        <button
                            type="button"
                            class="page-btn disabled"
                        >
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <button
                            type="button"
                            class="page-btn active"
                        >
                            1
                        </button>

                        <button
                            type="button"
                            class="page-btn"
                        >
                            2
                        </button>

                        <button
                            type="button"
                            class="page-btn"
                        >
                            3
                        </button>

                        <button
                            type="button"
                            class="page-btn"
                        >
                            <i class="bi bi-chevron-right"></i>
                        </button>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>


<script src="/scripts/students.js"></script>

</body>
</html>