<%- include("../partials/studentSideBar") %>
<title>Student ID Card</title>
<body>
    <div class="id-card-body">
        <% if(locals.results) { %>
            <div class="id-card" id="idCard">
                <!-- <div class="header" id="logo">
                    <img src="/images/cleanpic.jpg" alt="College Logo" class="college-logo">
                </div> -->
                <div class="header">
                    <h1>MINISTRY OF EDUCATION</h1>
                    <h2>Milenge Secondary School</h2>
                </div>
                <div class="photo">
                    <img src="/images/profile/<%= pupil.profilePicture %>" alt="Student Photo" class="student-photo">
                </div>
                <div class="student-info">
                    <h2><%= results.fname %> <%= results.lname %></h2>
                    <p>Examno: <%= results.id %></p>
                    <p>Grade: <%= results.grade %><%= results.class %></p>
                    <p>Year: <% const year = new Date().getFullYear() %> <%= year %></p>
                </div>
            </div>
        <%}%>
    </div>
    <div class="download-btn">
        <button onclick="downloadIDPDF()">Download as PDF</button>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    <script src="/scripts/adminScripts.js"></script>
    <script src="/scripts/profileCard.js"></script>
</body>
</html>
