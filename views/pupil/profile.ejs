<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        <%= student.fname %> <%= student.lname %> |
        Student Profile
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/styles/students.css"
    >

</head>

<body>

<div class="app-shell">

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar">

        <div class="sidebar-brand">

            <div class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <strong>SchoolMS</strong>
                <small>Administration</small>
            </div>

        </div>


        <nav class="sidebar-nav">

            <div class="nav-section">
                MAIN
            </div>

            <a href="/dashboard" class="nav-link">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>


            <div class="nav-section">
                STUDENTS
            </div>

            <a href="/viewPupils" class="nav-link active">
                <i class="bi bi-people"></i>
                <span>Students</span>
            </a>

            <a href="/register" class="nav-link">
                <i class="bi bi-person-plus"></i>
                <span>New Student</span>
            </a>

            <a href="/register" class="nav-link">
                <i class="bi bi-arrow-repeat"></i>
                <span>Returning Student</span>
            </a>

            <a href="#" class="nav-link">
                <i class="bi bi-arrow-up-circle"></i>
                <span>Promotion</span>
            </a>

        </nav>


        <div class="sidebar-footer">

            <div class="admin-avatar">
                A
            </div>

            <div class="admin-info">
                <strong>Administrator</strong>
                <small><%= user.username %></small>
            </div>

        </div>

    </aside>


    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <button
                type="button"
                id="menuBtn"
                class="menu-btn"
            >
                <i class="bi bi-list"></i>
            </button>


            <div class="breadcrumb-area">

                <a href="/students">
                    Students
                </a>

                <i class="bi bi-chevron-right"></i>

                <strong>Student Profile</strong>

            </div>

        </header>


        <div class="page-container">

            <!-- BACK -->
            <a
                href="/viewPupils"
                class="back-link"
            >
                <i class="bi bi-arrow-left"></i>
                Back to Students
            </a>


            <!-- PROFILE HEADER -->
            <section class="profile-header-card">

                <div class="profile-main">

                    <div class="large-profile-avatar">

                        <% if (student.profilePicture) { %>

                            <img
                                src="/uploads/students/<%= student.profilePicture %>"
                                alt="<%= student.fname %>"
                            >

                        <% } else { %>

                            <span>
                                <%= student.fname.charAt(0) %>
                            </span>

                        <% } %>

                    </div>


                    <div class="profile-identity">

                        <div class="profile-name-row">

                            <h1>
                                <%= student.fname %>
                                <%= student.middlename || '' %>
                                <%= student.lname %>
                            </h1>


                            <% if (student.status === 'active') { %>

                                <span class="status-badge active">
                                    <span></span>
                                    Active
                                </span>

                            <% } else { %>

                                <span class="status-badge withdrawn">
                                    <%= student.status %>
                                </span>

                            <% } %>

                        </div>


                        <div class="profile-meta">

                            <span>
                                <i class="bi bi-card-text"></i>
                                Exam No: <strong><%= student.examno %></strong>
                            </span>

                            <% if (currentEnrollment) { %>

                                <span>
                                    <i class="bi bi-building"></i>

                                    <strong>
                                        <%= currentEnrollment.levelname %>
                                        <%= currentEnrollment.class %>
                                    </strong>
                                </span>

                            <% } %>

                            <span>
                                <i class="bi bi-calendar3"></i>
                                Student since
                                <strong>
                                    <%= student.enrollmentdate
                                        ? new Date(student.enrollmentdate)
                                            .toLocaleDateString()
                                        : '-' %>
                                </strong>
                            </span>

                        </div>

                    </div>

                </div>


                <div class="profile-actions">

                    <a
                        href="/students/<%= student.examno %>/edit"
                        class="btn btn-outline-primary"
                    >
                        <i class="bi bi-pencil"></i>
                        Edit Student
                    </a>

                    <div class="dropdown">

                        <button
                            class="btn btn-light"
                            data-bs-toggle="dropdown"
                        >
                            <i class="bi bi-three-dots"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/students/<%= student.examno %>/history"
                                >
                                    <i class="bi bi-clock-history"></i>
                                    Academic History
                                </a>
                            </li>

                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/students/returning?examno=<%= student.examno %>"
                                >
                                    <i class="bi bi-arrow-repeat"></i>
                                    Enroll for New Term
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <button
                                    class="dropdown-item text-danger"
                                    id="printProfile"
                                >
                                    <i class="bi bi-printer"></i>
                                    Print Profile
                                </button>
                            </li>

                        </ul>

                    </div>

                </div>

            </section>


            <!-- TABS -->
            <div class="profile-tabs">

                <button
                    class="profile-tab active"
                    data-tab="overview"
                >
                    <i class="bi bi-person"></i>
                    Overview
                </button>

                <button
                    class="profile-tab"
                    data-tab="history"
                >
                    <i class="bi bi-clock-history"></i>
                    Academic History
                </button>

                <button
                    class="profile-tab"
                    data-tab="guardian"
                >
                    <i class="bi bi-people"></i>
                    Guardian
                </button>

                <button
                    class="profile-tab"
                    data-tab="attendance"
                >
                    <i class="bi bi-calendar-check"></i>
                    Attendance
                </button>

                <button
                    class="profile-tab"
                    data-tab="subjects"
                >
                    <i class="bi bi-book"></i>
                    Subjects
                </button>

                <button
                    class="profile-tab"
                    data-tab="results"
                >
                    <i class="bi bi-bar-chart"></i>
                    Results
                </button>

            </div>


            <!-- OVERVIEW -->
            <section
                class="profile-tab-content active"
                id="tab-overview"
            >

                <div class="profile-grid">

                    <!-- PERSONAL -->
                    <div class="content-card">

                        <div class="content-card-header">

                            <div>

                                <h2>Personal Information</h2>

                                <span>
                                    Student's permanent profile
                                </span>

                            </div>

                            <i class="bi bi-person-vcard section-icon"></i>

                        </div>


                        <div class="information-grid">

                            <div class="information-item">
                                <span>First Name</span>
                                <strong><%= student.fname || '-' %></strong>
                            </div>

                            <div class="information-item">
                                <span>Other Name</span>
                                <strong><%= student.middlename || '-' %></strong>
                            </div>

                            <div class="information-item">
                                <span>Last Name</span>
                                <strong><%= student.lname || '-' %></strong>
                            </div>

                            <div class="information-item">
                                <span>Examination Number</span>
                                <strong><%= student.examno %></strong>
                            </div>

                            <div class="information-item">
                                <span>Date of Birth</span>
                                <strong>
                                    <%= student.dob
                                        ? new Date(student.dob)
                                            .toLocaleDateString()
                                        : '-' %>
                                </strong>
                            </div>

                            <div class="information-item">
                                <span>Gender</span>
                                <strong>
                                    <%= student.gender || '-' %>
                                </strong>
                            </div>

                            <div class="information-item">
                                <span>Phone</span>
                                <strong>
                                    <%= student.studentPhoneNumber || '-' %>
                                </strong>
                            </div>

                            <div class="information-item">
                                <span>Email</span>
                                <strong>
                                    <%= student.email || '-' %>
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- CURRENT ENROLLMENT -->
                    <div class="content-card">

                        <div class="content-card-header">

                            <div>

                                <h2>Current Enrollment</h2>

                                <span>
                                    Selected academic period
                                </span>

                            </div>

                            <i class="bi bi-mortarboard section-icon"></i>

                        </div>


                        <% if (currentEnrollment) { %>

                            <div class="current-enrollment-card">

                                <div class="enrollment-highlight">

                                    <span>CLASS</span>

                                    <strong>
                                        <%= currentEnrollment.levelname %>
                                        <%= currentEnrollment.class %>
                                    </strong>

                                </div>


                                <div class="enrollment-details">

                                    <div>
                                        <span>Academic Year</span>

                                        <strong>
                                            <%= currentEnrollment.yearname || '-' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Term</span>

                                        <strong>
                                            <%= currentEnrollment.termname || '-' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Year Level</span>

                                        <strong>
                                            <%= currentEnrollment.levelname || '-' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Enrollment</span>

                                        <strong class="capitalize">
                                            <%= currentEnrollment.enrollment_type || '-' %>
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <div class="reporting-status">

                                <div class="reporting-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div>

                                    <strong>
                                        Student Reported
                                    </strong>

                                    <span>
                                        <% if (currentEnrollment.enrollment_date) { %>

                                            Reported on
                                            <%= new Date(
                                                currentEnrollment.enrollment_date
                                            ).toLocaleString() %>

                                        <% } else { %>

                                            Reporting not recorded

                                        <% } %>
                                    </span>

                                </div>

                            </div>

                        <% } else { %>

                            <div class="empty-mini-state">

                                <i class="bi bi-exclamation-circle"></i>

                                <h3>No current enrollment</h3>

                                <p>
                                    This student has no enrollment
                                    for the selected academic period.
                                </p>

                                <a
                                    href="/students/returning?examno=<%= student.examno %>"
                                    class="btn btn-primary"
                                >
                                    Enroll Student
                                </a>

                            </div>

                        <% } %>

                    </div>


                    <!-- STATUS -->
                    <div class="content-card">

                        <div class="content-card-header">

                            <div>

                                <h2>Student Status</h2>

                                <span>
                                    Administrative information
                                </span>

                            </div>

                        </div>


                        <div class="information-list">

                            <div>
                                <span>Student Status</span>

                                <strong>
                                    <%= student.studentstatus || '-' %>
                                </strong>
                            </div>

                            <div>
                                <span>Sponsor</span>

                                <strong>
                                    <%= student.sponsor || 'None' %>
                                </strong>
                            </div>

                            <div>
                                <span>OVC Status</span>

                                <strong>
                                    <%= student.ovcstatus || '-' %>
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- GUARDIAN SUMMARY -->
                    <div class="content-card">

                        <div class="content-card-header">

                            <div>

                                <h2>Primary Guardian</h2>

                                <span>
                                    Parent / guardian information
                                </span>

                            </div>

                            <a
                                href="#guardian"
                                class="small-link"
                                data-open-tab="guardian"
                            >
                                View
                            </a>

                        </div>


                        <% if (guardian) { %>

                            <div class="guardian-summary">

                                <div class="guardian-avatar">
                                    <i class="bi bi-person"></i>
                                </div>

                                <div>

                                    <strong>
                                        <%= guardian.fname %>
                                        <%= guardian.lname %>
                                    </strong>

                                    <span>
                                        <%= guardian.relationship || 'Guardian' %>
                                    </span>

                                    <small>
                                        <i class="bi bi-telephone"></i>
                                        <%= guardian.phonenumber || '-' %>
                                    </small>

                                </div>

                            </div>

                        <% } else { %>

                            <div class="empty-mini-state compact">

                                <i class="bi bi-person-x"></i>

                                <p>
                                    No guardian linked.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </div>

            </section>


            <!-- ACADEMIC HISTORY -->
            <section
                class="profile-tab-content"
                id="tab-history"
            >

                <div class="content-card">

                    <div class="content-card-header">

                        <div>

                            <h2>Academic History</h2>

                            <span>
                                Complete enrollment history
                            </span>

                        </div>

                        <button
                            class="btn btn-outline-primary btn-sm"
                            id="printHistory"
                        >
                            <i class="bi bi-printer"></i>
                            Print
                        </button>

                    </div>


                    <div class="timeline">

                        <% if (academicHistory &&
                               academicHistory.length) { %>

                            <% academicHistory.forEach((record, index) => { %>

                                <div class="timeline-item">

                                    <div class="timeline-marker">

                                        <% if (index === 0) { %>
                                            <i class="bi bi-star-fill"></i>
                                        <% } else { %>
                                            <i class="bi bi-check-lg"></i>
                                        <% } %>

                                    </div>


                                    <div class="timeline-content">

                                        <div class="history-header">

                                            <div>

                                                <span class="history-year">
                                                    <%= record.yearname || record.yearid %>
                                                </span>

                                                <h3>
                                                    <%= record.levelname %>
                                                    <%= record.class %>
                                                </h3>

                                            </div>


                                            <span
                                                class="enrollment-badge
                                                <%= record.enrollment_type === 'new'
                                                    ? 'new'
                                                    : record.enrollment_type === 'promoted'
                                                        ? 'promoted'
                                                        : 'returning' %>"
                                            >
                                                <%= record.enrollment_type || 'Enrollment' %>
                                            </span>

                                        </div>


                                        <div class="history-meta">

                                            <span>
                                                <i class="bi bi-calendar3"></i>

                                                <%= record.termname || `Term ${record.termid}` %>
                                            </span>

                                            <% if (record.enrollment_date) { %>

                                                <span>
                                                    <i class="bi bi-clock"></i>

                                                    Enrolled
                                                    <%= new Date(
                                                        record.enrollment_date
                                                    ).toLocaleDateString() %>
                                                </span>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <div class="empty-state">

                                <i class="bi bi-clock-history"></i>

                                <h3>No academic history</h3>

                                <p>
                                    No enrollment records have been
                                    recorded for this student.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </div>

            </section>


            <!-- GUARDIAN -->
            <section
                class="profile-tab-content"
                id="tab-guardian"
            >

                <div class="content-card">

                    <div class="content-card-header">

                        <div>

                            <h2>Guardian Information</h2>

                            <span>
                                Parents and guardians linked
                                to this student
                            </span>

                        </div>

                    </div>


                    <div class="guardian-list">

                        <% if (guardians && guardians.length) { %>

                            <% guardians.forEach(item => { %>

                                <div class="guardian-card">

                                    <div class="guardian-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div class="guardian-information">

                                        <h3>
                                            <%= item.fname %>
                                            <%= item.lname %>
                                        </h3>

                                        <span>
                                            <%= item.relationship || '' %>
                                        </span>

                                        <div>

                                            <span>
                                                <i class="bi bi-credit-card"></i>
                                                <%= item.guardian_nrc_no || '-' %>
                                            </span>

                                            <span>
                                                <i class="bi bi-telephone"></i>
                                                <%= item.phonenumber || '-' %>
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <div class="empty-state">

                                <i class="bi bi-people"></i>

                                <h3>No guardians</h3>

                                <p>
                                    No guardian has been linked
                                    to this student.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </div>

            </section>


            <!-- ATTENDANCE -->
            <section
                class="profile-tab-content"
                id="tab-attendance"
            >

                <div class="content-card">

                    <div class="coming-soon">

                        <i class="bi bi-calendar-check"></i>

                        <h2>Attendance</h2>

                        <p>
                            Student attendance records will appear
                            here once the attendance module is connected.
                        </p>

                    </div>

                </div>

            </section>


            <!-- SUBJECTS -->
            <section
                class="profile-tab-content"
                id="tab-subjects"
            >

                <div class="content-card">

                    <div class="coming-soon">

                        <i class="bi bi-book"></i>

                        <h2>Subjects</h2>

                        <p>
                            The student's class subjects and
                            teaching allocations will appear here 
                            once the subjects and teaching allocations module is connected.
                        </p>

                    </div>

                </div>

            </section>


            <!-- RESULTS -->
            <section
                class="profile-tab-content"
                id="tab-results"
            >

                <div class="content-card">

                    <div class="coming-soon">

                        <i class="bi bi-bar-chart"></i>

                        <h2>Results</h2>

                        <p>
                            Academic results will appear here
                            once the results module is connected.
                        </p>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

<script src="/scripts/student-profile.js"></script>

</body>
</html>