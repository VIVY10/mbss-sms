<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/reportCard.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <title>Report Card</title>
</head>
<body>
    <div class="container" id="report-card">
        <header>
            <div class="logo">
                <img src="/images/logo.png" alt="school Logo">
            </div>
            <div class="header-text">
                <h1>MINISTRY OF EDUCATION</h1>
                <h2>MILENGE SECONDARY SCHOOL</h2>
                <p>(School Code: MBSS01)</p>
                <!-- <h6>Motto: Descipline and hard pay</h6> -->
                <p>P.O BOX, 710104, Milenge, Luapula Province, Milenge</p>
            </div>
            <div class="govt-logo">
                <img src="/images/ministryLogo.png" alt="Government Logo">
            </div>
        </header>

        <!-- Student Information -->
        <section class="student-info">
            <% if(locals.results) {%>
            <table>
                <tr>
                    <td>STUDENT'S NAME : <strong><%= results[0].fname %> <%= results[0].lname %></strong></td>
                    <td>CLASS : <strong><%= results[0].grade %> <%= results[0].class %></strong></td>
                </tr>
                <tr>
                    <td>RESULTS OF : <strong><%= results[0].exam_title %> EXAM</strong></td>
                    <td>EXAM No : <strong><%= results[0].examno %></strong></td>
                </tr>
            </table>
        </section>


        <!-- <h2>School Marksheet</h2> -->
        <table id="marksheet">
            <thead>
                <tr>
                    <th>S/N</th>
                    <th>Subject Code</th>
                    <th>Subject Name</th>
                    <th>Marks</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach(function(element, i){ %>
                    <tr>
                        <td>000<%= i + 1 %></td>
                        <td><%= element.subjectcode %></td>
                        <td><%= element.subjectname %></td>
                        <td class="marks"><%= element.score %></td>
                        <td class="comment"></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Summary Table -->
        <table class="summary-table">
            <tr class="grandtot">
                <td colspan="5">
                    <span>Grand Total</span>
                    <span class="alltot black">000</span>
                </td>
            </tr>
            <tr class="inwords">
                <td colspan="5">
                    <span>Max. Marks</span>
                    <span class="numinwords black">000</span>
                </td>
            </tr>
            <tr>
                <td colspan="5">
                    <span class="subjects">No. of Subjects</span>
                    <span class="num-subjects black">0</span>
                </td>
            </tr>
        </table>

        <!-- Additional Report Details -->
        <div class="table2">
            <table>
                <tr>
                    <th colspan="5" class="month-year">Year of Examinations</th>
                    <th>Result</th>
                    <th>Av. Percentage</th>
                    <th>Grade</th>
                </tr>
                <tr>
                    <td colspan="5" class="month-year"><%= results[0].yearname %></td>
                    <td id="status"></td>
                    <td class="percentage-tot">000</td>
                    <td id="grade">000</td>
                </tr>
            </table>
        </div>
        <!-- Footer Section -->
        <footer>
            <div>
                <p>Class Teacher's Sign: _______________ &nbsp; &nbsp; &nbsp; HeadTeacher's Sign: _______________</p>
            </div>
           <div>
            <p class="disclaimer">
                Disclaimer: The results published on mbss website are immediate information for Students. This cannot be treated as original mark sheet Until Signed and Stamped By School HeadTeacher.
            </p>
           </div>
            <div class="date">
                <p><span>Date Generated:</span> <span id="current-date"></span></p>
            </div>
            <br>
            <p>Visit: <a href="https://www.milengesecondary.com" target="_blank" class="visit">www.milengesecondary.com</a></p>
        </footer>
        <% } %>
    </div>
    <!-- Download Button -->
    <div class="download-btn">
        <button onclick="downloadPDF()">Download as PDF</button>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.4/jspdf.min.js"></script> -->
    <script src="/scripts/reportCard.js"></script>
</body>
</html>