<%- include("../partials/hodSidebar.ejs") %>
      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
        
        <table class="table table-white" id="table">
            <thead>
              <tr>
                <th>Class</th>
                <th>subjectcode</th>
                <th>Subject</th>
                <th>Department</th>
                <th>Teacher</th>
                <th colspan="2">Action</th>
              </tr>
            </thead>
            <% if(locals.foundClass) { %>
                <% foundClass.forEach(element => { %>
                    <tbody>
                      <tr>
                        <td><%= element.grade %><%= element.class %></th>
                        <td><%= element.subjectcode %></td>
                        <td> <%= element.subjectname %></td>
                        <td><%= element.departmentname %></td>
                          <td><%= element.lname %> <%= element.fname %></td>                
                        <td ><a href="/allocateSubject?mherdngb=<%= element.classsubjectid %>&&dhgbjjhggvvffjghftxderdcvbhjgkbjgfjvfj=<%= element.departmentid %>"><i class="material-icons">edit</i></a></td>
                      </tr>
                    </tbody>
                    <% }) %> 
                <% }  %> 
      </div>
    </main>
  </div>
