<!DOCTYPE html>
<html lang="en">
<head> 
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>New Student Registration</title>
  <link rel="stylesheet" href="/css/student-registration.css">
</head>
<body>
  <div class="app-shell">

    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brand-logo">S</div>
        <div>
          <strong>Secondary School</strong>
          <span>Student Information System</span>
        </div>
      </div>

      <nav class="nav">
        <div class="nav-label">ADMISSION</div>
        <a href="/Dashboard" class="nav-item">⌂ <span>Dashboard</span></a>
        <a href="/students/register" class="nav-item active">＋ <span>New Student Registration</span></a>
        <a href="/students/returning" class="nav-item">↻ <span>Returning Students</span></a>
        <a href="/students/search" class="nav-item">⌕ <span>Search Students</span></a>
        <a href="/guardians" class="nav-item">♧ <span>Guardians</span></a>
        <a href="/enrollment" class="nav-item">▣ <span>Enrollment</span></a>
        <a href="/reporting" class="nav-item">✓ <span>Reporting</span></a>
        <a href="/reports" class="nav-item">▤ <span>Reports</span></a>

        <div class="nav-label">SETUP</div>
        <a href="/classes" class="nav-item">▦ <span>Classes</span></a>
        <a href="/yearlevels" class="nav-item">▥ <span>Year Levels</span></a>
        <a href="/terms" class="nav-item">◷ <span>Terms</span></a>
        <a href="/schoolyears" class="nav-item">□ <span>School Years</span></a>
        <a href="/users" class="nav-item">♙ <span>Users &amp; Roles</span></a>

        <div class="nav-label">SYSTEM</div>
        <a href="/settings" class="nav-item">⚙ <span>Settings</span></a>
        <a href="/audit-log" class="nav-item">▧ <span>Audit Log</span></a>
      </nav>
    </aside>

    <main class="main">
      <header class="topbar">
        <button type="button" class="menu-btn" id="menuBtn" aria-label="Toggle navigation">☰</button>

        <div class="topbar-spacer"></div>

        <div class="current-year">
          <span class="calendar-icon">□</span>
          <span><%= schoolyear?.yearname %></span>
          <span>⌄</span>
        </div>

        <button type="button" class="icon-btn notification-btn" aria-label="Notifications">
          ♧<span class="notification-count">3</span>
        </button>

        <div class="user-menu">
          <div class="avatar">R</div>
          <div>
            <strong><%= user.fname || 'Registrar' %></strong>
            <span>Admission Office</span>
          </div>
          <span>⌄</span>
        </div>
      </header>

      <div class="content">
        <div class="page-heading">
          <div>
            <h1>New Student Registration</h1>
            <p>Register a new student and enroll them into a class.</p>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" role="alert"><%= success %></div>
        <% } %>

        <form id="registrationForm"
              action="/students/register"
              method="POST"
              enctype="multipart/form-data"
              novalidate>

          <input type="hidden" name="enrollment_type" value="new">
          <input type="hidden" name="schoolyear" value="<%= schoolyear[0]?.schoolyearid || '' %>">
          <input type="hidden" name="schoolyear" value="<%= schoolyear[0]?.schoolyearid || '' %>">
          <input type="hidden" name="termid" value="<%= foundTerm[0]?.termid || '' %>">
          <input type="hidden" name="reporting_status" value="REPORTED">

          <div class="stepper">
            <button type="button" class="step active" data-step="1">
              <span>1</span><strong>Student Information</strong>
            </button>
            <i></i>
            <button type="button" class="step" data-step="2">
              <span>2</span><strong>Guardian Information</strong>
            </button>
            <i></i>
            <button type="button" class="step" data-step="3">
              <span>3</span><strong>Enrollment Details</strong>
            </button>
            <i></i>
            <button type="button" class="step" data-step="4">
              <span>4</span><strong>Review &amp; Confirm</strong>
            </button>
          </div>

          <div class="registration-grid">
            <div class="form-column">

              <section class="card step-panel active" data-panel="1">
                <div class="card-title">
                  <div class="title-icon">♙</div>
                  <div>
                    <h2>Student Information</h2>
                    <p>Enter the student's personal information.</p>
                  </div>
                </div>

                <div class="form-grid three">
                  <div class="field">
                    <label for="fname">First Name <b>*</b></label>
                    <input id="fname" name="fname" type="text" autocomplete="given-name" required
                           placeholder="Enter first name" value="<%= typeof data !== 'undefined' ? (data.fname || '') : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="middlename">Middle Name</label>
                    <input id="middlename" name="middlename" type="text" autocomplete="additional-name"
                           placeholder="Enter middle name" value="<%= typeof data !== 'undefined' ? (data.middlename || '') : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="lname">Last Name <b>*</b></label>
                    <input id="lname" name="lname" type="text" autocomplete="family-name" required
                           placeholder="Enter last name" value="<%= typeof data !== 'undefined' ? (data.lname || '') : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="gender">Gender <b>*</b></label>
                    <select id="gender" name="gender" required>
                      <option value="">Select gender</option>
                      <option value="male">Male</option>
                      <option value="female">Female</option>
                      <option value="other">Other</option>
                    </select>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="dob">Date of Birth <b>*</b></label>
                    <input id="dob" name="dob" type="date" required
                           value="<%= typeof data !== 'undefined' ? (data.dob || '') : '' %>">
                    <small class="field-hint">Select the student's date of birth.</small>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="birthplace">Place of Birth</label>
                    <input id="birthplace" name="birthplace" type="text"
                           placeholder="Enter place of birth" value="<%= typeof data !== 'undefined' ? (data.birthplace || '') : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="nationality">Nationality <b>*</b></label>
                    <select id="nationality" name="nationality" required>
                      <option value="">Select nationality</option>
                      <% if (typeof nationalities !== 'undefined') { nationalities.forEach(function(item) { %>
                        <option value="<%= item.id ?? item.value %>"><%= item.name ?? item.label %></option>
                      <% }); } %>
                      <% if (typeof nationalities === 'undefined') { %>
                        <option value="Zambian">Zambian</option>
                        <option value="Other">Other</option>
                      <% } %>
                    </select>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="religion">Religion</label>
                    <select id="religion" name="religion">
                      <option value="">Select religion</option>
                      <% if (typeof religions !== 'undefined') { religions.forEach(function(item) { %>
                        <option value="<%= item.id ?? item.value %>"><%= item.name ?? item.label %></option>
                      <% }); } %>
                    </select>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="nrcno">NRC / Birth Certificate No.</label>
                    <input id="nrcno" name="nrcno" type="text"
                           placeholder="Enter identification number" value="<%= typeof data !== 'undefined' ? (data.nrcno || '') : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="previous_school">Previous School</label>
                    <input id="previous_school" name="previous_school" type="text"
                           placeholder="Enter previous school (if any)">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="admission_date">Admission Date <b>*</b></label>
                    <input id="admission_date" name="admission_date" type="date" required
                           value="<%= typeof data !== 'undefined' && data.admission_date ? data.admission_date : '' %>">
                    <small class="field-error"></small>
                  </div>

                  <div class="field photo-field">
                    <label for="profilePicture">Profile Photo</label>
                    <label class="upload-box" for="profilePicture">
                      <span class="upload-preview" id="photoPreview">♙</span>
                      <span>
                        <strong>Click to upload photo</strong>
                        <small>JPG, PNG (max 2MB)</small>
                      </span>
                    </label>
                    <input id="profilePicture" name="profilePicture" type="file"
                           accept="image/jpeg,image/png" hidden>
                    <small class="field-error"></small>
                  </div>

                  <div class="field full">
                    <label for="address">Residential Address <b>*</b></label>
                    <textarea id="address" name="address" rows="3" required
                              placeholder="Enter residential address"><%= typeof data !== 'undefined' ? (data.address || '') : '' %></textarea>
                    <small class="field-error"></small>
                  </div>
                </div>
              </section>

              <section class="card step-panel" data-panel="2">
                <div class="card-title">
                  <div class="title-icon">♧</div>
                  <div>
                    <h2>Guardian Information</h2>
                    <p>Enter the parent or guardian responsible for the student.</p>
                  </div>
                </div>

                <div class="form-grid three">
                  <div class="field">
                    <label for="guardian_name">Guardian Full Name <b>*</b></label>
                    <input id="guardian_name" name="guardian_name" type="text" required
                           placeholder="Enter guardian name">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="relationship">Relationship <b>*</b></label>
                    <select id="relationship" name="relationship" required>
                      <option value="">Select relationship</option>
                      <% if (typeof guardianTypes !== 'undefined') { guardianTypes.forEach(function(item) { %>
                        <option value="<%= item.guardiantypeid ?? item.id %>"><%= item.guardianname ?? item.name %></option>
                      <% }); } %>
                      <% if (typeof guardianTypes === 'undefined') { %>
                        <option value="1">Father</option>
                        <option value="2">Mother</option>
                        <option value="3">Guardian</option>
                      <% } %>
                    </select>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="guardian_nrc">Guardian NRC <b>*</b></label>
                    <input id="guardian_nrc" name="guardian_nrc" type="text" required
                           placeholder="Enter guardian NRC">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="guardian_phone">Primary Phone <b>*</b></label>
                    <input id="guardian_phone" name="guardian_phone" type="tel" required
                           placeholder="e.g. 0971234567">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="guardian_alt_phone">Alternative Phone</label>
                    <input id="guardian_alt_phone" name="guardian_alt_phone" type="tel"
                           placeholder="Alternative phone number">
                  </div>

                  <div class="field">
                    <label for="guardian_email">Email</label>
                    <input id="guardian_email" name="guardian_email" type="email"
                           placeholder="guardian@example.com">
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="guardian_occupation">Occupation</label>
                    <input id="guardian_occupation" name="guardian_occupation" type="text"
                           placeholder="Enter occupation">
                  </div>

                  <div class="field full">
                    <label for="guardian_address">Guardian Address</label>
                    <textarea id="guardian_address" name="guardian_address" rows="3"
                              placeholder="Enter guardian address"></textarea>
                  </div>
                </div>
              </section>

              <section class="card step-panel" data-panel="3">
                <div class="card-title">
                  <div class="title-icon">▣</div>
                  <div>
                    <h2>Enrollment Details</h2>
                    <p>The current academic year and term are selected by the system.</p>
                  </div>
                </div>

                <div class="info-grid">
                  <div class="info-item">
                    <span>Registration Type</span>
                    <strong class="badge green">NEW STUDENT</strong>
                  </div>
                  <div class="info-item">
                    <span>Academic Year</span>
                    <strong><%= schoolyear[0]?.yearname %></strong>
                  </div>
                  <div class="info-item">
                    <span>Current Term</span>
                    <strong><%= foundTerm[0]?.termname %></strong>
                  </div>
                </div>

                <div class="form-grid two">
                  <div class="field">
                    <label for="yearlevel">Year Level <b>*</b></label>
                    <select id="yearlevel" name="yearlevel" required>
                      <option value="">Select year level</option>
                      <% if (typeof yearLevels !== 'undefined') { yearLevels.forEach(function(item) { %>
                        <option value="<%= item.levelorder ?? item.levelid %>"
                                data-level-id="<%= item.levelid ?? item.id %>">
                          <%= item.levelname ?? item.name %>
                        </option>
                      <% }); } %>
                    </select>
                    <small class="field-error"></small>
                  </div>

                  <div class="field">
                    <label for="classid">Class <b>*</b></label>
                    <select id="classid" name="classid" required disabled>
                      <option value="">Select year level first</option>
                      <% if (typeof classes !== 'undefined') { classes.forEach(function(item) { %>
                        <option value="<%= item.classid %>"
                                data-level-id="<%= item.levelid %>">
                          <%= item.class %>
                        </option>
                      <% }); } %>
                    </select>
                    <small class="field-hint">Only classes belonging to the selected year level are shown.</small>
                    <small class="field-error"></small>
                  </div>
                </div>

                <div class="notice">
                  <span>ⓘ</span>
                  <div>
                    <strong>Automatic reporting</strong>
                    <p>New students registered through this process are automatically enrolled and marked as <strong>REPORTED</strong>. The reporting date is recorded by the database using the current timestamp.</p>
                  </div>
                </div>

                <div class="account-section">
                  <div class="card-title compact">
                    <div class="title-icon">♧</div>
                    <div>
                      <h2>Account Information</h2>
                      <p>Credentials used by the student where applicable.</p>
                    </div>
                  </div>

                  <div class="form-grid three">
                    <div class="field">
                      <label for="examno">Exam Number <b>*</b></label>
                      <input id="examno" name="examno" type="text" required
                             placeholder="e.g. 2026/0045" value="<%= typeof data !== 'undefined' ? (data.examno || '') : '' %>">
                      <small class="field-hint">Must be unique.</small>
                      <small class="field-error"></small>
                    </div>

                    <div class="field">
                      <label for="password">Password <b>*</b></label>
                      <div class="password-wrap">
                        <input id="password" name="password" type="password" minlength="8" required
                               placeholder="Enter password">
                        <button type="button" class="password-toggle" data-target="password" aria-label="Show password">◉</button>
                      </div>
                      <small class="field-error"></small>
                    </div>

                    <div class="field">
                      <label for="confirmPassword">Confirm Password <b>*</b></label>
                      <div class="password-wrap">
                        <input id="confirmPassword" type="password" minlength="8" required
                               placeholder="Confirm password">
                        <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password">◉</button>
                      </div>
                      <small class="field-error"></small>
                    </div>
                  </div>
                </div>
              </section>

              <section class="card step-panel" data-panel="4">
                <div class="card-title">
                  <div class="title-icon">✓</div>
                  <div>
                    <h2>Review &amp; Confirm</h2>
                    <p>Check the information before completing registration.</p>
                  </div>
                </div>

                <div id="reviewContent" class="review"></div>

                <div class="confirmation">
                  <label>
                    <input type="checkbox" id="confirmDetails" required>
                    <span>I confirm that the information entered is correct and I want to register this student.</span>
                  </label>
                </div>
              </section>

              <div class="form-actions">
                <button type="button" class="btn secondary" id="cancelBtn">Cancel</button>
                <button type="button" class="btn secondary hidden" id="backBtn">← Back</button>
                <button type="button" class="btn primary" id="nextBtn">Next →</button>
                <button type="submit" class="btn primary hidden" id="submitBtn">Register Student ✓</button>
              </div>
            </div>

            <aside class="right-column">
              <div class="card summary-card">
                <div class="summary-heading">
                  <span>▣</span>
                  <h2>Registration Summary</h2>
                </div>

                <div class="summary-row">
                  <span>Registration Type</span>
                  <strong class="badge green">NEW STUDENT</strong>
                </div>
                <div class="summary-row">
                  <span>Academic Year</span>
                  <strong id="summaryYear"><%= currentSchoolYear?.yearname || currentSchoolYear?.schoolyear || '-' %></strong>
                </div>
                <div class="summary-row">
                  <span>Term</span>
                  <strong id="summaryTerm"><%= currentTerm?.termname || currentTerm?.term || '-' %></strong>
                </div>
                <div class="summary-row">
                  <span>Class</span>
                  <strong id="summaryClass">Not selected</strong>
                </div>
                <div class="summary-row">
                  <span>Status</span>
                  <strong class="badge green">ACTIVE</strong>
                </div>
                <div class="summary-row">
                  <span>Reporting</span>
                  <strong class="badge green">REPORTED</strong>
                </div>
              </div>

              <div class="card help-card">
                <div class="help-icon">ⓘ</div>
                <div>
                  <h3>Need Help?</h3>
                  <p>Fields marked with <b>*</b> are mandatory. Verify the student's identity before creating a new record to prevent duplicates.</p>
                </div>
              </div>

              <div class="card checklist-card">
                <h3>Registration Checklist</h3>
                <label><span class="check" data-check="student">✓</span> Student information</label>
                <label><span class="check" data-check="guardian">✓</span> Guardian information</label>
                <label><span class="check" data-check="enrollment">✓</span> Class assignment</label>
                <label><span class="check" data-check="review">✓</span> Final confirmation</label>
              </div>
            </aside>
          </div>
        </form>
      </div>

      <footer class="footer">
        <span>© <%= new Date().getFullYear() %> Secondary School. All rights reserved.</span>
        <span>Student Information System v1.0.0</span>
      </footer>
    </main>
  </div>

  <script src="/js/student-registration.js" defer></script>
</body>
</html>
