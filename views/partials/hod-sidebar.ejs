    <aside class="sidebar" id="sidebar" aria-label="HOD navigation">

        <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close navigation">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="sidebar-brand">

            <div class="brand-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 2 8l10 5 8-4v6h2V8L12 3z"/>
                    <path d="M6 11v5c0 2 3 4 6 4s6-2 6-4v-5l-6 3-6-3z"/>
                </svg>
            </div>

            <div>
                <h5>MBSS</h5>
                <small>School Management</small>
            </div>

        </div>

        <div class="sidebar-profile">

            <div class="profile-avatar">
                <% if (typeof user !== 'undefined' && user.profilePicture) { %>
                    <img src="/images/profile/<%= user.profilePicture %>" alt="Profile">
                <% } else { %>
                    <span>
                        <%= typeof user !== 'undefined'
                            ? (user.fname?.charAt(0) || 'H')
                            : 'H' %>
                    </span>
                <% } %>
            </div>

            <div class="profile-info">

                <strong>
                    <%= typeof user !== 'undefined'
                        ? `${user.fname || ''} ${user.lname || ''}`
                        : 'HOD' %>
                </strong>

                <small>Head of Department</small>

            </div>

            <button class="icon-button sidebar-profile-menu">
                <i class="bi bi-three-dots-vertical"></i>
            </button>

        </div>


        <!-- Navigation -->

        <nav class="sidebar-nav">

            <div class="nav-section-title">
                MAIN
            </div>

            <a href="/dashboard"
               class="nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                </svg>

                <span>Dashboard</span>

            </a>


            <div class="nav-section-title">
                ACADEMICS
            </div>

            <a href="/hod/teachers"
               class="nav-item <%= currentPage === 'teachers' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4z"/>
                    <path d="M8 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3z"/>
                    <path d="M16 13c-3.3 0-6 1.7-6 4v3h12v-3c0-2.3-2.7-4-6-4z"/>
                    <path d="M2 20v-3c0-1.8 1.7-3.2 4-3.8"/>
                </svg>

                <span>Department Teachers</span>

            </a>


            <a href="/hod/subject-allocations"
               class="nav-item <%= currentPage === 'subject-allocations' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M4 5h16v14H4z"/>
                    <path d="M8 9h8M8 13h5"/>
                </svg>

                <span>Subject Allocations</span>

            </a>


            <a href="/hod/class-subjects"
               class="nav-item <%= currentPage === 'class-subjects' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M4 4h16v16H4z"/>
                    <path d="M8 8h8M8 12h8M8 16h5"/>
                </svg>

                <span>Class Subjects</span>

            </a>


            <a href="/hod/marks"
               class="nav-item <%= currentPage === 'marks' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M5 3v18"/>
                    <path d="M5 18h14"/>
                    <path d="m8 15 3-4 3 2 4-6"/>
                </svg>

                <span>Marks Schedule</span>

            </a>

            <a href="/hod/results"
               class="nav-item <%= currentPage === 'results' ? 'active' : '' %>">

