                    <path d="M5 3v18"/>
                    <path d="M5 18h14"/>
                    <path d="m8 15 3-4 3 2 4-6"/>
                </svg>

                <span>Results</span>

            </a>

            <a href="/marks-monitoring"
               class="nav-item"
               >
               <i class="bi bi-clipboard-data-fill"></i>
               
                <span>Marks Monitoring</span>

            </a>

            <a href="/myClasses"
               class="nav-item"
               >

                <i class="bi bi-easel2-fill"></i>

                <span>My Classes</span>

            </a>


            <div class="nav-section-title">
                RESULTS
            </div>

            <a href="/hod/results"
               class="nav-item <%= currentPage === 'results' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="6"/>
                    <path d="m16 16 5 5"/>
                </svg>

                <span>Search Results</span>

            </a>


            <a href="/hod/progress"
               class="nav-item <%= currentPage === 'progress' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M4 19V5"/>
                    <path d="M4 19h17"/>
                    <path d="m7 15 4-4 3 2 5-7"/>
                </svg>

                <span>Progress Charts</span>

            </a>


            <div class="nav-section-title">
                REPORTS
            </div>

            <a href="/hod/reports"
               class="nav-item <%= currentPage === 'reports' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
                    <path d="M6 3h9l4 4v14H6z"/>
                    <path d="M14 3v5h5"/>
                    <path d="M9 13h6M9 17h6"/>
                </svg>

                <span>Academic Reports</span>

            </a>


            <a href="/hod/analytics"
               class="nav-item <%= currentPage === 'analytics' ? 'active' : '' %>">

                <svg viewBox="0 0 24 24">
