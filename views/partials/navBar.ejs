<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Milenge Boarding Secondary School - Providing quality education, discipline, leadership and holistic development for tomorrow's leaders."
    >

    <meta
        name="theme-color"
        content="#123b6d"
    >

    <meta
        name="robots"
        content="index, follow"
    >

    <title>
        Milenge Boarding Secondary School | Ministry of Education
    </title>

    <link
        rel="stylesheet"
        href="/styles/landing.css"
    >
</head>

<body>

<!-- =========================================================
     TOP GOVERNMENT / MINISTRY BAR
========================================================= -->
<div class="top-bar">
    <div class="container top-bar-inner">

        <div class="government-name">
            <span class="government-icon" aria-hidden="true">
                ◈
            </span>

            <span>
                Republic of Zambia
            </span>
        </div>

        <div class="ministry-name">
            Ministry of Education
        </div>

        <div class="top-links">
            <a href="/contact">
                Contact us
            </a>

            <span class="top-divider">|</span>

            <a href="/admissions">
                Admissions
            </a>
        </div>

    </div>
</div>


<!-- =========================================================
     MAIN HEADER
========================================================= -->
<header class="site-header" id="siteHeader">

    <div class="container header-inner">

        <!-- =========================================================
             SCHOOL BRAND
        ========================================================== -->
        <a
            href="/"
            class="school-brand"
            aria-label="Milenge Boarding Secondary School home"
        >

            <div class="school-logo-wrap">
                <img
                    src="/images/logo.png"
                    alt="Milenge Boarding Secondary School logo"
                    class="school-logo"
                >
            </div>

            <div class="brand-text">

                <span class="brand-ministry">
                    Ministry of Education
                </span>

                <span class="brand-school">
                    Milenge Boarding
                    <strong>Secondary School</strong>
                </span>

                <span class="brand-motto">
                    Discipline and Hardwork Pay
                </span>

            </div>

        </a>


        <!-- =========================================================
             DESKTOP NAVIGATION
        ========================================================== -->
        <nav
            class="desktop-navigation"
            aria-label="Main navigation"
        >

            <a
                href="/"
                class="nav-link active"
            >
                Home
            </a>

            <a
                href="/about"
                class="nav-link"
            >
                About Us
            </a>

            <a
                href="/academics"
                class="nav-link"
            >
                Academics
            </a>

            <a
                href="/boarding"
                class="nav-link"
            >
                Boarding
            </a>

            <a
                href="/news"
                class="nav-link"
            >
                News
            </a>

            <!-- =====================================================
                 LOGIN DROPDOWN
            ====================================================== -->
            <div class="login-dropdown">

                <button
                    type="button"
                    class="login-dropdown-button"
                    id="loginDropdownButton"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="loginDropdownMenu"
                >

                    <span
                        class="login-icon"
                        aria-hidden="true"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            focusable="false"
                        >
                            <path
                                d="M12 12a5 5 0 1 0 0-10
                                   5 5 0 0 0 0 10Zm0 2
                                   c-4.42 0-8 2.24-8 5v2h16v-2
                                   c0-2.76-3.58-5-8-5Z"
                            />
                        </svg>
                    </span>

                    <span>
                        Login
                    </span>

                    <svg
                        class="login-chevron"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path d="m6 9 6 6 6-6"/>
                    </svg>

                </button>


                <div
                    class="login-dropdown-menu"
                    id="loginDropdownMenu"
                    role="menu"
                    aria-labelledby="loginDropdownButton"
                >

                    <div class="login-dropdown-header">

                        <span>
                            Portal Access
                        </span>

                        <small>
                            Select your account
                        </small>

                    </div>


                    <!-- STUDENT LOGIN -->
                    <a
                        href="/studentLogin"
                        class="login-option"
                        role="menuitem"
                    >

                        <span
                            class="login-option-icon student-icon"
                            aria-hidden="true"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                focusable="false"
                            >
                                <path
                                    d="M12 3 2 8l10 5 8-4v6h2V8L12 3Zm-6
                                       9v4c0 2.21 2.69 4 6 4s6-1.79
                                       6-4v-4l-6 3-6-3Z"
                                />
                            </svg>
                        </span>

                        <span class="login-option-content">

                            <strong>
                                Student Login
                            </strong>

                            <small>
                                Access student portal
                            </small>

                        </span>
                    </a>


                    <!-- STAFF LOGIN -->
                    <a
                        href="/login"
                        class="login-option"
                        role="menuitem"
                    >

                        <span
                            class="login-option-icon staff-icon"
                            aria-hidden="true"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                focusable="false"
                            >
                                <path
                                    d="M12 12a5 5 0 1 0 0-10
                                       5 5 0 0 0 0 10Zm0 2
                                       c-4.42 0-8 2.24-8 5v2h16v-2
                                       c0-2.76-3.58-5-8-5Z"
                                />
                            </svg>
                        </span>

                        <span class="login-option-content">

                            <strong>
                                Staff Login
                            </strong>

                            <small>
                                Teachers & administrators
                            </small>

                        </span>

                    </a>

                </div>

            </div>


            <!-- APPLY BUTTON -->
            <a
                href="/parent/report-card"
                class="nav-cta"
            >
                eReport Card
            </a>

        </nav>


        <!-- =========================================================
             MOBILE MENU BUTTON
        ========================================================== -->
        <button
            type="button"
            class="mobile-menu-button"
            id="mobileMenuButton"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobileNavigation"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </div>


    <!-- =============================================================
         MOBILE NAVIGATION
    ============================================================= -->
    <nav
        class="mobile-navigation"
        id="mobileNavigation"
        aria-label="Mobile navigation"
    >

        <a href="#home">
            Home
        </a>

        <a href="#about">
            About Us
        </a>

        <a href="#academics">
            Academics
        </a>

        <a href="#boarding">
            Boarding
        </a>

        <a href="#admissions">
            Admissions
        </a>

        <a href="#news">
            News
        </a>

        <a href="#contact">
            Contact
        </a>


        <!-- =========================================================
             MOBILE PORTAL ACCESS
        ========================================================== -->
        <div class="mobile-login">

            <div class="mobile-login-header">

                <div>
                    <span class="mobile-login-title">
                        Portal Access
                    </span>

                    <span class="mobile-login-subtitle">
                        Select your account
                    </span>
                </div>

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                >
                    <path
                        d="M12 12a5 5 0 1 0 0-10
                           5 5 0 0 0 0 10Zm0 2
                           c-4.42 0-8 2.24-8 5v2h16v-2
                           c0-2.76-3.58-5-8-5Z"
                    />
                </svg>

            </div>


            <!-- STUDENT -->
            <a
                href="/student/login"
                class="mobile-login-option"
            >

                <span
                    class="mobile-login-icon student-icon"
                    aria-hidden="true"
                >
                    <svg
                        viewBox="0 0 24 24"
                        focusable="false"
                    >
                        <path
                            d="M12 3 2 8l10 5 8-4v6h2V8L12 3Zm-6
                               9v4c0 2.21 2.69 4 6 4s6-1.79
                               6-4v-4l-6 3-6-3Z"
                        />
                    </svg>
                </span>

                <span class="mobile-login-text">

                    <strong>
                        Student Login
                    </strong>

                    <small>
                        Access student portal
                    </small>

                </span>

                <span
                    class="mobile-login-arrow"
                    aria-hidden="true"
                >
                    →
                </span>

            </a>


            <!-- STAFF -->
            <a
                href="/login"
                class="mobile-login-option"
            >

                <span
                    class="mobile-login-icon staff-icon"
                    aria-hidden="true"
                >
                    <svg
                        viewBox="0 0 24 24"
                        focusable="false"
                    >
                        <path
                            d="M12 12a5 5 0 1 0 0-10
                               5 5 0 0 0 0 10Zm0 2
                               c-4.42 0-8 2.24-8 5v2h16v-2
                               c0-2.76-3.58-5-8-5Z"
                        />
                    </svg>
                </span>

                <span class="mobile-login-text">

                    <strong>
                        Staff Login
                    </strong>

                    <small>
                        Teachers & administrators
                    </small>

                </span>

                <span
                    class="mobile-login-arrow"
                    aria-hidden="true"
                >
                    →
                </span>

            </a>

        </div>


        <!-- MOBILE APPLY -->
        <a
            href="#admissions"
            class="mobile-apply"
        >
            Apply Now
        </a>

    </nav>

</header>
<main>