<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= department.departmentname %> | Department Dashboard
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <style>

        :root {
            --primary: #1f4e79;
            --primary-dark: #163a5c;
            --background: #f5f7fb;
            --card: #ffffff;
            --border: #e5e9f0;
            --text: #253143;
            --muted: #7b8794;
            --success: #198754;
            --warning: #d98c00;
            --danger: #dc3545;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        /* ========================================
           SIDEBAR
        ======================================== */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #ffffff;
            border-right: 1px solid var(--border);
            padding: 20px 14px;
            z-index: 1000;
            overflow-y: auto;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px 25px;
            font-weight: 700;
            font-size: 18px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-section {
            font-size: 11px;
            text-transform: uppercase;
            color: #9aa4b2;
            font-weight: 700;
            margin: 20px 12px 8px;
            letter-spacing: .06em;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: 9px;
            color: #667085;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .sidebar-link i {
            font-size: 17px;
        }

        .sidebar-link:hover {
            background: #f1f5f9;
            color: var(--primary);
        }

        .sidebar-link.active {
            background: #eaf1f7;
            color: var(--primary);
        }

        .sidebar-link .arrow {
            margin-left: auto;
            font-size: 12px;
        }

        /* ========================================
           MAIN
        ======================================== */

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 72px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .topbar-title {
            font-weight: 700;
            font-size: 18px;
        }

        .topbar-subtitle {
            color: var(--muted);
            font-size: 12px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #eaf1f7;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        /* ========================================
           CONTENT
        ======================================== */

        .content {
            padding: 30px;
        }

        .page-heading h2 {
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-heading p {
            color: var(--muted);
            margin-bottom: 25px;
        }

        /* ========================================
           FILTER BAR
        ======================================== */

        .filter-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 22px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 700;
            color: #667085;
        }

        .form-select,
        .form-control {
            border-color: #dce1e8;
            border-radius: 8px;
            font-size: 14px;
        }

        /* ========================================
           STAT CARDS
        ======================================== */

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 20px;
            height: 100%;
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #eef3f8;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .stat-value {
            font-size: 27px;
            font-weight: 700;
            margin-top: 13px;
        }

        .stat-label {
            font-size: 13px;
            color: var(--muted);
        }

        /* ========================================
           CARDS
        ======================================== */

        .dashboard-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            overflow: hidden;
            height: 100%;
        }

        .card-header-custom {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-title {
            font-size: 15px;
            font-weight: 700;
            margin: 0;
        }

        .card-title i {
            color: var(--primary);
            margin-right: 7px;
        }

        .card-body-custom {
            padding: 20px;
        }

        /* ========================================
           TABLE
        ======================================== */

        .table {
            margin-bottom: 0;
        }

        .table th {
            background: #f8fafc;
            color: #667085;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
            white-space: nowrap;
        }

        .table td {
            font-size: 13px;
            vertical-align: middle;
            padding: 13px;
        }

        /* ========================================
           STATUS
        ======================================== */

        .badge-soft {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-success {
            background: #e9f7ef;
            color: var(--success);
        }

        .badge-warning {
            background: #fff5df;
            color: var(--warning);
        }

        .badge-danger {
            background: #fdecec;
            color: var(--danger);
        }

        /* ========================================
           QUICK ACTIONS
        ======================================== */

        .quick-action {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 13px;
            text-decoration: none;
            color: var(--text);
            transition: .15s;
        }

        .quick-action:hover {
            border-color: var(--primary);
            background: #f8fbfd;
            color: var(--primary);
        }

        .quick-action-icon {
            width: 40px;
            height: 40px;
            border-radius: 9px;
            background: #eef3f8;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quick-action-title {
            font-weight: 700;
            font-size: 13px;
        }

        .quick-action-text {
            color: var(--muted);
            font-size: 11px;
        }

        /* ========================================
           EMPTY STATE
        ======================================== */

        .empty-state {
            text-align: center;
            padding: 35px 15px;
            color: var(--muted);
        }

        .empty-state i {
            font-size: 32px;
            margin-bottom: 10px;
        }

        /* ========================================
           REPORT CARDS
        ======================================== */

        .report-card {
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 18px;
            height: 100%;
        }

        .report-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            background: #eef3f8;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 13px;
        }

        .report-title {
            font-weight: 700;
            font-size: 14px;
        }

        .report-description {
            color: var(--muted);
            font-size: 12px;
            min-height: 38px;
        }

        /* ========================================
           MOBILE
        ======================================== */

        .mobile-menu {
            display: none;
        }

        @media(max-width: 991px) {

            .sidebar {
                transform: translateX(-100%);
                transition: .2s;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
            }

            .mobile-menu {
                display: inline-flex;
            }

            .content {
                padding: 18px;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </div>

        <div>
            School MIS
            <div
                style="
                    font-size:10px;
                    color:#8b95a5;
                    font-weight:500;
                "
            >
                Department Management
            </div>
        </div>

    </div>


    <div class="sidebar-section">
        Department
    </div>

    <a
        href="/hod/dashboard"
        class="sidebar-link active"
    >
        <i class="bi bi-grid"></i>
        Dashboard
    </a>


    <a
        href="/hod/teachers"
        class="sidebar-link"
    >
        <i class="bi bi-people"></i>
        Department Teachers
    </a>


    <a
        href="/hod/teacher-subjects"
        class="sidebar-link"
    >
        <i class="bi bi-person-workspace"></i>
        Teacher Subject Allocation
    </a>


    <div class="sidebar-section">
        Subjects & Classes
    </div>


    <a
        href="/hod/subjects"
        class="sidebar-link"
    >
        <i class="bi bi-book"></i>
        Subject Allocation
    </a>


    <a
        href="/hod/classes-without-subjects"
        class="sidebar-link"
    >
        <i class="bi bi-exclamation-square"></i>
        Classes Without Subjects

        <% if (statistics?.classesWithoutSubjects > 0) { %>

            <span class="badge bg-danger ms-auto">
                <%= statistics.classesWithoutSubjects %>
            </span>

        <% } %>

    </a>


    <div class="sidebar-section">
        Results
    </div>


    <a
        href="/hod/marks-schedule"
        class="sidebar-link"
    >
        <i class="bi bi-calendar-check"></i>
        Marks Schedule
    </a>


    <a
        href="/hod/results/search"
        class="sidebar-link"
    >
        <i class="bi bi-search"></i>
        Search Pupil Results
    </a>


    <a
        href="/hod/progress"
        class="sidebar-link"
    >
        <i class="bi bi-graph-up"></i>
        Progress Charts
    </a>


    <div class="sidebar-section">
        Reports
    </div>


    <a
        href="/hod/reports/mid-term"
        class="sidebar-link"
    >
        <i class="bi bi-file-earmark-text"></i>
        Mid-Term Reports
    </a>


    <a
        href="/hod/reports/termly"
        class="sidebar-link"
    >
        <i class="bi bi-file-earmark-bar-graph"></i>
        Termly Reports
    </a>


    <a
        href="/hod/reports/annual"
        class="sidebar-link"
    >
        <i class="bi bi-award"></i>
        End-of-Year Reports
    </a>


    <div class="sidebar-section">
        Account
    </div>


    <a
        href="/profile"
        class="sidebar-link"
    >
        <i class="bi bi-person"></i>
        My Profile
    </a>


    <a
        href="/logout"
        class="sidebar-link"
    >
        <i class="bi bi-box-arrow-right"></i>
        Logout
    </a>

</aside>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="main">


    <!-- TOP BAR -->

    <header class="topbar">

        <div class="d-flex align-items-center gap-3">

            <button
                class="btn btn-light mobile-menu"
                id="mobileMenu"
            >
                <i class="bi bi-list"></i>
            </button>

            <div>

                <div class="topbar-title">
                    <%= department.departmentname %> Department
                </div>

                <div class="topbar-subtitle">
                    Head of Department Dashboard
                </div>

            </div>

        </div>


        <div class="profile">

            <div class="profile-avatar">

                <%= teacher.fname?.charAt(0) %>
                <%= teacher.lname?.charAt(0) %>

            </div>

            <div class="d-none d-md-block">

                <div
                    style="
                        font-size:13px;
                        font-weight:700;
                    "
                >
                    <%= teacher.fname %>
                    <%= teacher.lname %>
                </div>

                <div
                    style="
                        font-size:11px;
                        color:#8b95a5;
                    "
                >
                    HOD
                </div>

            </div>

        </div>

    </header>


    <!-- CONTENT -->

    <div class="content">


        <!-- PAGE TITLE -->

        <div class="page-heading">

            <h2>
                Department Overview
            </h2>

            <p>
                Manage teachers, subjects, classes, results and
                academic reports for your department.
            </p>

        </div>


        <!-- =================================================
             FILTERS
        ================================================= -->

        <div class="filter-card">

            <div class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label">
                        Academic Year
                    </label>

                    <select
                        class="form-select"
                        id="academicYear"
                    >

                        <% academicYears?.forEach(year => { %>

                            <option
                                value="<%= year.schoolyearid %>"
                                <%= year.schoolyearid == currentYearId
                                    ? 'selected'
                                    : '' %>
                            >
                                <%= year.yearname %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Term
                    </label>

                    <select
                        class="form-select"
                        id="term"
                    >

                        <% terms?.forEach(term => { %>

                            <option
                                value="<%= term.termid %>"
                                <%= term.termid == currentTermId
                                    ? 'selected'
                                    : '' %>
                            >
                                <%= term.termname %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <div class="col-md-4">

                    <button
                        class="btn btn-primary w-100"
                        id="applyFilters"
                    >

                        <i class="bi bi-funnel"></i>

                        Apply Filters

                    </button>

                </div>

            </div>

        </div>


        <!-- =================================================
             STATISTICS
        ================================================= -->

        <div class="row g-3 mb-4">


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div class="stat-value">
                        <%= statistics?.teachers || 0 %>
                    </div>

                    <div class="stat-label">
                        Department Teachers
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <div class="stat-value">
                        <%= statistics?.subjects || 0 %>
                    </div>

                    <div class="stat-label">
                        Department Subjects
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-easel"></i>
                    </div>

                    <div class="stat-value">
                        <%= statistics?.classes || 0 %>
                    </div>

                    <div class="stat-label">
                        Classes Covered
                    </div>

                </div>

            </div>


            <div class="col-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <div class="stat-value text-danger">
                        <%= statistics?.classesWithoutSubjects || 0 %>
                    </div>

                    <div class="stat-label">
                        Classes Without Subjects
                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             QUICK ACTIONS
        ================================================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <h5 class="card-title">
                    <i class="bi bi-lightning-charge"></i>
                    Quick Actions
                </h5>

            </div>


            <div class="card-body-custom">

                <div class="row g-3">


                    <div class="col-md-4">

                        <a
                            href="/hod/teachers"
                            class="quick-action"
                        >

                            <div class="quick-action-icon">
                                <i class="bi bi-people"></i>
                            </div>

                            <div>

                                <div class="quick-action-title">
                                    View Department Teachers
                                </div>

                                <div class="quick-action-text">
                                    View and manage teaching staff.
                                </div>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-4">

                        <a
                            href="/hod/subjects"
                            class="quick-action"
                        >

                            <div class="quick-action-icon">
                                <i class="bi bi-book"></i>
                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Allocate Subjects
                                </div>

                                <div class="quick-action-text">
                                    Assign department subjects to classes.
                                </div>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-4">

                        <a
                            href="/hod/teacher-subjects"
                            class="quick-action"
                        >

                            <div class="quick-action-icon">
                                <i class="bi bi-person-workspace"></i>
                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Allocate Teachers
                                </div>

                                <div class="quick-action-text">
                                    Assign teachers to class subjects.
                                </div>

                            </div>

                        </a>

                    </div>


                </div>

            </div>

        </div>


        <!-- =================================================
             SUBJECT COVERAGE + TEACHER WORKLOAD
        ================================================= -->

        <div class="row g-4 mb-4">


            <!-- SUBJECT COVERAGE -->

            <div class="col-lg-7">

                <div class="dashboard-card">

                    <div class="card-header-custom">

                        <h5 class="card-title">

                            <i class="bi bi-book"></i>

                            Subject Coverage

                        </h5>

                        <a
                            href="/hod/subjects"
                            class="btn btn-sm btn-light border"
                        >
                            View All
                        </a>

                    </div>


                    <div class="table-responsive">

                        <table class="table">

                            <thead>

                                <tr>
                                    <th>Subject</th>
                                    <th>Classes</th>
                                    <th>Teacher</th>
                                    <th>Status</th>
                                </tr>

                            </thead>


                            <tbody>

                            <% subjects?.slice(0, 6).forEach(subject => { %>

                                <tr>

                                    <td>

                                        <strong>
                                            <%= subject.subjectcode %>
                                        </strong>

                                        <div
                                            style="
                                                color:#7b8794;
                                                font-size:11px;
                                            "
                                        >
                                            <%= subject.subjectname %>
                                        </div>

                                    </td>


                                    <td>
                                        <%= subject.class_count || 0 %>
                                    </td>


                                    <td>

                                        <%= subject.teacher_count || 0 %>

                                        teacher(s)

                                    </td>


                                    <td>

                                        <% if (subject.class_count > 0) { %>

                                            <span class="badge-soft badge-success">
                                                Allocated
                                            </span>

                                        <% } else { %>

                                            <span class="badge-soft badge-danger">
                                                Not Allocated
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>


                            <% if (!subjects?.length) { %>

                                <tr>

                                    <td
                                        colspan="4"
                                        class="text-center text-muted py-4"
                                    >
                                        No department subjects found.
                                    </td>

                                </tr>

                            <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- TEACHER WORKLOAD -->

            <div class="col-lg-5">

                <div class="dashboard-card">

                    <div class="card-header-custom">

                        <h5 class="card-title">

                            <i class="bi bi-person-workspace"></i>

                            Teacher Workload

                        </h5>

                        <a
                            href="/hod/teachers"
                            class="btn btn-sm btn-light border"
                        >
                            View All
                        </a>

                    </div>


                    <div class="card-body-custom">

                        <% teacherWorkload?.slice(0, 6).forEach(item => { %>

                            <div class="d-flex align-items-center mb-3">

                                <div class="profile-avatar me-3">

                                    <%= item.fname?.charAt(0) %>
                                    <%= item.lname?.charAt(0) %>

                                </div>

                                <div class="flex-grow-1">

                                    <div
                                        style="
                                            font-weight:700;
                                            font-size:13px;
                                        "
                                    >
                                        <%= item.fname %>
                                        <%= item.lname %>
                                    </div>

                                    <div
                                        style="
                                            color:#8b95a5;
                                            font-size:11px;
                                        "
                                    >
                                        <%= item.subject_count || 0 %>
                                        subjects
                                    </div>

                                </div>

                                <strong>
                                    <%= item.class_count || 0 %>
                                    classes
                                </strong>

                            </div>

                        <% }) %>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             CLASSES WITHOUT SUBJECTS
        ================================================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <h5 class="card-title">

                    <i class="bi bi-exclamation-square"></i>

                    Classes Without Department Subjects

                </h5>

                <a
                    href="/hod/classes-without-subjects"
                    class="btn btn-sm btn-outline-danger"
                >
                    Resolve Issues
                </a>

            </div>


            <div class="table-responsive">

                <table class="table">

                    <thead>

                        <tr>

                            <th>Level</th>
                            <th>Class</th>
                            <th>Students</th>
                            <th>Missing Subjects</th>
                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                    <% classesWithoutSubjects?.slice(0, 8)
                        .forEach(item => { %>

                        <tr>

                            <td>
                                <%= item.levelname %>
                            </td>

                            <td>
                                <strong>
                                    <%= item.class %>
                                </strong>
                            </td>

                            <td>
                                <%= item.student_count || 0 %>
                            </td>

                            <td>

                                <span class="badge-soft badge-danger">

                                    <%= item.missing_subject_count || 0 %>

                                    subject(s)

                                </span>

                            </td>

                            <td>

                                <a
                                    href="/hod/classes/<%= item.classid %>/subjects"
                                    class="btn btn-sm btn-light border"
                                >
                                    Allocate Subjects
                                </a>

                            </td>

                        </tr>

                    <% }) %>


                    <% if (!classesWithoutSubjects?.length) { %>

                        <tr>

                            <td
                                colspan="5"
                                class="text-center text-success py-4"
                            >

                                <i class="bi bi-check-circle"></i>

                                All classes have department subjects
                                allocated.

                            </td>

                        </tr>

                    <% } %>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =================================================
             RESULTS
        ================================================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <h5 class="card-title">

                    <i class="bi bi-bar-chart"></i>

                    Results & Assessment

                </h5>

            </div>


            <div class="card-body-custom">

                <div class="row g-3">


                    <div class="col-lg-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-calendar-check"></i>

                            </div>

                            <div class="report-title">
                                Marks Schedule
                            </div>

                            <p class="report-description">

                                View subjects, classes and marks
                                submission schedules for the department.

                            </p>

                            <a
                                href="/hod/marks-schedule"
                                class="btn btn-primary btn-sm"
                            >
                                Open Schedule
                            </a>

                        </div>

                    </div>


                    <div class="col-lg-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-search"></i>

                            </div>

                            <div class="report-title">
                                Search Pupil Results
                            </div>

                            <p class="report-description">

                                Search an individual pupil's results
                                for department subjects.

                            </p>

                            <a
                                href="/hod/results/search"
                                class="btn btn-primary btn-sm"
                            >
                                Search Results
                            </a>

                        </div>

                    </div>


                    <div class="col-lg-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-graph-up"></i>

                            </div>

                            <div class="report-title">
                                Progress Charts
                            </div>

                            <p class="report-description">

                                Analyse pupil performance across
                                terms and academic years.

                            </p>

                            <a
                                href="/hod/progress"
                                class="btn btn-primary btn-sm"
                            >
                                View Analytics
                            </a>

                        </div>

                    </div>


                </div>

            </div>

        </div>


        <!-- =================================================
             REPORT GENERATION
        ================================================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <div>

                    <h5 class="card-title">

                        <i class="bi bi-file-earmark-text"></i>

                        Academic Reports

                    </h5>

                </div>

            </div>


            <div class="card-body-custom">

                <div class="row g-3">


                    <!-- MID TERM -->

                    <div class="col-md-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-file-earmark"></i>

                            </div>

                            <div class="report-title">
                                Mid-Term Reports
                            </div>

                            <p class="report-description">

                                Generate mid-term performance reports
                                for pupils taking department subjects.

                            </p>

                            <a
                                href="/hod/reports/mid-term"
                                class="btn btn-outline-primary btn-sm"
                            >
                                Generate Report
                            </a>

                        </div>

                    </div>


                    <!-- TERMLY -->

                    <div class="col-md-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-file-earmark-bar-graph"></i>

                            </div>

                            <div class="report-title">
                                Termly Reports
                            </div>

                            <p class="report-description">

                                Generate complete term reports
                                containing departmental subjects.

                            </p>

                            <a
                                href="/hod/reports/termly"
                                class="btn btn-outline-primary btn-sm"
                            >
                                Generate Report
                            </a>

                        </div>

                    </div>


                    <!-- ANNUAL -->

                    <div class="col-md-4">

                        <div class="report-card">

                            <div class="report-icon">

                                <i class="bi bi-award"></i>

                            </div>

                            <div class="report-title">
                                End-of-Year Reports
                            </div>

                            <p class="report-description">

                                Generate final academic reports and
                                departmental performance summaries.

                            </p>

                            <a
                                href="/hod/reports/annual"
                                class="btn btn-outline-primary btn-sm"
                            >
                                Generate Report
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             RECENT ACTIVITY
        ================================================= -->

        <div class="dashboard-card">

            <div class="card-header-custom">

                <h5 class="card-title">

                    <i class="bi bi-clock-history"></i>

                    Recent Department Activity

                </h5>

            </div>


            <div class="table-responsive">

                <table class="table">

                    <thead>

                        <tr>
                            <th>Activity</th>
                            <th>Teacher</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>

                    </thead>


                    <tbody>

                    <% recentActivity?.forEach(activity => { %>

                        <tr>

                            <td>
                                <%= activity.description %>
                            </td>

                            <td>
                                <%= activity.teachername || '-' %>
                            </td>

                            <td>
                                <%= activity.created_at %>
                            </td>

                            <td>

                                <span class="badge-soft badge-success">
                                    Completed
                                </span>

                            </td>

                        </tr>

                    <% }) %>


                    <% if (!recentActivity?.length) { %>

                        <tr>

                            <td
                                colspan="4"
                                class="text-center text-muted py-4"
                            >
                                No recent activity.
                            </td>

                        </tr>

                    <% } %>

                    </tbody>

                </table>

            </div>

        </div>


    </div>

</main>


<script>

(() => {

    'use strict';

    const sidebar =
        document.getElementById('sidebar');

    const mobileMenu =
        document.getElementById('mobileMenu');

    mobileMenu?.addEventListener('click', () => {

        sidebar?.classList.toggle('open');

    });


    /*
     * Academic year / term filtering
     */

    document
        .getElementById('applyFilters')
        ?.addEventListener('click', () => {

            const year =
                document.getElementById('academicYear').value;

            const term =
                document.getElementById('term').value;

            const params =
                new URLSearchParams({
                    year,
                    term
                });

            window.location.href =
                `/hod/dashboard?${params.toString()}`;

        });


})();

</script>


</body>
</html>