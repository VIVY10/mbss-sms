<% if(locals.user){ %>
  <% if(user.usertype==="admin"){ %>
    <%- include("../partials/sidebar.ejs") %>
  <% } %>
<% } %>
      <!--///////////////////////////////// content Placed here ///////////////////////////////////////////-->
    <div class="table-responsive">
      <table class="table">
        <thead class="table-light">
          <tr>
            <th>Fname</th>
            <th>Lname</th>
            <th>DepartmentName</th>
            <th colspan="2" style="text-align: center;">Action</th>
          </tr>
        </thead>
      <% if(locals.results){ %>
        <% results.forEach(element => { %>
            <tbody>
              <tr>
                <td><%= element.fname %></th>
                <td><%= element.lname %></td>
                <td><%= element.departmentname %></th>
                <% if(user.usertype==="Admin"){ %>
                  <td  style="text-align: center;" ><a href="/updateHod/<%= element.id %>"><i class="material-icons">edit</i></a>
                  <a href="/deleteHod/<%= element.id %>"><i class="material-icons">delete</i></a>
                  <% }else if(user.usertype==="HOD"){%>
                    <td  style="text-align: center;" ><a href="#"><i class="material-icons">edit</i></a>
                    <a href="#"><i class="material-icons">delete</i></a>
                    <% } %>                  
                </th>                  
              </tr>
            </tbody>        
          <% }); %>        
        <% } %>
      </table>      
      </div>
    </main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="/scripts/adminScripts.js"></script>
</body>

</html>