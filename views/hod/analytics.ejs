<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/hod/head", { pageTitle: "Academic Performance" }) %>
</head>
<body>
<div class="app-shell">
    <%- include("../partials/hod/sidebar", { currentPage: "analytics" }) %>
    <main class="main-content">
        <%- include("../partials/hod/topbar", { pageTitle: "Academic Performance", eyebrow: "DEPARTMENT ANALYTICS" }) %>
        <div class="content-container">
            <section class="module-page-header">
                <div>
                    <div class="breadcrumb">Dashboard <span>/</span> Academic Performance</div>
                    <h2>Academic Performance</h2>
                </div>
                <a href="/dashboard" class="btn btn-light"><i class="bi bi-arrow-left"></i> Dashboard</a>
            </section>
                        <section id="analytics"
                     class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            DEPARTMENT ANALYTICS
                        </span>

                        <h3>Academic Performance</h3>

                        <p>
                            Overview of department subject performance.
                        </p>

                    </div>

                </div>


                <div class="analytics-grid">


                    <div class="data-card">

                        <div class="card-header">

                            <div>
                                <h4>Subject Performance</h4>
                                <p>Average marks by subject.</p>
                            </div>

                        </div>


                        <div class="performance-bars">

                            <% if (typeof subjectPerformance !== 'undefined' &&
                                   subjectPerformance.length) { %>

                                <% subjectPerformance.forEach(item => { %>

                                    <div class="performance-item">

                                        <div class="performance-label">

                                            <span>
                                                <%= item.subjectname %>
                                            </span>

                                            <strong>
                                                <%= item.average || 0 %>%
                                            </strong>

                                        </div>

                                        <div class="performance-track">
                                            <span class="performance-fill"
                                            data-percentage="<%= item.average || 0 %>"></span>
                                        </div>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <div class="empty-state">

                                    <i class="bi bi-bar-chart"></i>

                                    <strong>
                                        No performance data
                                    </strong>

                                    <span>
                                        Subject performance will appear
                                        after marks are recorded.
                                    </span>

                                </div>

                            <% } %>

                        </div>

                    </div>



                    <div class="data-card">

                        <div class="card-header">

                            <div>
                                <h4>Marks Completion</h4>
                                <p>Department marks-entry progress.</p>
                            </div>

                        </div>


                        <div class="completion-chart">

                            <div class="donut-chart"
                                 data-percentage="<%= stats?.marksCompletion || 0 %>">
                            </div>

                                <div>
                                    <strong>
                                        <%= stats?.marksCompletion || 0 %>%
                                    </strong>

                                    <span>
                                        Complete
                                    </span>
                                </div>

                            </div>


                            <div class="completion-details">

                                <div>
                                    <span class="legend-dot completed"></span>
                                    <span>Completed</span>
                                    <strong>
                                        <%= stats?.marksCompleted || 0 %>
                                    </strong>
                                </div>

                                <div>
                                    <span class="legend-dot pending"></span>
                                    <span>Pending</span>
                                    <strong>
                                        <%= stats?.marksPending || 0 %>
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <footer class="dashboard-footer">
                <span>© <%= new Date().getFullYear() %> School Management System</span>
                <span>Department Academic Dashboard</span>
            </footer>
        </div>
    </main>
</div>
<%- include("../partials/hod/scripts") %>
</body>
</html>
