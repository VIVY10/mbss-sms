<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head", {
        pageTitle: "Search Pupil's Results"
    }) %>
</head>

<body>

<div class="app-shell">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->
    <%- include("../partials/hod-sidebar", {
        currentPage: "results"
    }) %>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->
    <main class="main-content">

        <%- include("../partials/topbar", {
            pageTitle: "Search Pupil's Results",
            eyebrow: "RESULTS"
        }) %>


        <div class="content-container">

            <!-- =================================================
                 PAGE HEADER
            ================================================== -->
            <section class="module-page-header">

                <div>

                    <div class="breadcrumb">
                        <a href="/dashboard">Dashboard</a>
                        <span>/</span>
                        Search Pupil's Results
                    </div>

                    <h2>
                        Search Pupil's Results
                    </h2>

                    <p class="module-description">
                        Search and review academic results for pupils
                        within your department.
                    </p>

                </div>


                <div class="module-page-actions">

                    <a href="/dashboard"
                       class="btn btn-light">

                        <i class="bi bi-arrow-left me-1"></i>
                        Dashboard

                    </a>

                </div>

            </section>


            <!-- =================================================
                 RESULTS SEARCH
            ================================================== -->
            <section id="results"
                     class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            RESULTS
                        </span>

                        <h3>
                            Search Pupil's Results
                        </h3>

                        <p>
                            Search academic results using an exam number,
                            class, subject, term and examination.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     SEARCH CARD
                ================================================== -->
                <div class="result-search-card">

                    <form id="resultSearchForm"
                          autocomplete="off">

                        <div class="row g-3">

                            <!-- Exam Number -->
                            <div class="col-12 col-lg-4">

                                <label for="resultExamNo"
                                       class="form-label">

                                    Exam Number

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-person-badge"></i>

                                    <input
                                        type="text"
                                        class="form-control"
                                        id="resultExamNo"
                                        name="examno"
                                        placeholder="Enter exam number"
                                        autocomplete="off"
                                    >

                                </div>

                            </div>


                            <!-- Class -->
                            <div class="col-12 col-md-6 col-lg-2">

                                <label for="resultClassFilter"
                                       class="form-label">

                                    Class

                                </label>

                                <select
                                    id="resultClassFilter"
                                    class="form-select"
                                    name="classid"
                                >

                                    <option value="">
                                        All Classes
                                    </option>

                                    <% if (
                                        typeof stats.allocations !== 'undefined' &&
                                        stats.allocations &&
                                        stats.allocations.length
                                    ) { %>

                                        <%
                                            const uniqueClasses = new Map();

                                            stats.allocations.forEach(item => {

                                                const key =
                                                    `${item.classid}-${item.levelname}-${item.class}`;

                                                if (!uniqueClasses.has(key)) {
                                                    uniqueClasses.set(key, item);
                                                }

                                            });
                                        %>

                                        <% uniqueClasses.forEach(item => { %>

                                            <option
                                                value="<%= item.classid %>"
                                            >
                                                <%= item.levelname || '' %>
                                                <%= item.class || '' %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>


                            <!-- Subject -->
                            <div class="col-12 col-md-6 col-lg-2">

                                <label for="resultSubjectFilter"
                                       class="form-label">

                                    Subject

                                </label>

                                <select
                                    id="resultSubjectFilter"
                                    class="form-select"
                                    name="subjectcode"
                                >

                                    <option value="">
                                        All Subjects
                                    </option>

                                    <% if (
                                        typeof stats !== 'undefined' &&
                                        stats.allocations &&
                                        stats.allocations.length
                                    ) { %>

                                        <%
                                            const uniqueSubjects = new Map();

                                            stats.allocations.forEach(item => {

                                                const key =
                                                    item.subjectcode ||
                                                    item.subjectname;

                                                if (!uniqueSubjects.has(key)) {
                                                    uniqueSubjects.set(key, item);
                                                }

                                            });
                                        %>

                                        <% uniqueSubjects.forEach(item => { %>

                                            <option
                                                value="<%= item.subjectcode || '' %>"
                                                data-subjectname="<%= item.subjectname || '' %>"
                                            >
                                                <%= item.subjectname || item.subjectcode || '' %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>


                            <!-- Term -->
                            <div class="col-12 col-md-6 col-lg-2">

                                <label for="resultTermFilter"
                                       class="form-label">

                                    Term

                                </label>

                                <select
                                    id="resultTermFilter"
                                    class="form-select"
                                    name="termid"
                                >

                                    <option value="">
                                        Select Term
                                    </option>

                                    <% if (
                                        typeof stats !== 'undefined' &&
                                        stats.currentTerm &&
                                        stats.currentTerm.length
                                    ) { %>


                                        <% stats.currentTerm.forEach(item => { %>

                                            <option
                                                value="<%= item.termid %>"
                                            >
                                                <%= item.termname || '' %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>


                            <!-- Year -->
                            <div class="col-12 col-md-6 col-lg-2">

                                <label for="resultYearFilter"
                                       class="form-label">

                                    Year

                                </label>

                                <select
                                    id="resultYearFilter"
                                    class="form-select"
                                    name="schoolyear"
                                >

                                    <option value="">
                                        Select Year
                                    </option>

                                    <% if (
                                        typeof stats !== 'undefined' &&
                                        stats.currentYear &&
                                        stats.currentYear.length
                                    ) { %>


                                        <% stats.currentYear.forEach(item => { %>

                                            <option
                                                value="<%= item.schoolyearid %>"
                                            >
                                                <%= item.yearname || '' %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>


                            <!-- Exam -->
                            <div class="col-12 col-md-6 col-lg-2">

                                <label for="resultExamFilter"
                                       class="form-label">

                                    Exam

                                </label>

                                <select
                                    id="resultExamFilter"
                                    class="form-select"
                                    name="examid"
                                >

                                    <option value="">
                                        Select Exam
                                    </option>

                                    <% if (
                                        typeof stats !== 'undefined' &&
                                        stats.examtype &&
                                        stats.examtype.length
                                    ) { %>

                                        <% stats.examtype.forEach(item => { %>

                                            <option
                                                value="<%= item.examid %>"
                                            >
                                                <%= item.exam_title || '' %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>


                            <!-- Search -->
                            <div class="col-12 col-md-6 col-lg-2 d-flex align-items-end">

                                <button
                                    type="submit"
                                    class="btn btn-primary w-100"
                                    id="resultSearchBtn"
                                >

                                    <i class="bi bi-search me-1"></i>
                                    Search

                                </button>

                            </div>


                            <!-- Clear -->
                            <div class="col-12 col-md-6 col-lg-2 d-flex align-items-end">

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary w-100"
                                    id="resultClearBtn"
                                >

                                    <i class="bi bi-x-circle me-1"></i>
                                    Clear

                                </button>

                            </div>

                        </div>

                    </form>

                </div>


                <!-- =================================================
                     SEARCH MESSAGE
                ================================================== -->
                <div
                    id="resultSearchMessage"
                    class="search-message d-none"
                    role="status"
                    aria-live="polite"
                >
                </div>


                <!-- =================================================
                     RESULTS
                ================================================== -->
                <div
                    id="resultContainer"
                    class="result-container d-none"
                >
                    <!-- JavaScript populates this -->

                </div>

                

            </section>


            <!-- =================================================
                 FOOTER
            ================================================== -->
            <footer class="dashboard-footer">

                <span>
                    © <%= new Date().getFullYear() %>
                    School Management System
                </span>

                <span>
                    Department Academic Dashboard
                </span>

            </footer>

        </div>

    </main>

</div>


<!-- =========================================================
     SCRIPTS
========================================================== -->
<%- include("../partials/scripts") %>

</body>
</html>