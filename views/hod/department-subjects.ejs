<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head", { pageTitle: "Class Subject Status" }) %>
</head>
<body>
<div class="app-shell">
    <%- include("../partials/hod-sidebar", { currentPage: "class-subjects" }) %>
    <main class="main-content">
        <%- include("../partials/topbar", { pageTitle: "Class Subject Status", eyebrow: "CLASS CONFIGURATION" }) %>
        <div class="content-container">
            <section class="module-page-header">
                <div>
                    <div class="breadcrumb">Dashboard <span>/</span> Class Subject Status</div>
                    <h2>Class Subject Status</h2>
                </div>
                <a href="/dashboard" class="btn btn-light"><i class="bi bi-arrow-left"></i> Dashboard</a>
            </section>
                        <section id="classes"
                     class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            CLASS CONFIGURATION
                        </span>

                        <h3>Class Subject Status</h3>

                    </div>

                </div>

            <div class="allocation-grid">

                <div class="data-card">

                    <div class="table-toolbar">

                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input type="search"
                                   id="classSearch"
                                   placeholder="Search class...">

                        </div>


                        <select class="form-select">

                            <option>All Levels</option>

                            <% if (typeof levels !== 'undefined') { %>

                                <% levels.forEach(level => { %>

                                    <option value="<%= level.levelorder %>">
                                        <%= level.levelname %>
                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <div class="table-responsive">

                        <table class="table dashboard-table">

                            <thead>

                            <tr>
                                <th>Class</th>
                                <th>Subjects</th>
                                <th>Teachers</th>
                                <th>Configuration</th>
                                <th>Action</th>
                            </tr>

                            </thead>

                            <tbody>

                            <% if (typeof allocations !== 'undefined' && allocations.length) { %>

                                <% allocations.forEach(item => { %>

                                    <tr>
                                        <td>
                                            <%= item.levelname %>
                                            <%= item.class %>
                                        </td>

                                        <td>
                                            <!-- <%= item.subject_count || 0 %> -->
                                              <%= item.subjectname || '' %>
                                        </td>

                                        <td>
                                            <!-- <%= item.teacher_count || 0 %> -->
                                             <%= item.allocation_status || '' %>
                                        </td>

                                        <td>

                                            
                                              <% if (!item.allocation_status) { %>
                                                <span class="status-badge danger">
                                                    No Subjects
                                                </span>

                                               <% } else if (item.allocation_status === 'Not Allocated') { %>

                                                <span class="status-badge warning">
                                                    <%= item.unassigned_count %>
                                                    Unassigned
                                                </span>

                                            <% } else { %>

                                                <span class="status-badge success">
                                                    Complete
                                                </span>

                                            <% } %>

                                        </td>

                                        <td>

                                            <button class="table-action">

                                                <i class="bi bi-chevron-right"></i>

                                            </button>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

                    <div class="data-card">

                        <div class="card-header">

                            <div>
                                <h4>Department Subjects</h4>
                                <p>subjects found in this department.</p>
                            </div>

                            <% if(departmentSubjects.length > 0) { %>
                            <span class="success-count">
                                <%= departmentSubjects.length %>
                            </span>
                            <% } else { %>
                            <span class="danger-count">
                                0
                            </span>
                            <% } %>

                            

                        </div>


                        <div class="attention-list">

                            <% if (typeof departmentSubjects !== 'undefined' && departmentSubjects.length) { %>

                                <% departmentSubjects.forEach(item => { %>

                                    <div class="attention-item">

                                        <div class="attention-icon">
                                            <i class="bi bi-journal-bookmark-fill"></i>
                                        </div>

                                        <div class="attention-info">

                                            <strong>
                                                <%= item.subjectcode %>
                                                <%= item.subjectname %>
                                            </strong>

                                            <small>
                                                No teacher allocated
                                            </small>

                                        </div>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <div class="success-message">

                                    <i class="bi bi-check-circle"></i>

                                    <div>
                                        <strong>No Subjects configured for your department</strong>
                                        <small>
                                            Request Admin to allocate subjects to your department.
                                        </small>
                                    </div>
                                    <button class="btn btn-sm btn-outline-success" id="sendDepartmentSubjectRequest">
                                        Send Request
                                    </button>

                                </div>

                            <% } %>

                        </div>

                    </div>
            </div>

            </section>

            <footer class="dashboard-footer">
                <span>© <%= new Date().getFullYear() %> School Management System</span>
                <span>Department Academic Dashboard</span>
            </footer>
        </div>
    </main>
</div>
<%- include("../partials/scripts") %>
</body>
</html>
