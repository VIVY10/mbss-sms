<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <style>
        .container {
            display: flex;
            justify-content: center;
            /* align-items: center; */
            height: 100vh; /* Full height */
        }

        .fpFormTitle {
            text-align: center;
            margin-bottom: 20px;
            margin-top: 120px;
        }

        .forgot-message, p {
            text-align: center;
        }

        #forgotPasswordForm {
            display: flex;
            justify-content: center;
            font-weight: 500;
            font-size: 18px;
            border-radius: 5px;
            line-height: 22px;
            transition: all 0.3s;
            padding: 13px;
            width: 100%;
            max-width: 400px; /* Limit the form width */
            box-sizing: border-box;
            outline: 0;
        }

        #fpButton:disabled {
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col">
                <h1 class="fpFormTitle">Forgot Password</h1>
                <p>Enter a valid email address registered with your account.</p>
                <div class="forgot-message alert alert-success" style="display:none;">
                    Email address received. If the email is on your account, we will send you a reset email. <br>
                    Please wait a few minutes and check your inbox.
                </div>
                <form id="forgotPasswordForm" class="form-inline" onsubmit="return false;">
                    <div class="form-group">
                        <label class="sr-only" for="email">Email address:</label>
                        <input type="email" class="form-control mr-2" id="emailFp" name="email" placeholder="Email address" required>
                    </div>
                    <div class="form-group mt-1 text-center">
                        <button id="fpButton" class="btn btn-success mb-2" type="button">Send email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#fpButton').on('click', function() {
                var email = $('#emailFp').val();
                var button = $(this);

                // Disable the button and change text
                button.prop('disabled', true);
                button.text('Submitting...');

                $.post('/forgot-password', { email: email })
                    .done(function(resp) {
                        $('.forgot-message').show();
                        $('#forgotPasswordForm').remove();
                    })
                    .fail(function() {
                        alert('There was an error processing your request. Please try again later.');
                    })
                    .always(function() {
                        // Re-enable the button and reset text
                        button.prop('disabled', false);
                        button.text('Send email');
                    });
            });
        });
    </script>
</body>
</html>
