<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
</head>
<style>

.container{
        display: flex;
        justify-content: center;
        /* align-items: center; */
    }
    
.resetFormTitle {
    text-align: center;
    margin-bottom: 20px;
    margin-top: 60px;
}

.resetPasswordForm{
    text-align: center;
    margin-top: 30%;
}

    .alert {
    color: #14562c;
    text-align: center;
    background-color: #f2dede;
    border-color: #ebccd1;
    padding: 15px;
    margin-bottom: 20px;
    border: 1px solid transparent;
    border-radius: 4px;
}

.alert ul {
    margin: 0;
    padding-left: 20px;
    list-style-type: none;
}

.alert a {
    margin: 10px;
    padding: 10px;
    text-decoration: none;
    font-weight: bold;
    color: blue;
}

.alert a:hover {
    color: whitesmoke;
    background-color: #000;
    padding: 20px;
    transition: background-color 0.3s ease;
}

#resetPasswordForm{
    display: flex;
    flex-direction: column;
    align-items: center;
}

#resetPasswordForm input {
  width: 350px;
  box-sizing: border-box;
}

#resetPasswordForm #rpBtn {
    margin: 10px;
    width: 350px;
    font-weight: bold;
}


</style>
<body>
    <div class="container">
        <div class="row">
            <div class="col">
                <h1 class="resetFormTitle">Reset Password</h1>
                <% if (showForm) { %>
                    <form id="resetPasswordForm" method="POST" action="/resetPassword">
                        <input type="hidden" name="token" value="<%= record.token %>">
                        <input type="hidden" name="email" value="<%= record.email %>">
                        <div class="form-group">
                            <label for="password1">New Password:</label>
                            <input type="password" class="form-control" id="password1" name="password1" required>
                            <small class="form-text text-muted">Password must be at least 8 characters long.</small>
                        </div>
                        <div class="form-group">
                            <label for="password2">Confirm Password:</label>
                            <input type="password" class="form-control" id="password2" name="password2">
                            <small class="form-text text-muted">Both passwords must match.</small>
                        </div>
                        <button type="submit" class="btn btn-primary" id="rpBtn">Reset Password</button>
                    </form>
                <% } else { %>
                    <!-- <p ><%= message %></p> -->
                    <div class="alert">
                        <ul>
                            <li><%= message %> <a href="/forgotPassword">click here</a></li>
                        </ul>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>




































